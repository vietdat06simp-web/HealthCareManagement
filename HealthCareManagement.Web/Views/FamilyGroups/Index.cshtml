@model HealthCareManagement.Web.Models.ViewModels.FamilyGroupViewModel
@{
    ViewData["Title"] = "Cài Đặt Tổ Ấm Gia Đình";
}

@section Styles {
    <!-- Tailwind CSS CDN for Google Stitch utility classes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        brand: {
                            ocean: '#0284C7',
                            cyan: '#06B6D4',
                            mint: '#10B981',
                            amber: '#F59E0B',
                            danger: '#EF4444',
                        },
                        slateBg: '#F8FAFC',
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    boxShadow: {
                        card: '0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03)',
                        cardHover: '0 10px 25px -4px rgba(2, 132, 199, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.04)',
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/family-group.css" asp-append-version="true" />
}

<div class="w-full flex flex-col gap-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="text-emerald-500 hover:text-emerald-700 border-0 bg-transparent cursor-pointer" onclick="this.parentElement.remove()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="text-rose-500 hover:text-rose-700 border-0 bg-transparent cursor-pointer" onclick="this.parentElement.remove()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
    }

    <!-- 1. BREADCRUMB & STATUS BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <!-- Breadcrumb Link -->
        <nav aria-label="breadcrumb" class="breadcrumb-nav flex items-center space-x-2 text-sm text-slate-500">
            <a asp-controller="Home" asp-action="Index" class="hover:text-sky-600 transition-colors flex items-center gap-1.5 text-decoration-none">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <a asp-controller="Members" asp-action="Index" class="hover:text-sky-600 transition-colors text-decoration-none">Quản lý thành viên</a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-900 font-semibold text-[#0284C7]">Cài đặt tổ ấm</span>
        </nav>

        <!-- Right Green Badge Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 border border-emerald-200 rounded-full text-xs font-semibold text-emerald-700 shadow-sm self-start sm:self-auto">
            <span class="w-2 h-2 rounded-full bg-[#10B981] animate-ping inline-block"></span>
            <span class="w-2 h-2 -ml-4 rounded-full bg-[#10B981] inline-block"></span>
            <span>Hồ sơ tổ ấm: <strong>Đang kích hoạt &amp; Đồng bộ</strong></span>
        </div>
    </div>

    <!-- PAGE HEADER TITLE -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                <span>Cài Đặt Tổ Ấm Gia Đình</span>
                <span class="px-2.5 py-0.5 text-xs font-semibold rounded-md bg-sky-100 text-sky-800 border border-sky-200">Gia Đình Số</span>
            </h1>
            <p class="text-sm text-slate-500 mt-1">Quản lý thông tin chung, đường dây cấp cứu khẩn cấp và phân quyền y tế cho từng thành viên trong gia đình.</p>
        </div>
        <div class="text-xs text-slate-400 bg-white px-3 py-2 rounded-xl border border-slate-200 shadow-sm flex items-center gap-2 self-start md:self-center">
            <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Đồng bộ gần nhất: <strong>14:32 Hôm nay</strong></span>
        </div>
    </div>

    <!-- 2. MAIN CONTENT: 2 UNIFIED CARDS -->

    <!-- CARD 1: THÔNG TIN TỔ ẤM CHUNG -->
    <section class="bg-white rounded-[16px] border border-slate-200 p-6 md:p-8 shadow-card hover:shadow-cardHover transition-shadow duration-300">
        <div class="flex items-center justify-between pb-5 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-50 border border-sky-100 text-[#0284C7] flex items-center justify-center font-bold">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-base font-bold text-slate-900 tracking-wide uppercase">THÔNG TIN TỔ ẤM CHUNG</h2>
                    <p class="text-xs text-slate-500">Thông tin địa chỉ hành chính và đầu mối ứng cứu y tế khẩn cấp dùng chung cho cả gia đình.</p>
                </div>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-200">
                <svg class="w-3.5 h-3.5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Mã định danh tổ ấm: <strong>@(!string.IsNullOrEmpty(Model?.InviteCode) ? Model.InviteCode : (!string.IsNullOrEmpty(Model?.GroupCode) ? Model.GroupCode : "Chưa có"))</strong>
            </span>
        </div>

        <!-- Form Inputs Grid -->
        <form asp-action="Update" method="post" class="mt-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Input 1: Tên nhóm gia đình -->
                <div class="space-y-1.5">
                    <label asp-for="GroupName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                        Tên nhóm gia đình <span class="text-red-500">*</span>
                    </label>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-sky-600">
                            <!-- Home Icon -->
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                            </svg>
                        </div>
                        <input type="text" asp-for="GroupName" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50/60 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-50 transition-all" placeholder="Nhập tên tổ ấm..." required />
                    </div>
                    <span asp-validation-for="GroupName" class="text-danger text-xs"></span>
                    <p class="text-[11px] text-slate-400">Tên hiển thị trên hồ sơ liên thông viện và thẻ y tế của tất cả thành viên.</p>
                </div>

                <!-- Input 2: Hotline SOS Y Tế Gia Đình -->
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <label asp-for="EmergencyPhone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                            Hotline SOS Y Tế Gia Đình <span class="text-red-500">*</span>
                        </label>
                        <span class="text-[10px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-200">Ưu tiên khẩn cấp 24/7</span>
                    </div>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#EF4444]">
                            <!-- Red Emergency Pulse/Phone Icon -->
                            <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <input type="text" asp-for="EmergencyPhone" class="block w-full pl-11 pr-4 py-2.5 bg-rose-50/20 border border-rose-200 rounded-xl text-sm font-bold text-rose-800 placeholder-rose-300 focus:outline-none focus:border-rose-500 focus:bg-white focus:ring-4 focus:ring-rose-100 transition-all" placeholder="Nhập số điện thoại cấp cứu..." required />
                    </div>
                    <span asp-validation-for="EmergencyPhone" class="text-danger text-xs"></span>
                    <p class="text-[11px] text-slate-400">Số điện thoại kích hoạt báo động nhanh trên ứng dụng của trẻ nhỏ và người cao tuổi.</p>
                </div>
            </div>

            <!-- Input 3: Địa chỉ liên hệ thường trú (Full width) -->
            <div class="space-y-1.5">
                <label asp-for="Address" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                    Địa chỉ liên hệ thường trú <span class="text-red-500">*</span>
                </label>
                <div class="relative rounded-xl shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-cyan-600">
                        <!-- Location Pin Icon -->
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <input type="text" asp-for="Address" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50/60 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-50 transition-all" placeholder="Nhập địa chỉ cư trú của gia đình..." required />
                </div>
                <span asp-validation-for="Address" class="text-danger text-xs"></span>
                <p class="text-[11px] text-slate-400">Dùng để điều phối xe cấp cứu khu vực gần nhất và giao nhận thuốc theo đơn định kỳ.</p>
            </div>

            <!-- Bottom Actions -->
            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
                <button type="reset" class="px-5 py-2.5 text-sm font-semibold text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 hover:text-slate-900 transition-colors focus:ring-2 focus:ring-slate-200">
                    Đặt lại
                </button>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-bold text-white bg-[#0284C7] hover:bg-sky-700 active:bg-sky-800 rounded-xl shadow-md shadow-sky-600/25 transition-all focus:outline-none focus:ring-4 focus:ring-sky-200">
                    <svg class="w-4 h-4 stroke-current stroke-[2.5] fill-none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Lưu thay đổi</span>
                </button>
            </div>
        </form>
    </section>

    <!-- CARD 2: DANH SÁCH THÀNH VIÊN & TÀI KHOẢN LIÊN KẾT -->
    <section class="bg-white rounded-[16px] border border-slate-200 p-6 md:p-8 shadow-card hover:shadow-cardHover transition-shadow duration-300">
        <!-- Card Header Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 text-[#10B981] flex items-center justify-center font-bold">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h2 class="text-base font-bold text-slate-900 tracking-wide uppercase">DANH SÁCH THÀNH VIÊN &amp; TÀI KHOẢN LIÊN KẾT</h2>
                        <!-- Count Pill -->
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-sky-100 text-[#0284C7] border border-sky-200">
                            @(Model?.Members != null && Model.Members.Any() ? $"{Model.Members.Count} thành viên" : "0 thành viên")
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mt-0.5">Phân quyền xem hồ sơ bệnh án, lịch tái khám và cấp quyền ủy thác y tế giữa các người thân.</p>
                </div>
            </div>

            <!-- Button "+ Thêm người thân" -->
            <a asp-controller="Members" asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-[#0284C7] to-[#06B6D4] hover:opacity-95 rounded-xl shadow-md shadow-sky-600/20 transition-all self-start sm:self-center text-decoration-none">
                <svg class="w-4 h-4 stroke-current stroke-[2.5]" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>+ Thêm người thân</span>
            </a>
        </div>

        <!-- Table Container -->
        <div class="overflow-x-auto custom-scrollbar mt-4 -mx-6 md:-mx-8 px-6 md:px-8">
            <table class="w-full text-left border-collapse min-w-[760px]">
                <thead>
                    <tr class="border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider bg-slate-50/70">
                        <th scope="col" class="py-3.5 px-4 rounded-l-xl">Thành viên</th>
                        <th scope="col" class="py-3.5 px-4">Liên hệ &amp; Định danh</th>
                        <th scope="col" class="py-3.5 px-4">Vai trò quản trị y tế</th>
                        <th scope="col" class="py-3.5 px-4">Ngày tham gia</th>
                        <th scope="col" class="py-3.5 px-4 text-center rounded-r-xl">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @if (Model?.Members != null && Model.Members.Any())
                    {
                        @foreach (var member in Model.Members)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-600 to-cyan-500 text-white flex items-center justify-center font-bold text-sm shadow-sm ring-2 ring-sky-100 flex-shrink-0">
                                            @(string.IsNullOrEmpty(member.FullName) ? "?" : member.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="font-bold text-slate-900 flex items-center gap-1.5">
                                                @member.FullName
                                                @if (member.IsCurrentUser)
                                                {
                                                    <span class="text-[10px] font-bold text-sky-700 bg-sky-50 px-1.5 py-0.2 rounded border border-sky-200">Bạn</span>
                                                }
                                            </div>
                                            <div class="text-xs text-slate-500 font-medium">
                                                @member.Age tuổi (@member.Gender) @(!string.IsNullOrEmpty(member.BloodGroup) ? $"• Nhóm máu: {member.BloodGroup}" : "") @(!string.IsNullOrEmpty(member.Notes) ? $"• {member.Notes}" : "")
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-medium text-slate-800 text-xs">@member.Email</div>
                                    <div class="text-xs text-slate-500 mt-0.5">@member.PhoneNumber @(!string.IsNullOrEmpty(member.IdentityOrInsurance) ? $"• {member.IdentityOrInsurance}" : "")</div>
                                </td>
                                <td class="py-4 px-4">
                                    @if (member.RoleBadgeType == "owner" || member.MedicalRole.Contains("Chủ hộ") || member.Relationship == "Chủ hộ")
                                    {
                                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gradient-to-r from-sky-50 to-indigo-50 text-[#0284C7] border border-sky-300 shadow-xs">
                                            <svg class="w-3.5 h-3.5 text-sky-600" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span class="text-sky-800 font-extrabold">Chủ hộ / Quản trị viên</span>
                                        </div>
                                    }
                                    else if (member.RoleBadgeType == "guardian" || member.MedicalRole.Contains("Giám hộ"))
                                    {
                                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-[#10B981] border border-emerald-200">
                                            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                            </svg>
                                            <span>@member.MedicalRole</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                                            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                            </svg>
                                            <span>@(string.IsNullOrEmpty(member.MedicalRole) || member.MedicalRole == member.Relationship ? "Thành viên phụ thuộc" : member.MedicalRole)</span>
                                        </div>
                                    }
                                </td>
                                <td class="py-4 px-4 text-xs text-slate-600 font-medium">
                                    @member.JoinedDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="py-4 px-4 text-center">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-controller="Members" asp-action="Details" asp-route-id="@member.Id" class="p-1.5 text-slate-400 hover:text-sky-600 hover:bg-sky-50 rounded-lg transition-colors" title="Chỉnh sửa hồ sơ">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                                            </svg>
                                        </a>
                                        @if (member.IsCurrentUser)
                                        {
                                            <button type="button" class="p-1.5 text-slate-300 cursor-not-allowed border-0 bg-transparent" title="Không thể khóa chủ hộ">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="p-1.5 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors border-0 bg-transparent" title="Quản lý ủy quyền">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="py-12 px-4 text-center text-slate-500">
                                <div class="flex flex-col items-center justify-center gap-2.5">
                                    <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                        </svg>
                                    </div>
                                    <p class="font-bold text-slate-700 text-sm m-0">Chưa có thành viên nào trong tổ ấm</p>
                                    <p class="text-xs text-slate-400 m-0">Bấm nút "+ Thêm người thân" để bắt đầu kết nối hồ sơ sức khỏe các thành viên.</p>
                                    <a asp-controller="Members" asp-action="Create" class="mt-2 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#0284C7] text-white text-xs font-semibold text-decoration-none hover:bg-sky-700 shadow-sm transition-colors">
                                        <svg class="w-3.5 h-3.5 stroke-current stroke-[2.5]" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                                        <span>+ Thêm người thân</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Pagination / Summary Note -->
        <div class="mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Tất cả hồ sơ y tế đang được mã hóa đầu cuối và đồng bộ hóa đám mây an toàn.</span>
            </div>
            <a asp-controller="Members" asp-action="Index" class="font-medium text-sky-700 hover:underline cursor-pointer text-decoration-none">
                Xem lịch sử phân quyền chi tiết &rarr;
            </a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" optional="true" />
}
