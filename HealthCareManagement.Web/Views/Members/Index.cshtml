                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-[#0369a1] text-white text-xs font-bold shadow-md shadow-sky-600/20 transition-all inline-flex items-center gap-1.5 cursor-pointer border-0">
