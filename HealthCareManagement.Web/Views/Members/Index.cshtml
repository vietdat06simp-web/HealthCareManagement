                        <button class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors border-0 bg-transparent" title="Tùy chọn" type="button">
                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
