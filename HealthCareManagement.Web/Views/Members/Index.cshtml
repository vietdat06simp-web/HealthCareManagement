        <!-- RIGHT: QUICK LOG FORM (Đo chỉ số nhanh) -->
        <div id="quickLogCard" class="lg:col-span-5 bg-white rounded-xl border border-slate-200/90 shadow-card p-5 relative">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3.5">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-sky-100 text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[18px]">bolt</span>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-900 leading-tight uppercase m-0">Ghi Nhận Nhanh</h3>
                        <p class="text-[10px] text-slate-400 m-0">Đo và đồng bộ tức thì với hồ sơ gia đình</p>
                    </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 text-[20px]" title="Chỉ số sinh hiệu">speed</span>
            </div>

            <form id="quickLogForm" asp-controller="Members" asp-action="RecordVitals" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <!-- Chọn Thành viên -->
                <div>
                    <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="member-select">
                        Thành viên gia đình <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <select id="member-select" name="MemberId" required class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 bg-white text-xs text-slate-800 font-semibold focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                            @if (Model.Members != null && Model.Members.Any())
                            {
                                foreach (var m in Model.Members)
                                {
                                    var age = DateTime.Today.Year - m.DateOfBirth.Year;
                                    <option value="@m.Id">@m.FullName (@m.Relationship - @(age)t)</option>
                                }
                            }
                            else
                            {
                                <option value="">Chưa có thành viên nào</option>
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>

                <!-- Huyết áp: Tâm thu SYS & Tâm trương DIA -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-[11px] font-semibold text-slate-700 m-0">Huyết áp (Tâm thu / Tâm trương)</label>
                        <span class="text-[10px] text-slate-400 font-medium">mmHg</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="relative">
                            <input id="inputSys" name="SystolicBP" class="w-full h-9 pl-3 pr-10 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" max="260" min="50" placeholder="120" type="number" value="120" />
                            <span class="absolute right-2.5 top-2.5 text-[10px] font-bold text-slate-400 pointer-events-none">SYS</span>
                        </div>
                        <div class="relative">
                            <input id="inputDia" name="DiastolicBP" class="w-full h-9 pl-3 pr-10 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" max="160" min="30" placeholder="80" type="number" value="80" />
                            <span class="absolute right-2.5 top-2.5 text-[10px] font-bold text-slate-400 pointer-events-none">DIA</span>
                        </div>
                    </div>
                </div>

                <!-- Nhịp tim & Đường huyết -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="heart-rate">Nhịp tim (bpm)</label>
                        <div class="relative">
                            <input id="heart-rate" name="HeartRate" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="75" type="number" min="30" max="220" value="75" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2 text-rose-500 text-[16px]">favorite</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="blood-glucose">Đường huyết (mmol/L)</label>
                        <div class="relative">
                            <input id="blood-glucose" name="BloodSugar" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="5.5" step="0.1" min="1.0" max="45.0" type="number" value="5.5" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2 text-amber-500 text-[16px]">water_drop</span>
                        </div>
                    </div>
                </div>

                <!-- Chiều cao & Cân nặng (Tính BMI tự động) -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-[11px] font-semibold text-slate-700 m-0">Chiều cao &amp; Cân nặng (Tính BMI)</label>
                        <span id="bmiBadge" class="text-[10px] font-bold px-1.5 py-0.2 rounded bmi-badge-normal transition-all">BMI: 22.4 (Chuẩn)</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="relative">
                            <input id="height-input" name="HeightCm" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="168" type="number" step="0.5" min="30" max="250" value="168" />
                            <span class="absolute right-2 top-2.5 text-[10px] font-semibold text-slate-400 pointer-events-none">cm</span>
                        </div>
                        <div class="relative">
                            <input id="weight-input" name="WeightKg" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="63.2" type="number" step="0.1" min="1" max="300" value="63.2" />
                            <span class="absolute right-2 top-2.5 text-[10px] font-semibold text-slate-400 pointer-events-none">kg</span>
                        </div>
                    </div>
                </div>

                <!-- Nồng độ oxy SpO2 & Thời điểm đo -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="spo2-input">SpO2 (%)</label>
                        <div class="relative">
                            <input id="spo2-input" name="SpO2" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="98" type="number" min="50" max="100" value="98" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2 text-cyan-500 text-[16px]">air</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-700 mb-1" for="time-context">Thời điểm đo</label>
                        <div class="relative">
                            <select id="time-context" name="TimeContext" class="w-full h-9 pl-3 pr-8 rounded-lg border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                                <option value="Sau ăn sáng 30p" selected>Sau ăn sáng 30p</option>
                                <option value="Lúc đói (Sáng)">Lúc đói (Sáng)</option>
                                <option value="Sau ăn trưa 2h">Sau ăn trưa 2h</option>
                                <option value="Trước khi ngủ">Trước khi ngủ</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 pointer-events-none text-[16px]">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Nút Lưu chỉ số & Đồng bộ -->
                <div class="pt-2">
                    <button id="btnSubmitQuickLog" class="w-full h-10 rounded-xl bg-primary hover:bg-[#0369a1] text-white text-xs font-bold shadow-md shadow-sky-600/20 hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer border-0" type="submit">
                        <span class="material-symbols-outlined text-[18px]">sync</span>
                        <span>Lưu chỉ số &amp; Đồng bộ</span>
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: THÊM THÀNH VIÊN MỚI (POST /Members/Create)                      -->
<!-- ========================================================================= -->
<div id="addMemberModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm transition-opacity hidden" aria-hidden="true" role="dialog">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-100 max-w-lg w-full max-h-[90vh] flex flex-col overflow-hidden transform transition-all animate-in fade-in zoom-in-95 duration-200">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70 flex-shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-sky-100 text-primary flex items-center justify-center shadow-inner">
                    <span class="material-symbols-outlined text-[20px]">person_add</span>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 m-0">Thêm Thành Viên Mới</h3>
                    <p class="text-[11px] text-slate-500 m-0">Tạo hồ sơ y tế cho thành viên trong tổ ấm</p>
                </div>
            </div>
            <button type="button" onclick="closeAddMemberModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 flex items-center justify-center transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>

        <!-- Modal Body (Form) -->
        <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
            <form id="addMemberForm" asp-controller="Members" asp-action="Create" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Họ và tên -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="createFullName">
                        Họ và tên <span class="text-rose-500">*</span>
                    </label>
                    <input id="createFullName" name="FullName" required maxlength="100" placeholder="VD: Nguyễn Văn An" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-medium" />
                </div>

                <!-- Quan hệ & Giới tính -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createRelationship">
                            Quan hệ <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <select id="createRelationship" name="Relationship" required class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                                <option value="Chủ hộ">Chủ hộ</option>
                                <option value="Vợ">Vợ</option>
                                <option value="Chồng">Chồng</option>
                                <option value="Con" selected>Con</option>
                                <option value="Bố">Bố</option>
                                <option value="Mẹ">Mẹ</option>
                                <option value="Ông">Ông</option>
                                <option value="Bà">Bà</option>
                                <option value="Anh/Chị/Em">Anh/Chị/Em</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-slate-400 pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createGender">
                            Giới tính <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <select id="createGender" name="Gender" required class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                                <option value="Nam" selected>Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-slate-400 pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Ngày sinh & Nhóm máu -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createDob">
                            Ngày sinh <span class="text-rose-500">*</span>
                        </label>
                        <input id="createDob" name="DateOfBirth" type="date" required value="2000-01-01" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-medium" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createBloodGroup">Nhóm máu</label>
                        <div class="relative">
                            <select id="createBloodGroup" name="BloodGroup" class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                                <option value="">Chưa rõ</option>
                                <option value="A+">A+</option>
                                <option value="B+">B+</option>
                                <option value="O+" selected>O+</option>
                                <option value="AB+">AB+</option>
                                <option value="A-">A-</option>
                                <option value="B-">B-</option>
                                <option value="O-">O-</option>
                                <option value="AB-">AB-</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-slate-400 pointer-events-none text-[18px]">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Mã BHYT & SĐT liên hệ -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createInsurance">Mã thẻ BHYT</label>
                        <input id="createInsurance" name="InsuranceNumber" maxlength="30" placeholder="VD: GD4010123456789" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 uppercase focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-mono" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="createPhone">Số điện thoại liên lạc</label>
                        <input id="createPhone" name="EmergencyPhone" type="tel" maxlength="15" placeholder="0901 234 567" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
                    </div>
                </div>

                <!-- Tiền sử bệnh nền -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="createMedicalHistory">Tiền sử bệnh nền tóm tắt</label>
