@section Scripts {
    <script>
        // Modal functions: Thêm thành viên
        function openAddMemberModal() {
            var modal = document.getElementById('addMemberModal');
            modal.classList.remove('hidden');
            document.getElementById('createFullName').focus();
        }

        function closeAddMemberModal() {
            var modal = document.getElementById('addMemberModal');
            modal.classList.add('hidden');
        }

        // Modal functions: Sửa thành viên
        function openEditMemberModal(id, fullName, relationship, dob, gender, bloodGroup, insurance, phone, medicalHistory, allergies) {
            document.getElementById('editMemberId').value = id;
            document.getElementById('editFullName').value = fullName;
            document.getElementById('editRelationship').value = relationship;
            document.getElementById('editDob').value = dob;
            document.getElementById('editGender').value = gender;
            document.getElementById('editBloodGroup').value = bloodGroup || "";
            document.getElementById('editInsurance').value = insurance || "";
            document.getElementById('editPhone').value = phone || "";
            document.getElementById('editMedicalHistory').value = medicalHistory || "";
            document.getElementById('editAllergies').value = allergies || "";

            var modal = document.getElementById('editMemberModal');
            modal.classList.remove('hidden');
            document.getElementById('editFullName').focus();
        }

        function closeEditMemberModal() {
            var modal = document.getElementById('editMemberModal');
            modal.classList.add('hidden');
        }

        // Modal functions: Đo sinh hiệu
        function openVitalsModal(memberId) {
            if (memberId) {
                var select = document.getElementById('modalVitalsMemberId');
                if (select) select.value = memberId;
            }
            var modal = document.getElementById('recordVitalsModal');
            modal.classList.remove('hidden');
            document.getElementById('modalSys').focus();
        }

        function closeVitalsModal() {
            var modal = document.getElementById('recordVitalsModal');
            modal.classList.add('hidden');
        }

        // Xóa thành viên với xác nhận
        function confirmDeleteMember(id, name) {
            if (confirm("Bạn có chắc chắn muốn xóa thành viên " + name + " khỏi tổ ấm? Toàn bộ chỉ số sinh hiệu của thành viên này cũng sẽ bị xóa.")) {
                document.getElementById('deleteMemberId').value = id;
                document.getElementById('deleteMemberForm').submit();
            }
        }

        // Đóng modal khi nhấn phím Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeAddMemberModal();
                closeEditMemberModal();
                closeVitalsModal();
            }
        });

        // Đóng modal khi click ra ngoài nền tối
        ['addMemberModal', 'editMemberModal', 'recordVitalsModal'].forEach(function(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modal.classList.add('hidden');
                    }
                });
            }
        });

        // Tính toán BMI tự động dựa trên Chiều cao & Cân nặng ở Quick Log Form
        function calculateBmi() {
            var heightCm = parseFloat(document.getElementById('height-input').value);
            var weightKg = parseFloat(document.getElementById('weight-input').value);
            var badge = document.getElementById('bmiBadge');

            if (heightCm > 0 && weightKg > 0) {
                var heightM = heightCm / 100;
                var bmi = (weightKg / (heightM * heightM)).toFixed(1);
                var category = "Chuẩn";
                var badgeClass = "bmi-badge-normal";

                if (bmi < 18.5) {
                    category = "Thiếu cân";
                    badgeClass = "bmi-badge-under";
                } else if (bmi >= 18.5 && bmi <= 24.9) {
                    category = "Chuẩn";
                    badgeClass = "bmi-badge-normal";
                } else if (bmi >= 25 && bmi <= 29.9) {
                    category = "Tiền béo phì";
                    badgeClass = "bmi-badge-over";
                } else {
                    category = "Béo phì";
                    badgeClass = "bmi-badge-obese";
                }

                badge.className = "text-[10px] font-bold px-1.5 py-0.2 rounded transition-all " + badgeClass;
                badge.textContent = "BMI: " + bmi + " (" + category + ")";
            }
        }

        document.getElementById('height-input')?.addEventListener('input', calculateBmi);
        document.getElementById('weight-input')?.addEventListener('input', calculateBmi);

        // Toast thông báo tương tác hiện đại
        var toastTimer = null;
        function showToast(title, message, isSuccess = true) {
            var toast = document.getElementById('vitalsToast');
            if (!toast) return;
            var titleEl = document.getElementById('toastTitle');
            var msgEl = document.getElementById('toastMessage');
            var iconWrap = document.getElementById('toastIconWrapper');

            titleEl.textContent = title;
            msgEl.textContent = message;

            if (isSuccess) {
                iconWrap.className = "w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0";
                iconWrap.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span>';
            } else {
                iconWrap.className = "w-7 h-7 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center flex-shrink-0";
                iconWrap.innerHTML = '<span class="material-symbols-outlined text-[18px]">info</span>';
            }

            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function () {
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 3500);
        }

        // Tương tác nút "Nhập chỉ số" từ Card -> chuyển chọn nhanh và focus form
        function quickFillMember(val, name) {
            var select = document.getElementById('member-select');
            if (select) select.value = val;
            var modalSelect = document.getElementById('modalVitalsMemberId');
            if (modalSelect) modalSelect.value = val;

            var card = document.getElementById('quickLogCard');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.classList.add('ring-2', 'ring-primary');
                setTimeout(function () {
                    card.classList.remove('ring-2', 'ring-primary');
                }, 1500);
            }

            showToast("Đã chọn thành viên", "Đang sẵn sàng ghi nhận chỉ số cho " + name, false);
            document.getElementById('inputSys')?.focus();
        }

        // Tương tác Tab lọc biểu đồ
        function filterChartMember(memberKey, btn) {
            document.querySelectorAll('.chart-tab-btn').forEach(function (b) {
                b.className = "chart-tab-btn px-2.5 py-1 rounded-md text-[11px] font-medium text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap border-0 bg-transparent cursor-pointer";
            });
            btn.className = "chart-tab-btn px-2.5 py-1 rounded-md bg-white text-primary text-[11px] font-bold shadow-xs whitespace-nowrap border-0 cursor-pointer";
        }

        // Xuất báo cáo PDF
        document.getElementById('btnExportPdf')?.addEventListener('click', function () {
            showToast("Đang tạo báo cáo PDF", "Bản tóm tắt chỉ số sinh hiệu 7 ngày đang được chuẩn bị để tải xuống...");
        });

        // Khởi tạo tính BMI lần đầu
        calculateBmi();
    </script>
}
