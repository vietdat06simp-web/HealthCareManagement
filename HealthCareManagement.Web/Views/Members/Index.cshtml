                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 m-0">Đo Chỉ Số Sinh Hiệu Nhanh</h3>
                    <p class="text-[11px] text-slate-500 m-0">Ghi nhận huyết áp, nhịp tim, đường huyết và SpO2</p>
                </div>
            </div>
            <button type="button" onclick="closeVitalsModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 flex items-center justify-center transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
            <form id="modalVitalsForm" asp-controller="Members" asp-action="RecordVitals" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <!-- Chọn thành viên -->
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalVitalsMemberId">
                        Thành viên cần đo <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <select id="modalVitalsMemberId" name="MemberId" required class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 font-semibold focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 appearance-none transition-all cursor-pointer">
                            @if (Model.Members != null && Model.Members.Any())
                            {
                                foreach (var m in Model.Members)
                                {
                                    var age = DateTime.Today.Year - m.DateOfBirth.Year;
                                    <option value="@m.Id">@m.FullName (@m.Relationship - @(age) tuổi)</option>
                                }
                            }
                            else
                            {
                                <option value="">Chưa có thành viên nào trong danh sách</option>
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-slate-400 pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>

                <!-- Huyết áp -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="text-xs font-semibold text-slate-700 m-0">Huyết áp (Tâm thu / Tâm trương)</label>
                        <span class="text-[10px] text-slate-400 font-medium">mmHg</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="relative">
                            <input id="modalSys" name="SystolicBP" class="w-full h-10 pl-3.5 pr-10 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" max="260" min="50" placeholder="120" type="number" value="120" />
                            <span class="absolute right-3 top-3 text-[10px] font-bold text-slate-400 pointer-events-none">SYS</span>
                        </div>
                        <div class="relative">
                            <input id="modalDia" name="DiastolicBP" class="w-full h-10 pl-3.5 pr-10 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" max="160" min="30" placeholder="80" type="number" value="80" />
                            <span class="absolute right-3 top-3 text-[10px] font-bold text-slate-400 pointer-events-none">DIA</span>
                        </div>
                    </div>
                </div>

                <!-- Nhịp tim & SpO2 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalHeartRate">Nhịp tim (bpm)</label>
                        <div class="relative">
                            <input id="modalHeartRate" name="HeartRate" class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="75" type="number" min="30" max="220" value="75" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-rose-500 text-[18px]">favorite</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalSpo2">SpO2 (%)</label>
                        <div class="relative">
                            <input id="modalSpo2" name="SpO2" class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="98" type="number" min="50" max="100" value="98" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-cyan-500 text-[18px]">air</span>
                        </div>
                    </div>
                </div>

                <!-- Đường huyết & Thân nhiệt -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalBloodSugar">Đường huyết (mmol/L)</label>
                        <div class="relative">
                            <input id="modalBloodSugar" name="BloodSugar" class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="5.5" step="0.1" min="1.0" max="45.0" type="number" value="5.5" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-amber-500 text-[18px]">water_drop</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalBodyTemp">Thân nhiệt (°C)</label>
                        <div class="relative">
                            <input id="modalBodyTemp" name="BodyTemperature" class="w-full h-10 pl-3.5 pr-8 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="36.8" step="0.1" min="30.0" max="45.0" type="number" value="36.8" />
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-orange-500 text-[18px]">device_thermostat</span>
                        </div>
                    </div>
                </div>

                <!-- Chiều cao & Cân nặng -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalHeight">Chiều cao (cm)</label>
                        <input id="modalHeight" name="HeightCm" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="168" type="number" step="0.5" min="30" max="250" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalWeight">Cân nặng (kg)</label>
                        <input id="modalWeight" name="WeightKg" class="w-full h-10 px-3.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-semibold" placeholder="63.5" type="number" step="0.1" min="1" max="300" />
                    </div>
                </div>

                <!-- Thời điểm đo & Ghi chú -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1" for="modalTimeContext">Thời điểm đo</label>
