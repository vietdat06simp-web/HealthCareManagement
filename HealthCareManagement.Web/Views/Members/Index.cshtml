                <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-amber-500/5 rounded-full blur-xl pointer-events-none"></div>
                <div>
                    <!-- Card Top: Avatar & Info -->
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                        <div class="flex items-center gap-2.5">
                            <div class="relative w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-500/20 to-amber-100 flex items-center justify-center text-amber-800 text-sm font-bold shadow-inner flex-shrink-0">
                                QK
                                <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-amber-500 border-2 border-white rounded-full flex items-center justify-center text-[8px] text-white font-bold" title="Cần lưu ý sức khỏe">!</span>
                            </div>
                            <div>
                                <div class="flex items-center gap-1.5 leading-tight">
                                    <h2 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors m-0">Trần Quốc Khang</h2>
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-amber-800 bg-amber-100/80 border border-amber-200 text-[10px] font-semibold leading-normal">Ông nội</span>
                                </div>
                                <div class="flex items-center gap-1.5 text-[11px] text-slate-500 mt-1">
                                    <span class="font-medium text-slate-700">68 tuổi</span>
                                    <span class="text-slate-300">•</span>
                                    <span>Nhóm máu: <strong class="text-slate-800 font-semibold">O+</strong></span>
                                    <span class="text-slate-300">•</span>
                                    <span class="font-mono text-slate-500 bg-slate-100 px-1 py-0.2 rounded text-[10px]">HT379012***</span>
                                </div>
                            </div>
                        </div>
                        <button class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors border-0 bg-transparent" title="Tùy chọn" type="button">
                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                        </button>
                    </div>

                    <!-- Bệnh nền / Dị ứng Badges -->
                    <div class="flex flex-wrap gap-1.5 mb-3">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-medium">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cao huyết áp độ 2
                        </span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-medium">
