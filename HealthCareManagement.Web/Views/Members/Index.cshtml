                        </span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-medium">
                            Không dị ứng
                        </span>
                    </div>

                    <!-- Vitals Box -->
                    <div class="grid grid-cols-2 gap-2 p-2.5 rounded-lg bg-slate-50/80 border border-slate-100/90 mb-2">
