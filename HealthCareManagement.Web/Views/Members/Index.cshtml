@model HealthCareManagement.Web.Models.ViewModels.MembersIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Thành Viên & Chỉ Số Sinh Hiệu";
    var allMetrics = Model.Members?.SelectMany(m => m.HealthMetrics ?? Enumerable.Empty<HealthCareManagement.Web.Models.Entities.HealthMetric>()).ToList() ?? new();
    var metricsWithBP = allMetrics.Where(m => m.SystolicBP.HasValue && m.DiastolicBP.HasValue).ToList();
    var avgSys = metricsWithBP.Any() ? (int)Math.Round(metricsWithBP.Average(m => m.SystolicBP!.Value)) : 120;
    var avgDia = metricsWithBP.Any() ? (int)Math.Round(metricsWithBP.Average(m => m.DiastolicBP!.Value)) : 80;
}

@section Styles {
    <!-- Google Fonts: Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN for Google Stitch utility classes -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        primary: '#0284C7',
                        brand: {
                            ocean: '#0284C7',
                            cyan: '#06B6D4',
                            mint: '#10B981',
                            amber: '#F59E0B',
                            danger: '#EF4444',
                        },
                        slateBg: '#F8FAFC',
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    boxShadow: {
                        card: '0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03)',
                        cardHover: '0 10px 25px -4px rgba(2, 132, 199, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.04)',
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/members.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-6">
    <!-- NOTIFICATIONS / TEMPDATA -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3.5 bg-emerald-50 border border-emerald-200/90 rounded-xl flex items-center justify-between text-emerald-800 text-xs font-semibold shadow-xs transition-all">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-3.5 bg-rose-50 border border-rose-200/90 rounded-xl flex items-center justify-between text-rose-800 text-xs font-semibold shadow-xs transition-all">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-[20px] text-rose-600">error</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1 cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }

    <!-- 1. BREADCRUMB & SYNC STATUS BAR -->
    <section class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-1 border-b border-slate-200/80">
        <nav aria-label="breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <a asp-controller="FamilyGroups" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer text-slate-500 text-decoration-none">
                Quản lý tổ ấm
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Danh sách thành viên &amp; Chỉ số</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-800 font-label-sm border border-emerald-200/80 shadow-xs flex-shrink-0 self-start sm:self-auto">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-semibold">Đồng bộ thẻ BHYT quốc gia</span>
            <span class="text-[10px] bg-emerald-200/70 text-emerald-900 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Cập nhật 09:30</span>
        </div>
    </section>

    <!-- 2. PAGE TITLE & DUAL ACTIONS BAR -->
    <section class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200/80">
        <div class="max-w-2xl">
            <div class="flex items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-primary text-[22px]">diversity_1</span>
                <span class="font-label-sm text-primary uppercase font-bold tracking-wider">@Model.FamilyGroupName</span>
            </div>
            <h1 class="font-headline-lg text-slate-900 tracking-tight m-0">QUẢN LÝ THÀNH VIÊN GIA ĐÌNH</h1>
            <p class="font-body-md text-slate-500 mt-1 mb-0">
                Theo dõi sát sao sức khỏe đa thế hệ, cảnh báo rủi ro tức thì và đồng bộ chỉ số sinh hiệu liên tục.
            </p>
        </div>
        <div class="flex items-center gap-2.5 flex-shrink-0 flex-wrap">
            <!-- Nút Xuất báo cáo PDF -->
            <button id="btnExportPdf" type="button" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold shadow-sm transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[20px] text-rose-500">picture_as_pdf</span>
                <span class="text-xs sm:text-sm">Xuất báo cáo PDF</span>
            </button>

            <!-- Nút Mở Modal Đo chỉ số nhanh -->
            <button type="button" onclick="openVitalsModal()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-sky-200 bg-sky-50 hover:bg-sky-100 text-primary font-semibold shadow-xs transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[20px] text-primary">speed</span>
                <span class="text-xs sm:text-sm">Đo chỉ số nhanh</span>
            </button>

            <!-- Nút Thêm thành viên mới (Mở Modal) -->
            <button type="button" onclick="openAddMemberModal()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0284C7] hover:bg-[#0369a1] text-white font-semibold shadow-md shadow-sky-600/20 transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[20px] text-white">person_add</span>
                <span class="text-white text-xs sm:text-sm">Thêm thành viên mới</span>
            </button>
        </div>
    </section>

    <!-- 3. MEMBER PROFILE CARDS (2x2 Grid) -->
    <section>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @if (Model.Members != null && Model.Members.Any())
            {
                foreach (var member in Model.Members)
                {
                    var initials = !string.IsNullOrWhiteSpace(member.FullName)
                        ? string.Join("", member.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper()
                        : "TV";
                    if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);
                    var age = DateTime.Today.Year - member.DateOfBirth.Year;
                    if (member.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;
                    var latestMetric = member.HealthMetrics?.OrderByDescending(m => m.RecordedAt).FirstOrDefault();

                    <article class="bg-white rounded-xl border border-slate-200/90 shadow-sm hover:shadow-cardHover transition-all duration-200 p-4 flex flex-col justify-between relative overflow-hidden group member-card">
                        <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-sky-500/5 rounded-full blur-xl pointer-events-none"></div>
                        <div>
                            <!-- Card Top: Avatar & Info -->
                            <div class="flex items-center justify-between gap-2 mb-2.5">
                                <div class="flex items-center gap-2.5">
                                    <div class="relative w-11 h-11 rounded-xl bg-gradient-to-tr from-sky-500/20 to-sky-100 flex items-center justify-center text-primary text-sm font-bold shadow-inner flex-shrink-0">
                                        @initials
                                        @if (latestMetric?.IsAbnormal == true)
                                        {
                                            <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-rose-500 border-2 border-white rounded-full flex items-center justify-center text-[8px] text-white font-bold" title="Cần lưu ý sức khỏe">!</span>
                                        }
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-1.5 leading-tight">
                                            <h2 class="text-sm font-bold text-slate-900 group-hover:text-primary transition-colors m-0">@member.FullName</h2>
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-sky-800 bg-sky-100/80 border border-sky-200 text-[10px] font-semibold leading-normal">@member.Relationship</span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-[11px] text-slate-500 mt-1">
                                            <span class="font-medium text-slate-700">@(age > 0 ? $"{age} tuổi" : "Sơ sinh")</span>
                                            <span class="text-slate-300">•</span>
                                            <span>Nhóm máu: <strong class="text-slate-800 font-semibold">@(string.IsNullOrEmpty(member.BloodGroup) ? "Chưa rõ" : member.BloodGroup)</strong></span>
                                            @if (!string.IsNullOrEmpty(member.InsuranceNumber))
                                            {
                                                <span class="text-slate-300">•</span>
                                                <span class="font-mono text-slate-500 bg-slate-100 px-1 py-0.2 rounded text-[10px]" title="Mã BHYT">@member.InsuranceNumber</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="relative flex items-center gap-1">
                                    <button type="button" onclick="openEditMemberModal('@member.Id', '@Html.Raw(member.FullName.Replace("'", "\\'"))', '@Html.Raw(member.Relationship.Replace("'", "\\'"))', '@member.DateOfBirth.ToString("yyyy-MM-dd")', '@member.Gender', '@(member.BloodGroup ?? "")', '@(member.InsuranceNumber ?? "")', '@(member.EmergencyPhone ?? "")', '@Html.Raw((member.MedicalHistory ?? "").Replace("'", "\\'"))', '@Html.Raw((member.Allergies ?? "").Replace("'", "\\'"))')" class="text-slate-400 hover:text-sky-600 p-1.5 rounded-lg hover:bg-sky-50 transition-colors inline-block cursor-pointer" title="Chỉnh sửa thông tin">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </button>
                                    <button type="button" onclick="confirmDeleteMember('@member.Id', '@Html.Raw(member.FullName.Replace("'", "\\'"))')" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-colors inline-block cursor-pointer" title="Xóa thành viên">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Bệnh nền / Dị ứng Badges -->
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                @if (member.MemberChronicDiseases != null && member.MemberChronicDiseases.Any())
                                {
                                    foreach (var cd in member.MemberChronicDiseases)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>@cd.DiseaseName
                                        </span>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(member.MedicalHistory))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>@member.MedicalHistory
                                    </span>
                                }
                                @if (member.MemberAllergies != null && member.MemberAllergies.Any())
                                {
                                    foreach (var al in member.MemberAllergies)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>Dị ứng: @al.AllergenName
                                        </span>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(member.Allergies))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>Dị ứng: @member.Allergies
                                    </span>
                                }
                                @if ((member.MemberChronicDiseases == null || !member.MemberChronicDiseases.Any()) && string.IsNullOrEmpty(member.MedicalHistory) && (member.MemberAllergies == null || !member.MemberAllergies.Any()) && string.IsNullOrEmpty(member.Allergies))
                                {
                                    <span class="text-[10px] text-slate-400 italic">Sức khỏe tốt, không có ghi nhận bệnh nền</span>
                                }
                            </div>

                            <!-- Vitals Box -->
                            <div class="grid grid-cols-2 gap-2 p-2.5 rounded-lg bg-slate-50/80 border border-slate-100/90 mb-2">
                                <div class="flex items-center justify-between">
                                    <div class="flex flex-col">
                                        <div class="flex items-center gap-1 text-[10px] text-slate-400 font-medium uppercase">
                                            <span class="material-symbols-outlined text-[13px] text-primary">monitor_heart</span>
                                            <span>Huyết áp</span>
                                        </div>
                                        <div class="flex items-baseline gap-1 mt-0.5">
                                            <span class="font-metric-num text-slate-900 text-[16px] font-bold">
                                                @(latestMetric?.SystolicBP != null && latestMetric?.DiastolicBP != null ? $"{latestMetric.SystolicBP}/{latestMetric.DiastolicBP}" : "--/--")
                                            </span>
                                            <span class="text-[10px] text-slate-400">mmHg</span>
                                        </div>
                                    </div>
                                    @if (latestMetric?.SystolicBP != null)
                                    {
                                        if (latestMetric.SystolicBP >= 140 || latestMetric.DiastolicBP >= 90)
                                        {
                                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200/60">
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Nguy cơ
                                            </span>
                                        }
                                        else if (latestMetric.SystolicBP > 130 || latestMetric.DiastolicBP > 85)
                                        {
                                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/60">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Lưu ý
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Ổn định
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-slate-400">Chưa đo</span>
                                    }
                                </div>
                                <div class="flex items-center justify-between border-l border-slate-200/60 pl-2.5">
                                    <div class="flex flex-col">
                                        <div class="flex items-center gap-1 text-[10px] text-slate-400 font-medium uppercase">
                                            <span class="material-symbols-outlined text-[13px] text-rose-500">favorite</span>
                                            <span>Nhịp tim</span>
                                        </div>
                                        <div class="flex items-baseline gap-1 mt-0.5">
                                            <span class="font-metric-num text-slate-900 text-[16px] font-bold">
                                                @(latestMetric?.HeartRate != null ? $"{latestMetric.HeartRate}" : "--")
                                            </span>
                                            <span class="text-[10px] text-slate-400">bpm</span>
                                        </div>
                                    </div>
                                    @if (latestMetric?.HeartRate != null)
                                    {
                                        if (latestMetric.HeartRate > 100 || latestMetric.HeartRate < 50)
                                        {
                                            <span class="text-[10px] text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200/60 font-semibold">Bất thường</span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200/60 font-medium">Bình thường</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-[10px] text-slate-400">Chưa đo</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Card Bottom Actions -->
                        <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2">
                            <span class="text-[10px] text-slate-400">
                                @if (latestMetric != null)
                                {
                                    <span>Đo gần nhất: @latestMetric.RecordedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                }
                                else
                                {
                                    <span>Chưa có dữ liệu sinh hiệu</span>
                                }
                            </span>
                            <div class="flex items-center gap-2">
                                <a asp-controller="MedicalRecords" asp-action="Index" asp-route-memberId="@member.Id" class="px-2.5 py-1 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 text-xs font-medium transition-colors text-decoration-none">Hồ sơ bệnh án</a>
                                <button onclick="quickFillMember('@member.Id', '@Html.Raw(member.FullName.Replace("'", "\\'"))')" class="px-2.5 py-1 rounded-md bg-sky-50 text-primary border border-sky-200 hover:bg-sky-100 text-xs font-semibold transition-all inline-flex items-center gap-1 cursor-pointer" type="button">
                                    <span class="material-symbols-outlined text-[14px]">edit_note</span>
                                    <span>Nhập chỉ số</span>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="col-span-full bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-xs">
                    <div class="w-16 h-16 rounded-2xl bg-sky-50 text-primary flex items-center justify-center mx-auto mb-4 border border-sky-100 shadow-inner">
                        <span class="material-symbols-outlined text-[36px]">group_off</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 mb-1">Chưa có thành viên nào trong danh sách</h3>
                    <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">Thêm các thành viên trong gia đình để bắt đầu theo dõi sức khỏe, chỉ số sinh hiệu và lịch khám.</p>
                    <button type="button" onclick="openAddMemberModal()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs sm:text-sm font-semibold hover:bg-sky-600 shadow-md shadow-sky-600/20 transition-all cursor-pointer border-0">
                        <span class="material-symbols-outlined text-[18px]">person_add</span>
                        <span>+ Thêm thành viên mới</span>
                    </button>
                </div>
            }
        </div>
    </section>

    <!-- 4. SECTION 2: 7-DAY VITALS TREND & QUICK LOG FORM -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- LEFT: 7-DAY VITALS TREND CHART -->
        <div class="lg:col-span-7 bg-white rounded-xl border border-slate-200/90 shadow-card p-5 flex flex-col justify-between">
            <div>
                <!-- Chart Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[20px]">ssid_chart</span>
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-tight m-0">Xu Hướng Sinh Hiệu 7 Ngày Qua</h3>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-0.5 mb-0">Đồ thị diễn tiến huyết áp theo dõi liên tục đa thành viên</p>
                    </div>
                    <div id="vitalsAvgBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-50 border border-amber-200/70 rounded-lg text-amber-800 text-xs font-medium self-start sm:self-auto">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        <span>TB: <strong class="font-bold text-slate-900">@(avgSys)/@(avgDia)</strong> mmHg</span>
                    </div>
                </div>

                <!-- Member Filter Segmented Tabs -->
                <div class="flex items-center gap-1 p-1 bg-slate-100/90 rounded-lg overflow-x-auto custom-scrollbar mb-3.5">
                    <button onclick="filterChartMember('all', this)" class="chart-tab-btn px-2.5 py-1 rounded-md bg-white text-primary text-[11px] font-bold shadow-xs whitespace-nowrap border-0 cursor-pointer" type="button">Tất cả</button>
                    @if (Model.Members != null && Model.Members.Any())
                    {
                        foreach (var m in Model.Members)
                        {
                            <button onclick="filterChartMember('@m.Id', this)" class="chart-tab-btn px-2.5 py-1 rounded-md text-[11px] font-medium text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap border-0 bg-transparent cursor-pointer" type="button">@m.FullName</button>
                        }
                    }
                </div>

                <!-- SVG Interactive Chart Container -->
                <div class="relative w-full h-[195px] bg-slate-50/50 rounded-lg p-2 border border-slate-100">
                    <svg class="w-full h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 600 200">
                        <defs>
                            <linearGradient id="sysGradientComp" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#0284C7" stop-opacity="0.25"></stop>
                                <stop offset="100%" stop-color="#0284C7" stop-opacity="0.0"></stop>
                            </linearGradient>
                            <linearGradient id="diaGradientComp" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.2"></stop>
                                <stop offset="100%" stop-color="#06B6D4" stop-opacity="0.0"></stop>
                            </linearGradient>
                        </defs>

                        <!-- Horizontal Grid Lines & Y-Axis Labels -->
                        <line stroke="#E2E8F0" stroke-dasharray="3 3" stroke-width="1" x1="35" x2="590" y1="20" y2="20"></line>
