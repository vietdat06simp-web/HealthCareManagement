                                <div class="flex items-center gap-1 text-[10px] text-slate-400 font-medium uppercase">
                                    <span class="material-symbols-outlined text-[13px] text-primary">monitor_heart</span>
                                    <span>Huyết áp</span>
                                </div>
                                <div class="flex items-baseline gap-1 mt-0.5">
                                    <span class="font-metric-num text-slate-900 text-[16px] font-bold">138/85</span>
                                    <span class="text-[10px] text-slate-400">mmHg</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-0.5 text-[10px] font-semibold text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/60">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Hơi cao
                            </span>
                        </div>
                        <div class="flex items-center justify-between border-l border-slate-200/60 pl-2.5">
