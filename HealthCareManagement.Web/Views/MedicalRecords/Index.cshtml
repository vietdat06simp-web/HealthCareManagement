@model HealthCareManagement.Web.Models.ViewModels.MedicalRecordsIndexViewModel
@{
    ViewData["Title"] = "Hồ Sơ Y Tế - Bệnh Án Điện Tử & Cận Lâm Sàng";
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary-fixed": "#002113",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/medical-records.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-5">
    <!-- TempData Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-semibold shadow-xs animate-fadeIn">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
            <span class="flex-1">@TempData["SuccessMessage"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm font-semibold shadow-xs animate-fadeIn">
            <span class="material-symbols-outlined text-rose-600 text-[20px]">error</span>
            <span class="flex-1">@TempData["ErrorMessage"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }

    <!-- 1. BREADCRUMB & SECURITY COMPLIANCE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <a asp-controller="MedicalRecords" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer text-slate-500 text-decoration-none">
                Hồ sơ y tế
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Lịch sử khám bệnh &amp; Bệnh án</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="material-symbols-outlined text-[16px] text-tertiary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
            <span class="font-label-sm text-on-surface font-semibold">Bệnh án điện tử chuẩn HL7/FHIR</span>
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
        </div>
    </div>

    <!-- 2. PRIMARY CONTROL & MULTI-CRITERIA FILTER BAR -->
    <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-slate-200/90">
        <!-- Top Header Row: Title & Subtitle on Left, Action Buttons on Right -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-sky-600/20 shrink-0">
                    <span class="material-symbols-outlined text-[26px]">folder_shared</span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-headline-sm text-slate-900 tracking-tight m-0 text-lg md:text-xl font-bold">Hồ Sơ Bệnh Án Điện Tử</h1>
                        <span id="encounterCountBadge" class="px-2.5 py-0.5 rounded-full bg-sky-100 text-[#0284C7] font-label-sm font-bold text-xs border border-sky-200">@(Model?.MedicalRecords?.Count ?? 0) đợt khám</span>
                    </div>
                    <p class="font-body-sm text-slate-500 m-0 mt-0.5 text-xs">Lưu trữ tập trung chẩn đoán, kết quả cận lâm sàng và phác đồ điều trị gia đình</p>
                </div>
            </div>

            <!-- Action Buttons Group (Top Right) -->
            <div class="flex items-center gap-2.5 self-start sm:self-auto shrink-0">
                <button onclick="window.print()" class="inline-flex items-center gap-1.5 h-10 px-3.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition-all cursor-pointer" type="button" title="In / Xuất hồ sơ y bạ">
                    <span class="material-symbols-outlined text-[18px] text-rose-500">print</span>
                    <span class="hidden md:inline">In sổ khám</span>
                </button>
                <button id="btnAddNewEncounter" onclick="openAddEncounterModal()" class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-[#0284C7] hover:bg-[#0369a1] text-white font-semibold text-xs sm:text-sm shadow-md shadow-sky-600/20 transition-all cursor-pointer border-0 active:scale-95" type="button">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Thêm đợt khám mới</span>
                </button>
            </div>
        </div>

        <!-- Filter Form: Multi-criteria Filters -->
        <form asp-controller="MedicalRecords" asp-action="Index" method="get" id="filterForm" class="pt-4 space-y-3.5">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <!-- Dropdown 1: Chọn Thành viên -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">person</span>
                        Thành viên gia đình
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-slate-400 text-[18px]">groups</span>
                        </div>
                        <select name="memberId" id="patientSelector" onchange="this.form.submit()" class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 cursor-pointer focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all appearance-none shadow-xs">
                            <option value="">Tất cả thành viên trong nhà</option>
                            @if (Model?.Members != null)
                            {
                                foreach (var m in Model.Members)
                                {
                                    var age = DateTime.Today.Year - m.DateOfBirth.Year;
                                    <option value="@m.Id" selected="@(Model.SelectedMemberId == m.Id ? "selected" : null)">@m.FullName • @m.Relationship (@(age)t)</option>
                                }
                            }
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">unfold_more</span>
                        </div>
                    </div>
                </div>

                <!-- Dropdown 2: Khoảng thời gian khám -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">calendar_month</span>
                        Khoảng thời gian khám
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">event_note</span>
                        </div>
                        <select name="timeRange" id="timeRangeFilter" onchange="this.form.submit()" class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 cursor-pointer focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all appearance-none shadow-xs">
                            <option value="all" selected="@(Model?.SelectedTimeRange == "all" ? "selected" : null)">Tất cả thời gian</option>
                            <option value="30d" selected="@(Model?.SelectedTimeRange == "30d" ? "selected" : null)">30 ngày gần đây</option>
                            <option value="6m" selected="@(Model?.SelectedTimeRange == "6m" ? "selected" : null)">6 tháng gần đây</option>
                            <option value="2026" selected="@(Model?.SelectedTimeRange == "2026" ? "selected" : null)">Năm 2026</option>
                            <option value="2025" selected="@(Model?.SelectedTimeRange == "2025" ? "selected" : null)">Năm 2025</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Search Input: Tìm kiếm theo bệnh viện / bác sĩ / mã ICD-10 -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">search</span>
                        Tìm kiếm bệnh án
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">manage_search</span>
                        </div>
                        <input type="text" name="search" id="searchInput" value="@Model?.SearchKeyword" placeholder="Tên bệnh viện, bác sĩ, mã ICD-10..." class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all shadow-xs" />
                        @if (!string.IsNullOrEmpty(Model?.SearchKeyword))
                        {
                            <a asp-action="Index" class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 text-decoration-none">
                                <span class="material-symbols-outlined text-[16px]">close</span>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Specialty Chips & Reset -->
            <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2.5">
                <div class="flex items-center gap-1.5 overflow-x-auto custom-scrollbar py-0.5">
                    <span class="text-xs font-bold text-slate-500 whitespace-nowrap mr-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">tune</span>
                        Gợi ý tìm kiếm:
                    </span>
                    <button type="button" onclick="setSearchFilter('')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 border-0 cursor-pointer">Tất cả</button>
                    <button type="button" onclick="setSearchFilter('Bạch Mai')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 border-0 cursor-pointer">BV Bạch Mai</button>
                    <button type="button" onclick="setSearchFilter('Chợ Rẫy')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 border-0 cursor-pointer">BV Chợ Rẫy</button>
                    <button type="button" onclick="setSearchFilter('I10')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 border-0 cursor-pointer">ICD: I10</button>
                    <button type="button" onclick="setSearchFilter('E11')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 border-0 cursor-pointer">ICD: E11</button>
                </div>

                <a asp-action="Index" class="text-xs font-semibold text-slate-500 hover:text-[#0284C7] inline-flex items-center gap-1 transition-colors text-decoration-none">
                    <span class="material-symbols-outlined text-[15px]">refresh</span>
                    <span>Đặt lại bộ lọc</span>
                </a>
            </div>
        </form>
    </div>

    <!-- 3. MAIN GRID: 65% CLINICAL FEED (TIMELINE) / 35% VITALS & VAULT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mt-1">
        <!-- LEFT COLUMN: Examination Records Timeline -->
        <div class="lg:col-span-8 flex flex-col">
            <div class="flex items-center justify-between pb-3 mb-2">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[22px]">timeline</span>
                    <h2 class="font-title-md text-on-surface m-0 text-base font-bold">Lịch sử khám &amp; Diễn tiến bệnh án</h2>
                </div>
                <span class="font-label-sm text-outline text-xs">Sắp xếp: Mới nhất trước</span>
            </div>

            <!-- Timeline Container with connecting vertical line -->
            <div class="timeline-track pl-6 space-y-6">
                @if (Model?.MedicalRecords != null && Model.MedicalRecords.Any())
                {
                    foreach (var record in Model.MedicalRecords)
                    {
                        <div class="relative encounter-item" data-member="@record.MemberId">
                            <!-- Timeline Node Pin -->
                            <div class="timeline-node bg-primary ring-4 ring-primary-fixed shadow-sm">
                                <span class="w-1.5 h-1.5 rounded-full bg-surface-container-lowest"></span>
                            </div>

                            <article class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-slate-200/80 record-card transition-all hover:shadow-md hover:border-sky-300">
                                <!-- Header Badges: Date, Facility, Department, Code -->
                                <div class="flex flex-wrap items-center justify-between gap-2.5 pb-3 border-b border-slate-100 mb-3.5">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="px-3 py-1 rounded-full bg-primary text-on-primary font-label-md text-xs font-semibold tracking-wide">
                                            @record.ExamDate.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container-low text-on-surface font-label-md text-xs font-medium">
                                            <span class="material-symbols-outlined text-tertiary text-[16px]" style="font-variation-settings: 'FILL' 1;">domain_verification</span>
                                            @record.HospitalName
                                        </span>
                                        @if (!string.IsNullOrEmpty(record.DiagnosisCode))
                                        {
                                            <span class="px-2.5 py-1 rounded-md bg-secondary-fixed text-on-secondary-fixed-variant font-label-sm text-[11px] font-semibold">
                                                Mã ICD-10: @record.DiagnosisCode
                                            </span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs text-slate-500 font-medium">
                                            Bệnh nhân: <strong class="text-slate-800">@(record.Member?.FullName ?? "Thành viên")</strong>
                                        </span>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Hoàn tất
                                        </span>
                                    </div>
                                </div>

                                <!-- Doctor & Diagnosis Summary -->
                                <div class="mb-3">
                                    <div class="flex items-center gap-2 mb-1">
                                        <h3 class="font-title-sm text-slate-900 font-bold m-0 text-sm md:text-base">@record.Diagnosis</h3>
                                    </div>
                                    <p class="font-body-sm text-slate-600 m-0 text-xs">
                                        Bác sĩ điều trị: <strong class="text-slate-800">@(string.IsNullOrEmpty(record.DoctorName) ? "Bác sĩ chuyên khoa" : record.DoctorName)</strong>
                                    </p>
                                </div>

                                @if (!string.IsNullOrEmpty(record.Conclusion))
                                {
                                    <!-- Clinical Conclusion / Instructions -->
                                    <div class="p-3 rounded-lg bg-sky-50/60 border border-sky-100 text-xs text-slate-700 mb-3.5 flex items-start gap-2">
                                        <span class="material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5">clinical_notes</span>
                                        <div>
                                            <strong class="text-slate-900">Phác đồ &amp; Kết luận:</strong>
                                            <p class="m-0 mt-0.5 text-slate-600">@record.Conclusion</p>
                                        </div>
                                    </div>
                                }

                                <!-- Bottom Actions & Attachments -->
                                <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        @if (record.MedicalAttachments != null && record.MedicalAttachments.Any())
                                        {
                                            <div class="flex items-center gap-1.5">
                                                @foreach (var att in record.MedicalAttachments)
                                                {
                                                    <a href="@att.FilePath" target="_blank" class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-sky-50 text-sky-700 hover:bg-sky-100 text-xs font-semibold text-decoration-none border border-sky-200 transition-colors" title="@att.OriginalFileName">
                                                        <span class="material-symbols-outlined text-[15px]">attachment</span>
                                                        <span class="max-w-[120px] truncate">@att.OriginalFileName</span>
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">Không có tệp đính kèm</span>
                                        }
                                    </div>

                                    <div class="flex items-center gap-3">
                                        <button type="button" onclick="confirmDeleteFromIndex(@record.Id)" class="inline-flex items-center gap-1 text-xs text-rose-500 hover:text-rose-700 font-semibold border-0 bg-transparent cursor-pointer p-0 transition-colors">
                                            <span class="material-symbols-outlined text-[15px]">delete</span>
                                            <span>Xóa</span>
                                        </button>

                                        <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@record.Id" class="inline-flex items-center gap-1 font-label-md text-xs text-primary hover:text-primary-container font-semibold transition-colors text-decoration-none">
                                            <span>Xem chi tiết</span>
                                            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                }
                else
                {
                    <!-- EMPTY STATE THỰC TẾ -->
                    <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-xs">
                        <div class="w-16 h-16 rounded-2xl bg-sky-50 text-[#0284C7] flex items-center justify-center mx-auto mb-4 border border-sky-100 shadow-inner">
                            <span class="material-symbols-outlined text-[36px]">folder_off</span>
                        </div>
                        <h3 class="text-base font-bold text-slate-900 mb-1">Chưa có hồ sơ bệnh án nào được ghi nhận</h3>
                        <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">Tổ ấm hiện chưa có đợt khám bệnh hoặc chẩn đoán cận lâm sàng nào. Hãy bắt đầu số hóa hồ sơ y tế gia đình ngay hôm nay.</p>
                        <button onclick="openAddEncounterModal()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0284C7] text-white text-xs sm:text-sm font-semibold hover:bg-[#0369a1] shadow-md shadow-sky-600/20 transition-all border-0 cursor-pointer">
                            <span class="material-symbols-outlined text-[18px]">add_circle</span>
                            <span>+ Thêm hồ sơ bệnh án</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT COLUMN: Clinical Vitals & Medical Vault -->
        <div class="lg:col-span-4 flex flex-col gap-5">
            <!-- WIDGET 1: Sinh Hiệu Lần Khám Gần Nhất -->
            <section class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">vital_signs</span>
                        <h2 class="font-title-md text-on-surface m-0 text-sm sm:text-base font-bold">Sinh Hiệu Gần Nhất</h2>
                    </div>
                    <span class="px-2 py-0.5 rounded-full @(Model?.LatestMetric?.IsAbnormal == true ? "bg-rose-100 text-rose-800" : "bg-tertiary-fixed text-on-tertiary-fixed") font-label-sm text-[10px] font-bold">
                        @(Model?.LatestMetric != null ? (Model.LatestMetric.IsAbnormal ? "Cần lưu ý" : "Ổn định") : "Chưa có")
                    </span>
                </div>
                <p class="font-label-sm text-outline mb-3 m-0 text-xs">
                    Bệnh nhân: <strong class="text-slate-800">@(Model?.LatestMetric?.Member?.FullName ?? "Chưa có dữ liệu")</strong> • Ghi nhận @(Model?.LatestMetric != null ? Model.LatestMetric.RecordedAt.ToString("dd/MM/yyyy") : "--/--/----")
                </p>

                <!-- 2x2 Metric Tiles Grid -->
                <div class="grid grid-cols-2 gap-2.5 mb-3.5">
                    <!-- Blood Pressure Tile -->
                    <div class="p-3 rounded-lg bg-surface-container-low flex flex-col justify-between border border-slate-200/50">
                        <span class="font-label-sm text-[11px] text-on-surface-variant font-medium">Huyết áp (HA)</span>
                        <div class="my-1">
                            <span class="font-metric-num text-xl text-on-surface font-bold">
                                @(Model?.LatestMetric?.SystolicBP != null && Model?.LatestMetric?.DiastolicBP != null ? $"{Model.LatestMetric.SystolicBP}/{Model.LatestMetric.DiastolicBP}" : "--/--")
                            </span>
                            <span class="font-label-sm text-[10px] text-outline ml-0.5">mmHg</span>
                        </div>
                        <div class="flex items-center gap-1 text-tertiary font-label-sm text-[10px] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                            <span>@(Model?.LatestMetric?.SystolicBP != null ? "Gần nhất" : "Chưa có số đo")</span>
                        </div>
                    </div>

                    <!-- Heart Rate Tile -->
                    <div class="p-3 rounded-lg bg-surface-container-low flex flex-col justify-between border border-slate-200/50">
                        <span class="font-label-sm text-[11px] text-on-surface-variant font-medium">Nhịp tim</span>
                        <div class="my-1">
                            <span class="font-metric-num text-xl text-on-surface font-bold">
                                @(Model?.LatestMetric?.HeartRate != null ? $"{Model.LatestMetric.HeartRate}" : "--")
                            </span>
                            <span class="font-label-sm text-[10px] text-outline ml-0.5">bpm</span>
                        </div>
                        <div class="flex items-center gap-1 text-tertiary font-label-sm text-[10px] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                            <span>@(Model?.LatestMetric?.HeartRate != null ? "Nhịp tim đo được" : "Chưa có số đo")</span>
                        </div>
                    </div>

                    <!-- Blood Glucose Tile -->
                    <div class="p-3 rounded-lg bg-surface-container-low flex flex-col justify-between border border-slate-200/50">
                        <span class="font-label-sm text-[11px] text-on-surface-variant font-medium">Đường huyết</span>
                        <div class="my-1">
                            <span class="font-metric-num text-xl text-secondary font-bold">
                                @(Model?.LatestMetric?.BloodSugar != null ? $"{Model.LatestMetric.BloodSugar}" : "--")
                            </span>
                            <span class="font-label-sm text-[10px] text-outline ml-0.5">mmol/L</span>
                        </div>
                        <div class="flex items-center gap-1 text-secondary font-label-sm text-[10px] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                            <span>@(Model?.LatestMetric?.BloodSugar != null ? "Chỉ số đường huyết" : "Chưa có số đo")</span>
                        </div>
                    </div>

                    <!-- SpO2 / Thân nhiệt Tile -->
                    <div class="p-3 rounded-lg bg-surface-container-low flex flex-col justify-between border border-slate-200/50">
                        <span class="font-label-sm text-[11px] text-on-surface-variant font-medium">SpO2 / Thân nhiệt</span>
                        <div class="my-1">
                            <span class="font-metric-num text-xl text-on-surface font-bold">
                                @(Model?.LatestMetric?.SpO2 != null ? $"{Model.LatestMetric.SpO2}%" : (Model?.LatestMetric?.BodyTemperature != null ? $"{Model.LatestMetric.BodyTemperature}°C" : "--"))
                            </span>
                        </div>
                        <div class="flex items-center gap-1 text-tertiary font-label-sm text-[10px] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                            <span>@(Model?.LatestMetric?.SpO2 != null ? "Nồng độ Oxy" : "Chỉ số sinh hiệu")</span>
                        </div>
                    </div>
                </div>

                <!-- Doctor's Note Callout -->
                <div class="p-3 rounded-lg bg-surface-container-high flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5">clinical_notes</span>
                    <p class="font-body-sm text-xs text-on-surface leading-snug m-0">
                        @if (!string.IsNullOrWhiteSpace(Model?.LatestRecord?.Conclusion ?? Model?.LatestRecord?.Notes))
                        {
                            <strong>Lời dặn bác sĩ:</strong> @(Model?.LatestRecord?.Conclusion ?? Model?.LatestRecord?.Notes)
                        }
                        else
                        {
                            <span class="text-slate-500 italic">Chưa có ghi chú hoặc lời dặn dò y tế gần đây.</span>
                        }
                    </p>
                </div>
            </section>

            <!-- WIDGET 2: Kho Dữ Liệu Y Khoa (Medical Vault) -->
            <section class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between pb-3 mb-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">lock</span>
                        <h2 class="font-title-md text-on-surface m-0 text-sm sm:text-base font-bold">Kho Dữ Liệu Y Khoa</h2>
                    </div>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-sm text-[10px] font-semibold">
                        Mã hóa an toàn
                    </span>
                </div>
                <p class="font-body-sm text-xs text-on-surface-variant mb-3.5 m-0">
                    Lưu trữ tập trung chẩn đoán hình ảnh, kết quả xét nghiệm và phác đồ điều trị gia đình.
                </p>

                <!-- Category Counts Rows -->
                <div class="space-y-2 mb-4">
                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low border border-slate-200/50">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-error text-[18px]">bloodtype</span>
                            <span class="font-label-md text-xs text-on-surface font-medium">Hồ sơ khám &amp; Bệnh án</span>
                        </div>
                        <span class="font-label-sm text-xs text-on-surface-variant font-bold">@(Model?.MedicalRecords?.Count ?? 0) hồ sơ</span>
                    </div>

                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low border border-slate-200/50">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-primary text-[18px]">radiology</span>
                            <span class="font-label-md text-xs text-on-surface font-medium">Tệp đính kèm &amp; Hình ảnh</span>
                        </div>
                        <span class="font-label-sm text-xs text-on-surface-variant font-bold">@(Model?.TotalAttachments ?? 0) tệp</span>
                    </div>

                    <div class="flex items-center justify-between p-2.5 rounded-lg bg-surface-container-low border border-slate-200/50">
                        <div class="flex items-center gap-2.5">
                            <span class="material-symbols-outlined text-secondary text-[18px]">receipt_long</span>
                            <span class="font-label-md text-xs text-on-surface font-medium">Toa thuốc liên kết</span>
                        </div>
                        <span class="font-label-sm text-xs text-on-surface-variant font-bold">@(Model?.TotalPrescriptions ?? 0) toa thuốc</span>
                    </div>
                </div>
            </section>

            <!-- WIDGET 3: Lịch Hẹn Tái Khám Tới -->
            <section class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-slate-200/80">
                <div class="flex items-center justify-between pb-3 mb-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[22px]">event_upcoming</span>
                        <h2 class="font-title-md text-on-surface m-0 text-sm sm:text-base font-bold">Lịch Hẹn Tái Khám Tới</h2>
                    </div>
                    @if (Model?.NextAppointment != null)
                    {
                        var daysLeft = Math.Max(0, (Model.NextAppointment.AppointmentDateTime.Date - DateTime.Today).Days);
                        <span class="px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant font-label-sm text-[10px] font-bold">
                            @(daysLeft == 0 ? "Hôm nay" : $"Còn {daysLeft} ngày")
                        </span>
                    }
                </div>

                @if (Model?.NextAppointment != null)
                {
                    <div class="p-3.5 rounded-xl bg-surface-container-low space-y-2.5 mb-3.5 border border-slate-200/50">
                        <div class="flex items-start gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0 mt-0.5 font-bold">
                                <span class="material-symbols-outlined text-[18px]">alarm</span>
                            </div>
                            <div>
                                <p class="font-title-md text-xs sm:text-sm text-on-surface font-bold m-0">@(Model.NextAppointment.DoctorName ?? Model.NextAppointment.Title)</p>
                                <p class="font-body-sm text-[11px] text-on-surface-variant m-0">@(Model.NextAppointment.Member?.FullName ?? "Thành viên gia đình")</p>
                            </div>
                        </div>

                        <div class="space-y-1.5 pt-2 border-t border-slate-200/50">
                            <div class="flex items-center gap-2 text-on-surface font-body-sm text-xs">
                                <span class="material-symbols-outlined text-outline text-[16px]">schedule</span>
                                <span><strong>@Model.NextAppointment.AppointmentDateTime.ToString("dd/MM/yyyy")</strong> • @Model.NextAppointment.AppointmentDateTime.ToString("HH:mm")</span>
                            </div>
                            <div class="flex items-center gap-2 text-on-surface font-body-sm text-xs">
                                <span class="material-symbols-outlined text-outline text-[16px]">location_on</span>
                                <span class="truncate">@Model.NextAppointment.Location</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="py-6 px-3 rounded-xl bg-surface-container-low text-center border border-dashed border-slate-200 mb-3.5">
                        <span class="material-symbols-outlined text-slate-300 text-[32px] mb-1">calendar_month</span>
                        <p class="font-title-md text-slate-700 text-xs font-bold mb-1">Chưa có lịch hẹn tái khám</p>
                        <p class="font-body-sm text-slate-400 text-[11px] mb-3">Tổ ấm hiện chưa ghi nhận lịch tái khám sắp tới.</p>
                        <a asp-controller="Appointments" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-semibold text-decoration-none shadow-xs hover:bg-primary-container transition-colors">
                            <span class="material-symbols-outlined text-[15px]">add</span>
                            <span>Đặt lịch tái khám</span>
                        </a>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

<!-- ==================== MODAL: THÊM ĐỢT KHÁM BỆNH MỚI ==================== -->
<div id="addEncounterModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-200 my-8" id="addEncounterModalCard">
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-100 text-[#0284C7] flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[24px]">post_add</span>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900 m-0">Ghi Nhận Hồ Sơ Đợt Khám Mới</h3>
                    <p class="text-xs text-slate-500 m-0 mt-0.5">Nhập chi tiết chẩn đoán, kết quả khám và tệp đính kèm cận lâm sàng</p>
                </div>
            </div>
            <button type="button" onclick="closeAddEncounterModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Create Form -->
        <form asp-controller="MedicalRecords" asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-4">
            @Html.AntiForgeryToken()

            <!-- Row 1: Thành viên khám & Ngày khám -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Thành viên gia đình <span class="text-rose-500">*</span>
                    </label>
                    <select name="MemberId" id="newRecord_MemberId" class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all cursor-pointer" required>
                        @if (Model?.Members != null && Model.Members.Any())
                        {
                            foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.FullName (@m.Relationship)</option>
                            }
                        }
                        else
                        {
                            <option value="">Chưa có thành viên trong gia đình</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Ngày khám <span class="text-rose-500">*</span>
                    </label>
                    <input name="VisitDate" id="newRecord_VisitDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" required />
                </div>
            </div>

            <!-- Row 2: Cơ sở y tế & Bác sĩ -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Cơ sở y tế / Bệnh viện <span class="text-rose-500">*</span>
                    </label>
                    <input name="FacilityName" id="newRecord_FacilityName" placeholder="VD: Bệnh viện Chợ Rẫy, PK Đa khoa..." class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" required />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Bác sĩ điều trị
                    </label>
                    <input name="DoctorName" id="newRecord_DoctorName" placeholder="VD: BS. CKII Trần Quốc Bảo" class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" />
                </div>
            </div>

            <!-- Row 3: Chẩn đoán & Mã ICD-10 -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-2">
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Chẩn đoán y khoa <span class="text-rose-500">*</span>
                    </label>
                    <input name="Diagnosis" id="newRecord_Diagnosis" placeholder="VD: Tăng huyết áp nguyên phát, Viêm họng cấp..." class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" required />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Mã ICD-10 (nếu có)
                    </label>
                    <input name="DiagnosisCode" id="newRecord_DiagnosisCode" placeholder="VD: I10, E11, J02" class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all uppercase" />
                </div>
            </div>

            <!-- Row 4: Phác đồ điều trị / Lời dặn -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    Phác đồ điều trị / Kết luận &amp; Dặn dò
                </label>
                <textarea name="TreatmentPlan" id="newRecord_TreatmentPlan" rows="3" placeholder="Ghi chú phác đồ thuốc, hướng điều trị hoặc chế độ kiêng cữ..." class="w-full p-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all"></textarea>
            </div>

            <!-- Row 5: Ngày hẹn tái khám & Tệp đính kèm -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Hẹn ngày tái khám (nếu có)
                    </label>
                    <input name="NextAppointmentDate" id="newRecord_NextAppointmentDate" type="date" class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        Tệp đính kèm (Ảnh/PDF xét nghiệm)
                    </label>
                    <input name="AttachmentFile" id="newRecord_AttachmentFile" type="file" accept="image/*,.pdf" class="w-full h-10 text-xs file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-50 file:text-[#0284C7] hover:file:bg-sky-100 cursor-pointer" />
                </div>
            </div>

            <!-- Row 6: Ghi chú thêm -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    Ghi chú thêm
                </label>
                <input name="Notes" id="newRecord_Notes" placeholder="Triệu chứng trước khám, phản ứng thuốc nếu có..." class="w-full h-10 px-3 bg-slate-50 text-slate-800 text-xs font-medium rounded-xl border border-slate-200 focus:bg-white focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all" />
            </div>

            <!-- Submit Buttons -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeAddEncounterModal()" class="px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 cursor-pointer">
                    Hủy bỏ
                </button>
                <button type="submit" class="inline-flex items-center gap-1.5 px-5 py-2 rounded-xl bg-[#0284C7] hover:bg-[#0369a1] text-xs font-bold text-white shadow-md shadow-sky-600/20 cursor-pointer border-0 transition-all">
                    <span class="material-symbols-outlined text-[16px]">save</span>
                    <span>Lưu hồ sơ bệnh án</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Form DELETE hidden for list item delete -->
<form id="deleteIndexRecordForm" asp-controller="MedicalRecords" asp-action="Delete" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteIndexRecordId" value="" />
</form>

@section Scripts {
    <script>
        function openAddEncounterModal() {
            var modal = document.getElementById('addEncounterModal');
            var card = document.getElementById('addEncounterModalCard');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
            card.classList.remove('scale-95');
            card.classList.add('scale-100');
        }

        function closeAddEncounterModal() {
            var modal = document.getElementById('addEncounterModal');
            var card = document.getElementById('addEncounterModalCard');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
            card.classList.add('scale-95');
            card.classList.remove('scale-100');
        }

        function setSearchFilter(val) {
            document.getElementById('searchInput').value = val;
            document.getElementById('filterForm').submit();
        }

        function confirmDeleteFromIndex(id) {
            if (confirm("Bạn có chắc chắn muốn xóa hồ sơ bệnh án này? Toàn bộ tệp cận lâm sàng đính kèm sẽ bị xóa vĩnh viễn.")) {
                document.getElementById('deleteIndexRecordId').value = id;
                document.getElementById('deleteIndexRecordForm').submit();
            }
        }
    </script>
}
