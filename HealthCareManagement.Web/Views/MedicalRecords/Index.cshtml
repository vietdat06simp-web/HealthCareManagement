@{
    ViewData["Title"] = "Hồ Sơ Y Tế - Bệnh Án Điện Tử & Cận Lâm Sàng";
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary-fixed": "#002113",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/medical-records.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-5">
    <!-- 1. BREADCRUMB & SECURITY COMPLIANCE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <a asp-controller="MedicalRecords" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer text-slate-500 text-decoration-none">
                Hồ sơ y tế
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Lịch sử khám bệnh &amp; Chẩn đoán</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="material-symbols-outlined text-[16px] text-tertiary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
            <span class="font-label-sm text-on-surface font-semibold">Chứng nhận hồ sơ số y tế HL7/FHIR</span>
            <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
        </div>
    </div>

    <!-- 2. PRIMARY CONTROL & MULTI-CRITERIA FILTER BAR -->
    <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm border border-slate-200/90">
        <!-- Top Header Row: Title & Subtitle on Left, Action Buttons on Right -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-sky-600/20 shrink-0">
                    <span class="material-symbols-outlined text-[26px]">folder_shared</span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-headline-sm text-slate-900 tracking-tight m-0 text-lg md:text-xl font-bold">Hồ Sơ Bệnh Án Điện Tử</h1>
                        <span id="encounterCountBadge" class="px-2.5 py-0.5 rounded-full bg-sky-100 text-[#0284C7] font-label-sm font-bold text-xs border border-sky-200">12 đợt khám</span>
                    </div>
                    <p class="font-body-sm text-slate-500 m-0 mt-0.5 text-xs">Lưu trữ tập trung chẩn đoán, kết quả cận lâm sàng và toa thuốc gia đình</p>
                </div>
            </div>

            <!-- Action Buttons Group (Top Right) -->
            <div class="flex items-center gap-2.5 self-start sm:self-auto shrink-0">
                <button onclick="document.getElementById('btnExportFullRecord').click()" class="inline-flex items-center gap-1.5 h-10 px-3.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-xs transition-all cursor-pointer" type="button" title="Xuất toàn bộ hồ sơ y bạ PDF">
                    <span class="material-symbols-outlined text-[18px] text-rose-500">picture_as_pdf</span>
                    <span class="hidden md:inline">Xuất y bạ PDF</span>
                </button>
                <button id="btnAddNewEncounter" class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-xl bg-[#0284C7] hover:bg-[#0369a1] text-white font-semibold text-xs sm:text-sm shadow-md shadow-sky-600/20 transition-all cursor-pointer border-0 active:scale-95" type="button">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Thêm đợt khám mới</span>
                </button>
            </div>
        </div>

        <!-- Filter Toolbar: 3 Equal Filter Dropdowns + Specialty Chips -->
        <div class="pt-4 space-y-3.5">
            <!-- 3 Criteria Grid with consistent heights & labels -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <!-- Dropdown 1: Chọn Thành viên -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">person</span>
                        Thành viên gia đình
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <div id="patientAvatarBadge" class="w-5 h-5 rounded-full bg-gradient-to-tr from-sky-600 to-cyan-500 text-white flex items-center justify-center font-bold text-[10px] shadow-xs">
                                K
                            </div>
                        </div>
                        <select id="patientSelector" class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 cursor-pointer focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all appearance-none shadow-xs">
                            <option value="all">Tất cả thành viên trong nhà</option>
                            <option value="khang" selected>Trần Quốc Khang • Ông nội (68t)</option>
                            <option value="dat">Trần Viết Đạt • Bố (38t)</option>
                            <option value="ha">Lê Thu Hà • Mẹ (35t)</option>
                            <option value="an">Trần Bảo An • Con trai (8t)</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">unfold_more</span>
                        </div>
                    </div>
                </div>

                <!-- Dropdown 2: Khoảng thời gian khám -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">calendar_month</span>
                        Khoảng thời gian khám
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">event_note</span>
                        </div>
                        <select id="timeRangeFilter" class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 cursor-pointer focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all appearance-none shadow-xs">
                            <option value="all" selected>Tất cả thời gian</option>
                            <option value="30d">30 ngày gần đây</option>
                            <option value="6m">6 tháng gần đây</option>
                            <option value="2026">Năm 2026</option>
                            <option value="2025">Năm 2025</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">expand_more</span>
                        </div>
                    </div>
                </div>

                <!-- Dropdown 3: Loại hồ sơ khám -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">medical_services</span>
                        Loại hồ sơ &amp; Bệnh án
                    </label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">category</span>
                        </div>
                        <select id="recordTypeFilter" class="w-full h-10 pl-9 pr-8 bg-slate-50/80 hover:bg-white text-slate-800 font-semibold text-xs rounded-xl border border-slate-200 cursor-pointer focus:outline-none focus:border-[#0284C7] focus:ring-2 focus:ring-sky-100 transition-all appearance-none shadow-xs">
                            <option value="all" selected>Tất cả loại hồ sơ</option>
                            <option value="routine">Khám định kỳ</option>
                            <option value="lab">Xét nghiệm &amp; Cận lâm sàng</option>
                            <option value="emergency">Cấp cứu &amp; Nhập viện</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                            <span class="material-symbols-outlined text-[18px]">expand_more</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Specialty Filter Tabs embedded harmoniously at the bottom of the card -->
            <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2.5">
                <div class="flex items-center gap-1.5 overflow-x-auto custom-scrollbar py-0.5">
                    <span class="text-xs font-bold text-slate-500 whitespace-nowrap mr-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px] text-[#0284C7]">tune</span>
                        Chuyên khoa:
                    </span>
                    <button onclick="filterSpecialty('all', this)" class="specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-[#0284C7] text-white shadow-xs font-semibold border-0 cursor-pointer whitespace-nowrap transition-all" type="button">Tất cả</button>
                    <button onclick="filterSpecialty('routine', this)" class="specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 border-0 transition-colors cursor-pointer whitespace-nowrap" type="button">Khám định kỳ</button>
                    <button onclick="filterSpecialty('cardiology', this)" class="specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 border-0 transition-colors cursor-pointer whitespace-nowrap" type="button">Tim mạch &amp; Nội tiết</button>
                    <button onclick="filterSpecialty('allergy', this)" class="specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 border-0 transition-colors cursor-pointer whitespace-nowrap" type="button">Dị ứng &amp; Miễn dịch</button>
                    <button onclick="filterSpecialty('pediatric', this)" class="specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 border-0 transition-colors cursor-pointer whitespace-nowrap" type="button">Nhi khoa &amp; Tiêm chủng</button>
                </div>

                <button onclick="resetAllFilters()" class="text-xs font-semibold text-slate-500 hover:text-[#0284C7] inline-flex items-center gap-1 transition-colors border-0 bg-transparent cursor-pointer p-0" type="button" title="Đặt lại bộ lọc về mặc định">
                    <span class="material-symbols-outlined text-[15px]">refresh</span>
                    <span>Đặt lại bộ lọc</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. MAIN GRID: 65% CLINICAL FEED (TIMELINE) / 35% VITALS & VAULT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mt-1">
        <!-- LEFT COLUMN: Examination Records Timeline -->
        <div class="lg:col-span-8 flex flex-col">
            <div class="flex items-center justify-between pb-3 mb-2">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[22px]">timeline</span>
                    <h2 class="font-title-md text-on-surface m-0">Lịch sử khám &amp; Diễn tiến bệnh án</h2>
                </div>
                <span class="font-label-sm text-outline">Sắp xếp: Mới nhất trước</span>
            </div>

            <!-- Timeline Container with connecting vertical line -->
            <div class="timeline-track pl-6 space-y-6">
                <!-- ENCOUNTER CARD 1: Bệnh viện Bạch Mai / Vinmec - Tim mạch & Nội tiết -->
                <div class="relative encounter-item" data-member="khang" data-type="routine" data-specialty="cardiology">
                    <!-- Timeline Node Pin -->
                    <div class="timeline-node bg-primary ring-4 ring-primary-fixed shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-surface-container-lowest"></span>
                    </div>

                    <article class="bg-surface-container-lowest rounded-xl p-5 shadow-sm border border-slate-200/80 record-card">
                        <!-- Header Badges: Date, Facility, Department, Code -->
                        <div class="flex flex-wrap items-center justify-between gap-2.5 pb-3 border-b border-slate-100 mb-3.5">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-3 py-1 rounded-full bg-primary text-on-primary font-label-md text-xs font-semibold tracking-wide">
                                    15/10/2026
                                </span>
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-surface-container-low text-on-surface font-label-md text-xs font-medium">
                                    <span class="material-symbols-outlined text-tertiary text-[16px]" style="font-variation-settings: 'FILL' 1;">domain_verification</span>
                                    Bệnh viện Bạch Mai - Viện Tim Mạch Quốc Gia
                                </span>
                                <span class="px-2.5 py-1 rounded-md bg-secondary-fixed text-on-secondary-fixed-variant font-label-sm text-[11px] font-semibold">
                                    Khoa Tim Mạch &amp; Nội Tiết
                                </span>
                            </div>
                            <span class="font-label-sm text-outline font-mono">#BM-2026-8812</span>
                        </div>

                        <!-- Doctor In-Charge Details -->
                        <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-low mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary shrink-0 font-bold">
                                    <span class="material-symbols-outlined text-[20px]">stethoscope</span>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-title-md text-on-surface font-bold text-sm">BS. CKI Nguyễn Văn Tuấn</span>
                                        <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-surface-container-lowest text-tertiary font-label-sm text-[10px] font-semibold border border-emerald-200">
                                            <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                            Chữ ký số hợp lệ
                                        </span>
                                    </div>
                                    <span class="font-body-sm text-on-surface-variant text-xs">Trưởng đơn vị Quản lý Bệnh lý mạn tính người cao tuổi</span>
                                </div>
                            </div>
                            <button onclick="showToast('Xác thực chữ ký số', 'BS. CKI Nguyễn Văn Tuấn • Chứng thư số Ban Cơ yếu Chính phủ')" class="hidden sm:inline-flex items-center gap-1 font-label-sm text-xs text-primary hover:text-primary-container font-medium p-1.5 border-0 bg-transparent cursor-pointer" type="button">
                                <span class="material-symbols-outlined text-[16px]">history_edu</span>
                                <span>Xem chữ ký</span>
                            </button>
                        </div>

                        <!-- Clinical Findings & ICD-10 Diagnosis -->
                        <div class="space-y-2.5 mb-4">
                            <div>
                                <span class="font-label-sm text-outline uppercase tracking-wider block mb-1">Chẩn đoán xác định &amp; Tình trạng lâm sàng</span>
                                <p class="font-body-md text-on-surface leading-relaxed text-sm m-0">
                                    Tái khám định kỳ tăng huyết áp vô căn &amp; Đái tháo đường Type 2 có kiểm soát tốt. Bệnh nhân không xuất hiện cơn đau thắt ngực, không hoa mắt chóng mặt tư thế, tuân thủ nghiêm ngặt phác đồ điều trị và chế độ dinh dưỡng.
                                </p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 pt-1">
                                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-xs">
                                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                                    <span class="font-semibold text-primary">ICD-10: I10</span>
                                    <span class="text-on-surface-variant">• Tăng huyết áp vô căn (nguyên phát)</span>
                                </div>
                                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-xs">
                                    <span class="w-2 h-2 rounded-full bg-secondary"></span>
                                    <span class="font-semibold text-secondary">ICD-10: E11.9</span>
                                    <span class="text-on-surface-variant">• ĐTĐ Type 2 không biến chứng</span>
                                </div>
                            </div>
                        </div>

                        <!-- Attachments Gallery: DICOM, PDF, ECG -->
                        <div class="mb-4">
                            <div class="flex items-center justify-between mb-2.5">
                                <span class="font-label-sm text-outline uppercase tracking-wider block">Tệp đính kèm cận lâm sàng &amp; Hình ảnh học (3 tệp)</span>
                                <span class="text-[11px] text-primary font-medium">Bảo mật mã hóa y khoa</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                                <!-- DICOM File Card -->
                                <div class="p-3 rounded-lg bg-surface-container-low attachment-card flex flex-col justify-between">
                                    <div class="flex items-start gap-2.5 mb-2">
                                        <span class="material-symbols-outlined text-primary text-[24px]">radiology</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="font-title-md text-xs text-on-surface truncate font-semibold m-0" title="X-Quang_Tim_Phoi_Thang.dcm">X-Quang_Tim_Phoi.dcm</p>
                                            <span class="font-label-sm text-[10px] text-outline">DICOM PACS • 4.2 MB</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between pt-2 border-t border-slate-200/50">
                                        <button onclick="previewFile('X-Quang_Tim_Phoi.dcm', 'DICOM PACS')" class="font-label-sm text-xs text-primary font-medium hover:underline inline-flex items-center gap-1 border-0 bg-transparent cursor-pointer p-0" type="button">
                                            <span class="material-symbols-outlined text-[14px]">visibility</span> Xem ảnh
                                        </button>
                                        <button onclick="downloadAttachment('X-Quang_Tim_Phoi.dcm')" class="text-on-surface-variant hover:text-primary transition-colors p-1 border-0 bg-transparent cursor-pointer" title="Tải tệp đính kèm" type="button">
                                            <span class="material-symbols-outlined text-[16px]">download</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- PDF Report File Card -->
                                <div class="p-3 rounded-lg bg-surface-container-low attachment-card flex flex-col justify-between">
                                    <div class="flex items-start gap-2.5 mb-2">
                                        <span class="material-symbols-outlined text-error text-[24px]">picture_as_pdf</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="font-title-md text-xs text-on-surface truncate font-semibold m-0" title="Sinh_hoa_mau_18_chi_so.pdf">Sinh_hoa_mau_18_chi_so.pdf</p>
                                            <span class="font-label-sm text-[10px] text-outline">PDF Report • 1.8 MB</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between pt-2 border-t border-slate-200/50">
                                        <button onclick="previewFile('Sinh_hoa_mau_18_chi_so.pdf', 'Kết quả xét nghiệm')" class="font-label-sm text-xs text-primary font-medium hover:underline inline-flex items-center gap-1 border-0 bg-transparent cursor-pointer p-0" type="button">
                                            <span class="material-symbols-outlined text-[14px]">visibility</span> Xem kết quả
                                        </button>
                                        <button onclick="downloadAttachment('Sinh_hoa_mau_18_chi_so.pdf')" class="text-on-surface-variant hover:text-primary transition-colors p-1 border-0 bg-transparent cursor-pointer" title="Tải tệp đính kèm" type="button">
                                            <span class="material-symbols-outlined text-[16px]">download</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- ECG Wave File Card -->
                                <div class="p-3 rounded-lg bg-surface-container-low attachment-card flex flex-col justify-between">
                                    <div class="flex items-start gap-2.5 mb-2">
