                <button onclick="showToast('Nhắc nhở thông minh', 'Đã kích hoạt gửi tin nhắn SMS & thông báo đẩy trước 3 ngày')" class="w-full h-10 rounded-lg bg-primary text-on-primary hover:bg-primary-container font-label-md text-xs font-semibold flex items-center justify-center gap-2 shadow-xs transition-all active:scale-95 border-0 cursor-pointer" type="button">
                    <span class="material-symbols-outlined text-[18px]">notifications_active</span>
                    <span>Bật nhắc nhở thông minh</span>
                </button>
            </section>
        </div>
    </div>
</div>

<!-- Modal: Xem chi tiết đơn thuốc điện tử -->
<div id="prescriptionModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-200" id="prescriptionModalCard">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-sky-100 text-primary flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-[20px]">prescriptions</span>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-slate-900 m-0">Toa Thuốc Điện Tử Chi Tiết</h3>
                    <p id="modalPrescriptionDate" class="text-[11px] text-slate-500 m-0">Đợt khám: 15/10/2026</p>
                </div>
            </div>
            <button onclick="closePrescriptionModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <div class="space-y-3 mb-5">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-bold text-slate-900 m-0">1. Amlodipine 5mg (Pfizer)</h4>
                    <span class="text-[10px] font-bold text-sky-700 bg-sky-50 px-2 py-0.5 rounded border border-sky-200">30 viên</span>
                </div>
                <p class="text-[11px] text-slate-600 mt-1 m-0">Liều dùng: Uống 1 viên vào buổi sáng sau ăn. Kiểm soát huyết áp.</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-bold text-slate-900 m-0">2. Metformin 850mg (Glucophage)</h4>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">60 viên</span>
                </div>
                <p class="text-[11px] text-slate-600 mt-1 m-0">Liều dùng: Uống 2 viên/ngày (1 viên sau ăn trưa, 1 viên sau ăn tối).</p>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-bold text-slate-900 m-0">3. Atorvastatin 20mg (Lipitor)</h4>
                    <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">30 viên</span>
                </div>
                <p class="text-[11px] text-slate-600 mt-1 m-0">Liều dùng: Uống 1 viên vào buổi tối trước khi đi ngủ. Điều hòa lipid máu.</p>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
            <button onclick="downloadAttachment('Toa_thuoc_dien_tu_15102026.pdf')" class="px-4 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-xs font-bold text-slate-700 cursor-pointer inline-flex items-center gap-1.5" type="button">
                <span class="material-symbols-outlined text-[16px]">download</span> Tải bản PDF
            </button>
            <button onclick="closePrescriptionModal()" class="px-4 py-2 rounded-xl bg-primary hover:bg-[#0369a1] text-xs font-bold text-white cursor-pointer border-0" type="button">
                Đóng
            </button>
        </div>
    </div>
</div>

<!-- Floating Notification Toast -->
<div id="medicalRecordsToast" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 max-w-sm">
    <div class="bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl border border-slate-700 flex items-center gap-3">
        <div id="mrToastIconWrapper" class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </div>
        <div>
            <p id="mrToastTitle" class="text-xs font-bold text-white m-0">Thành công</p>
            <p id="mrToastMessage" class="text-[11px] text-slate-300 mt-0.5 m-0">Hồ sơ đã được cập nhật.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var toastTimer = null;
        function showToast(title, message, isSuccess = true) {
            var toast = document.getElementById('medicalRecordsToast');
            var titleEl = document.getElementById('mrToastTitle');
            var msgEl = document.getElementById('mrToastMessage');
            var iconWrap = document.getElementById('mrToastIconWrapper');

            titleEl.textContent = title;
            msgEl.textContent = message;

            if (isSuccess) {
                iconWrap.className = "w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0";
                iconWrap.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span>';
            } else {
                iconWrap.className = "w-7 h-7 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center flex-shrink-0";
                iconWrap.innerHTML = '<span class="material-symbols-outlined text-[18px]">info</span>';
            }

            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function () {
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 3500);
        }

        // Tải tệp đính kèm
        function downloadAttachment(fileName) {
            showToast("Đang tải tệp cận lâm sàng", "Đang khởi tạo tải xuống: " + fileName, true);
        }

        // Xem ảnh / tệp
        function previewFile(fileName, type) {
            showToast("Xem tệp cận lâm sàng", "Đang mở trình xem bảo mật: " + fileName + " (" + type + ")", false);
        }

        // Xem chi tiết đơn thuốc
        function viewPrescriptionDetails(date, medicines) {
            document.getElementById('modalPrescriptionDate').textContent = "Đợt khám: " + date;
            var modal = document.getElementById('prescriptionModal');
            var card = document.getElementById('prescriptionModalCard');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100');
            card.classList.remove('scale-95');
            card.classList.add('scale-100');
        }

        function closePrescriptionModal() {
            var modal = document.getElementById('prescriptionModal');
            var card = document.getElementById('prescriptionModalCard');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.classList.remove('opacity-100');
            card.classList.add('scale-95');
            card.classList.remove('scale-100');
        }

        // Cấu hình Avatar cho thành viên
        var avatarMap = {
            'all': '<span class="material-symbols-outlined text-[13px] leading-none">groups</span>',
            'khang': 'K',
            'dat': 'Đ',
            'ha': 'H',
            'an': 'A'
        };

        var currentSpecialty = 'all';

        // Bộ lọc kết hợp đa tiêu chí (Thành viên + Thời gian + Loại hồ sơ + Chuyên khoa)
        function applyCombinedFilters() {
            var selectedMember = document.getElementById('patientSelector').value;
            var selectedType = document.getElementById('recordTypeFilter').value;
            var count = 0;

            document.querySelectorAll('.encounter-item').forEach(function (item) {
                var itemMember = item.getAttribute('data-member');
                var itemType = item.getAttribute('data-type');
                var itemSpecialty = item.getAttribute('data-specialty');

                var matchMember = (selectedMember === 'all' || itemMember === selectedMember);
                var matchType = (selectedType === 'all' || itemType === selectedType);
                var matchSpecialty = (currentSpecialty === 'all' || itemSpecialty === currentSpecialty || itemType === currentSpecialty);

                if (matchMember && matchType && matchSpecialty) {
                    item.style.display = '';
                    count++;
                } else {
                    item.style.display = 'none';
                }
            });

            document.getElementById('encounterCountBadge').textContent = count + " đợt khám";
        }

        // Sự kiện khi đổi Thành viên
        document.getElementById('patientSelector').addEventListener('change', function () {
            var selectedMember = this.value;
            var badge = document.getElementById('patientAvatarBadge');
            if (badge) {
                badge.innerHTML = avatarMap[selectedMember] || 'K';
            }
            applyCombinedFilters();
            showToast("Đã lọc bệnh án", "Hiển thị đợt khám của thành viên đã chọn", false);
        });

        // Sự kiện khi đổi Loại hồ sơ
        document.getElementById('recordTypeFilter').addEventListener('change', function () {
            applyCombinedFilters();
            showToast("Đã lọc loại bệnh án", "Đang cập nhật danh sách hồ sơ theo phân loại", false);
        });

        // Sự kiện khi đổi Khoảng thời gian
        document.getElementById('timeRangeFilter').addEventListener('change', function () {
            showToast("Đã lọc thời gian", "Đang tải dữ liệu hồ sơ theo mốc thời gian đã chọn", false);
        });

        // Sự kiện Tab lọc Chuyên khoa
        function filterSpecialty(specialtyKey, btn) {
            currentSpecialty = specialtyKey;
            document.querySelectorAll('.specialty-tab-btn').forEach(function (b) {
                b.className = "specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-slate-100 text-slate-600 hover:text-slate-900 hover:bg-slate-200 border-0 transition-colors cursor-pointer whitespace-nowrap";
            });
            btn.className = "specialty-tab-btn px-3 py-1.5 rounded-lg font-label-md text-xs bg-[#0284C7] text-white shadow-xs font-semibold border-0 cursor-pointer whitespace-nowrap transition-all";

            applyCombinedFilters();
        }

        // Đặt lại toàn bộ bộ lọc
        function resetAllFilters() {
            document.getElementById('patientSelector').value = 'all';
            var badge = document.getElementById('patientAvatarBadge');
            if (badge) {
                badge.innerHTML = avatarMap['all'];
            }
            document.getElementById('timeRangeFilter').value = 'all';
            document.getElementById('recordTypeFilter').value = 'all';

            var firstTab = document.querySelector('.specialty-tab-btn');
            if (firstTab) {
                filterSpecialty('all', firstTab);
            } else {
                currentSpecialty = 'all';
                applyCombinedFilters();
            }
            showToast("Đã đặt lại bộ lọc", "Hiển thị tất cả hồ sơ bệnh án gia đình", false);
        }

        // Nút thêm đợt khám mới
        document.getElementById('btnAddNewEncounter').addEventListener('click', function () {
            showToast("Thêm đợt khám", "Đang mở biểu mẫu nhập đợt khám bệnh mới...", false);
        });

        // Xuất toàn bộ hồ sơ y bạ PDF
        document.getElementById('btnExportFullRecord').addEventListener('click', function () {
            showToast("Xuất hồ sơ y bạ", "Toàn bộ dữ liệu bệnh án điện tử đang được đóng gói định dạng PDF...");
        });
    </script>
}
