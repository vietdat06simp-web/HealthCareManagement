@{
    ViewData["Title"] = "Nhắc Uống Thuốc & Lịch Tái Khám";
    var activeTab = (ViewBag.ActiveTab as string) ?? "medications";
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed": "#001f26",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed": "#002113",
                        "on-tertiary-container": "#f5fff6",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/medications-appointments.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-5 pb-8">
    <!-- 1. TOP BREADCRUMB & REALTIME SYNC BADGE -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-600 font-medium">Kế hoạch điều trị</span>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Lịch uống thuốc &amp; Hẹn tái khám</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-tertiary font-label-sm shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-tertiary"></span>
            </span>
            <span class="font-semibold text-slate-800">Đồng bộ chuông thông báo đẩy 24/7</span>
            <span class="text-[11px] px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 font-bold uppercase tracking-wider">BẬT (Zalo &amp; SMS)</span>
        </div>
    </div>

    <!-- 2. PAGE HEADER BANNER & PRIMARY ACTION BUTTONS -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-5 md:p-6 rounded-2xl bg-white shadow-sm border border-slate-200/90">
        <div class="flex items-start gap-4">
            <div class="w-13 h-13 rounded-2xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-sky-600/20 shrink-0 p-2.5">
                <span class="material-symbols-outlined text-[32px]">medication</span>
            </div>
            <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="font-headline-md text-slate-900 tracking-tight m-0 text-xl md:text-2xl font-bold">
                        LỊCH NHẮC UỐNG THUỐC &amp; TÁI KHÁM
                    </h1>
                    <span class="px-2.5 py-0.5 rounded-full bg-cyan-50 text-cyan-700 font-label-sm font-semibold border border-cyan-200">
                        Hôm nay: Thứ Năm, 15/10/2026
                    </span>
                </div>
                <p class="font-body-md text-slate-500 mt-1 mb-0">
                    Quản lý cữ thuốc hàng ngày và theo dõi chính xác các mốc tái khám, tiêm chủng định kỳ cho cả gia đình.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap shrink-0">
            <button onclick="openModal('addPrescriptionModal')" class="btn-action-primary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white font-label-md shadow-sm hover:bg-primary-container transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                <span>+ Thêm đơn thuốc mới</span>
            </button>
            <button onclick="openModal('addAppointmentModal')" class="btn-action-secondary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary text-white font-label-md shadow-sm hover:bg-cyan-800 transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">calendar_add_on</span>
                <span>+ Đặt lịch tái khám</span>
            </button>
            <button onclick="toggleFilterDrawer()" aria-label="Bộ lọc thành viên" class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 hover:text-primary hover:bg-slate-200 transition-colors border-0 cursor-pointer" title="Lọc thành viên">
                <span class="material-symbols-outlined text-[20px]">tune</span>
            </button>
        </div>
    </div>

    <!-- 3. TAB CONTROLS & FILTER BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface-container-low p-2 md:p-2.5 rounded-2xl border border-slate-200">
        <!-- Switch Tabs -->
        <div class="inline-flex items-center bg-slate-200/80 p-1 rounded-xl gap-1">
            <button id="tabBtnMedications" onclick="switchViewTab('medications')" class="view-tab-btn @(activeTab == "medications" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">pill</span>
                <span class="font-semibold">Lịch uống thuốc hôm nay</span>
                <span id="pendingDoseBadge" class="px-2 py-0.2 rounded-full bg-amber-100 text-amber-800 font-bold text-xs">3 cữ còn</span>
            </button>
            <button id="tabBtnAppointments" onclick="switchViewTab('appointments')" class="view-tab-btn @(activeTab == "appointments" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">event_upcoming</span>
                <span class="font-semibold">Lịch hẹn tái khám sắp tới</span>
                <span class="px-2 py-0.2 rounded-full bg-cyan-100 text-cyan-800 font-bold text-xs">3 lịch</span>
            </button>
        </div>

        <!-- Member Quick Filter -->
        <div class="flex items-center gap-2 px-2 overflow-x-auto">
            <span class="font-label-sm text-slate-500 uppercase tracking-wider shrink-0">Thành viên:</span>
            <div class="flex items-center gap-1.5">
                <button onclick="filterByMember('all')" class="member-filter-chip active px-3 py-1 rounded-full text-xs font-semibold bg-white text-primary border border-primary shadow-xs cursor-pointer">
                    Tất cả (3)
                </button>
                <button onclick="filterByMember('Khang')" class="member-filter-chip px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-slate-300 cursor-pointer">
                    Ông Khang (Cao tuổi)
                </button>
                <button onclick="filterByMember('Hà')" class="member-filter-chip px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-slate-300 cursor-pointer">
                    Chị Hà (Mẹ)
                </button>
                <button onclick="filterByMember('An')" class="member-filter-chip px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-slate-300 cursor-pointer">
                    Bé An (Trẻ em)
                </button>
            </div>
        </div>
    </div>

    <!-- 4. TAB CONTENT 1: LỊCH UỐNG THUỐC HÔM NAY -->
    <div id="tabContentMedications" class="@(activeTab == "medications" ? "block" : "hidden") space-y-6">
        <!-- Dose Progress Bar & Overview -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-100 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">alarm_on</span>
                </div>
                <div>
                    <div class="font-headline-sm text-slate-900 text-base md:text-lg font-bold">CÁC CỮ THUỐC TRONG NGÀY HÔM NAY</div>
                    <div class="font-label-md text-slate-500">Chia rõ 3 khung giờ: Sáng (07:00 - 08:00), Trưa (11:30 - 12:30), Tối (20:00)</div>
                </div>
            </div>

            <!-- Progress Metric -->
            <div class="flex items-center gap-4 bg-surface-container-low px-4 py-2.5 rounded-xl border border-slate-200/60 self-start lg:self-auto">
                <div class="flex flex-col text-right">
                    <span class="font-label-sm text-slate-500">Tiến độ cữ thuốc hôm nay</span>
                    <span id="doseProgressText" class="font-title-md text-tertiary font-bold">Đã uống 3/6 liều</span>
                </div>
                <div class="w-32 sm:w-40 h-3 bg-slate-200 rounded-full overflow-hidden">
                    <div id="doseProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full transition-all duration-500" style="width: 50%;"></div>
                </div>
                <span id="doseProgressPercent" class="font-metric-num text-sm text-primary font-bold">50%</span>
            </div>
        </div>

        <!-- 3 Dose Blocks Grid: Sáng (07:00 / 08:00), Trưa (11:30 / 12:30), Tối (20:00) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <!-- CỬ SÁNG (07:00 - 08:00) -->
            <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between" data-dose-slot="morning">
                <div>
                    <!-- Block Header -->
                    <div class="flex items-center justify-between pb-3 mb-4 bg-amber-50/80 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-amber-100">
                        <div class="flex items-center gap-2 text-amber-700">
                            <span class="material-symbols-outlined text-[26px]">wb_sunny</span>
                            <div>
                                <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ SÁNG</span>
                                <span class="font-label-sm text-amber-800 font-medium">07:00 - 08:00 Sáng</span>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm font-semibold text-xs border border-emerald-200">
                            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                            Đã hoàn thành
                        </span>
                    </div>

                    <!-- Dose Items -->
                    <div class="flex flex-col gap-3">
                        <!-- Item 1: Amoxicillin -->
                        <div class="dose-item completed p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="Hà">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">Amoxicillin 500mg</h4>
                                    <span class="font-label-sm text-slate-600 font-medium">1 viên • Thành viên: <strong class="text-slate-800">Lê Thu Hà (Mẹ)</strong></span>
                                </div>
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-tertiary text-white text-[14px] shrink-0">
                                    <span class="material-symbols-outlined text-[16px]">check</span>
                                </span>
                            </div>
                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                “Uống sau ăn no 30 phút, uống với nhiều nước lọc”
                            </p>
                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                <span>Đã uống lúc 08:25</span>
                            </div>
                        </div>

                        <!-- Item 2: Amlodipine -->
                        <div class="dose-item completed p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="Khang">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">Amlodipine 5mg</h4>
                                    <span class="font-label-sm text-slate-600 font-medium">1 viên • Thành viên: <strong class="text-slate-800">Trần Quốc Khang (Ông nội)</strong></span>
                                </div>
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-tertiary text-white text-[14px] shrink-0">
                                    <span class="material-symbols-outlined text-[16px]">check</span>
                                </span>
                            </div>
                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                “Uống cố định sau ăn sáng, đo huyết áp trước khi uống”
                            </p>
                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                <span>Đã uống lúc 08:05 (HA: 122/80)</span>
                            </div>
                        </div>

                        <!-- Item 3: Vitamin D3 -->
                        <div class="dose-item completed p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="An">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">Vitamin D3 &amp; Canxi</h4>
                                    <span class="font-label-sm text-slate-600 font-medium">1 giọt • Thành viên: <strong class="text-slate-800">Trần Bảo An (Con trai)</strong></span>
                                </div>
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-tertiary text-white text-[14px] shrink-0">
                                    <span class="material-symbols-outlined text-[16px]">check</span>
                                </span>
                            </div>
                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                “Uống sau bữa ăn sáng 15 phút cùng sữa ấm”
                            </p>
                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                <span>Đã uống lúc 08:40</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 text-center">
                    <span class="font-label-sm text-emerald-700 flex items-center justify-center gap-1 font-semibold text-xs">
                        <span class="material-symbols-outlined text-[16px]">verified</span>
                        Cả 3 thành viên đã hoàn tất cữ sáng
                    </span>
                </div>
            </div>

            <!-- CỬ TRƯA (11:30 - 12:30) -->
            <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between border-2 border-sky-300" data-dose-slot="noon">
                <div>
                    <!-- Block Header -->
                    <div class="flex items-center justify-between pb-3 mb-4 bg-sky-50 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-sky-100">
                        <div class="flex items-center gap-2 text-sky-700">
                            <span class="material-symbols-outlined text-[26px]">light_mode</span>
                            <div>
                                <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ TRƯA</span>
                                <span class="font-label-sm text-sky-800 font-medium">11:30 - 12:30 Trưa</span>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm font-semibold text-xs border border-amber-200">
                            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                            Đang chờ xác nhận
                        </span>
                    </div>

                    <!-- Dose Items -->
                    <div class="flex flex-col gap-3">
                        <!-- Item 1: Metformin -->
                        <div id="doseItemMetformin" class="dose-item p-3.5 rounded-xl bg-sky-50/60 border border-sky-200 flex flex-col gap-2" data-member="Khang">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">Metformin 850mg</h4>
                                    <span class="font-label-sm text-slate-600 font-medium">1 viên • Thành viên: <strong class="text-slate-800">Trần Quốc Khang (Ông nội)</strong></span>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded bg-sky-100 text-sky-800 font-label-sm text-xs font-semibold">Tiểu đường T2</span>
                            </div>
                            <p class="font-body-sm text-slate-700 italic m-0 bg-white p-2 rounded-lg border border-sky-100">
                                “Uống ngay trong hoặc ngay sau bữa ăn trưa”
                            </p>
                            <div id="actionMetformin">
                                <button onclick="markDoseTaken('doseItemMetformin', 'actionMetformin', 'Metformin 850mg', 'Ông Trần Quốc Khang')" class="mt-1 w-full py-2.5 px-3 rounded-xl bg-primary text-white font-label-md flex items-center justify-center gap-1.5 hover:bg-primary-container transition-all shadow-sm cursor-pointer border-0">
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                    <span class="font-semibold">Xác nhận đã uống</span>
                                </button>
                            </div>
                        </div>

                        <!-- Item 2: Panadol Extra -->
                        <div id="doseItemPanadol" class="dose-item p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col gap-2" data-member="Hà">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">Panadol Extra 500mg</h4>
                                    <span class="font-label-sm text-slate-600 font-medium">1 viên • Thành viên: <strong class="text-slate-800">Lê Thu Hà (Mẹ)</strong></span>
                                </div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-200 text-slate-700 font-label-sm text-xs">Uống khi cần</span>
                            </div>
                            <p class="font-body-sm text-slate-600 italic m-0 bg-white p-2 rounded-lg border border-slate-100">
                                “Uống sau ăn trưa khi đau đầu, cách cữ sáng tối thiểu 4 tiếng”
                            </p>
                            <div id="actionPanadol" class="flex items-center gap-2 mt-1">
                                <button onclick="markDoseTaken('doseItemPanadol', 'actionPanadol', 'Panadol Extra 500mg', 'Chị Lê Thu Hà')" class="flex-1 py-2 px-3 rounded-lg bg-secondary text-white font-label-md flex items-center justify-center gap-1 hover:bg-cyan-800 transition-colors cursor-pointer border-0 text-xs font-semibold">
                                    <span class="material-symbols-outlined text-[16px]">add_task</span>
                                    <span>Uống liều này</span>
                                </button>
                                <button onclick="skipDose('doseItemPanadol', 'actionPanadol')" class="px-3 py-2 rounded-lg bg-slate-200 text-slate-700 font-label-sm text-xs hover:bg-slate-300 transition-colors border-0 cursor-pointer">
                                    Bỏ qua
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 text-center">
                    <span class="font-label-sm text-slate-500 flex items-center justify-center gap-1 font-medium text-xs">
                        <span class="material-symbols-outlined text-[16px] text-primary">notifications_active</span>
                        Nhắc nhở cữ trưa sẽ tự động rung chuông và gửi tin Zalo
                    </span>
                </div>
            </div>

            <!-- CỬ TỐI (20:00) -->
            <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between" data-dose-slot="evening">
                <div>
                    <!-- Block Header -->
                    <div class="flex items-center justify-between pb-3 mb-4 bg-indigo-50 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-indigo-100">
                        <div class="flex items-center gap-2 text-indigo-700">
                            <span class="material-symbols-outlined text-[26px]">dark_mode</span>
                            <div>
                                <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ TỐI</span>
                                <span class="font-label-sm text-indigo-800 font-medium">20:00 Tối</span>
                            </div>
                        </div>
