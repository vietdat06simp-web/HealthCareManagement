                            {
                                var initials = !string.IsNullOrWhiteSpace(apt.Member?.FullName)
                                    ? string.Join("", apt.Member.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper()
                                    : "TV";
                                if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);

                                <tr class="appointment-row hover:bg-slate-50/70 transition-colors" data-member="@(apt.Member?.FullName ?? "")">
                                    <td class="py-4 px-4 align-top whitespace-nowrap">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-11 h-11 rounded-xl bg-sky-50 border border-sky-100 flex flex-col items-center justify-center text-primary font-metric-num shrink-0">
                                                <span class="font-bold text-[15px] leading-tight">@apt.AppointmentDateTime.ToString("dd")</span>
                                                <span class="text-[10px] uppercase font-bold text-slate-500">Th@apt.AppointmentDateTime.ToString("MM")</span>
                                            </div>
                                            <div class="flex flex-col">
                                                <span class="font-title-md text-slate-900 font-bold text-sm">@apt.AppointmentDateTime.ToString("dd/MM/yyyy")</span>
                                                <span class="font-label-sm text-cyan-800 font-semibold text-xs">@apt.AppointmentDateTime.ToString("HH:mm")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold text-xs shrink-0">
                                                @initials
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-title-md text-slate-900 font-semibold text-sm truncate">@(apt.Member?.FullName ?? "Thành viên")</span>
                                                <span class="font-label-sm text-slate-500 text-xs">@(apt.Member?.Relationship ?? "")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex flex-col">
                                            <span class="font-label-lg text-slate-900 font-bold text-sm">@apt.Location</span>
                                            @if (!string.IsNullOrEmpty(apt.AppointmentType))
                                            {
                                                <span class="font-body-sm text-slate-500 flex items-center gap-1 text-xs mt-0.5">
                                                    <span class="material-symbols-outlined text-[15px] text-rose-500">pin_drop</span>
                                                    @apt.AppointmentType
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex flex-col">
                                            <span class="font-label-lg text-slate-900 font-bold text-sm">@(string.IsNullOrEmpty(apt.DoctorName) ? "Bác sĩ phụ trách" : apt.DoctorName)</span>
                                            @if (!string.IsNullOrEmpty(apt.Title))
                                            {
                                                <span class="inline-flex items-center gap-1 font-label-sm text-primary text-xs mt-0.5 font-semibold">
                                                    <span class="material-symbols-outlined text-[15px]">medical_services</span>
                                                    @apt.Title
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        @if (!string.IsNullOrEmpty(apt.PreparationNotes))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm font-semibold text-xs">
                                                <span class="material-symbols-outlined text-[14px]">info</span>
                                                @apt.PreparationNotes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">Không có ghi chú dặn dò</span>
                                        }
                                    </td>
                                    <td class="py-4 px-4 align-top text-right whitespace-nowrap">
                                        <div class="flex flex-col items-end gap-2">
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-[#0284C7] font-label-sm font-bold text-xs border border-sky-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                                @(apt.Status ?? "Đã đặt lịch")
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400 font-medium">Chưa có lịch hẹn tái khám sắp tới</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: KÊ ĐƠN THUỐC MỚI VÀ CHIA CỮ UỐNG HÀNG NGÀY                         -->
<!-- ========================================================================= -->
<div id="addPrescriptionModal" class="fixed inset-0 z-50 hidden bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-2xl modal-fade-in border border-slate-100 my-8">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-sky-100 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">prescriptions</span>
                </div>
                <div>
                    <h3 class="font-headline-sm text-slate-900 text-lg font-bold m-0">+ Kê Đơn Thuốc Mới</h3>
                    <p class="text-xs text-slate-500 m-0">Tự động lập lịch nhắc nhở 4 cữ uống hàng ngày trong suốt thời gian điều trị</p>
                </div>
            </div>
            <button onclick="closeModal('addPrescriptionModal')" class="text-slate-400 hover:text-slate-600 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[22px]">close</span>
            </button>
        </div>

        <form asp-action="Create" asp-controller="Prescriptions" method="post" id="createPrescriptionForm" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()

            <!-- 1. THÀNH VIÊN VÀ TÊN ĐƠN THUỐC -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Thành viên dùng thuốc *</label>
                    <select name="MemberId" required class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none bg-white">
                        @if (Model?.Members != null && Model.Members.Any())
                        {
                            foreach (var member in Model.Members)
                            {
                                <option value="@member.Id">@member.FullName (@member.Relationship)</option>
                            }
                        }
                        else
                        {
                            <option value="">Chưa có thành viên nào</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Tên đơn thuốc *</label>
                    <input type="text" name="PrescriptionName" required placeholder="Ví dụ: Đơn thuốc Điều trị Cao huyết áp &amp; Dạ dày" class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none" />
                </div>
            </div>

            <!-- 2. BÁC SĨ & BỆNH ÁN LIÊN KẾT -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Bác sĩ kê đơn</label>
                    <input type="text" name="DoctorName" placeholder="Ví dụ: BS. CKII Nguyễn Văn Hùng" class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none" />
                </div>
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Bệnh án liên kết (nếu có)</label>
                    <select name="MedicalRecordId" class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none bg-white">
                        <option value="">-- Không liên kết bệnh án --</option>
                        @if (Model?.MedicalRecords != null)
                        {
                            foreach (var rec in Model.MedicalRecords)
                            {
                                <option value="@rec.Id">@rec.ExamDate.ToString("dd/MM/yyyy") - @rec.HospitalName (@rec.Diagnosis)</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- 3. THỜI GIAN ĐIỀU TRỊ -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Ngày bắt đầu *</label>
                    <input type="date" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none" />
                </div>
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1 text-xs">Ngày kết thúc *</label>
                    <input type="date" name="EndDate" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required class="w-full h-10 px-3 rounded-xl border border-slate-300 focus:border-primary text-xs outline-none" />
                </div>
            </div>

            <!-- 4. DANH SÁCH THUỐC & PHÂN CHIA 4 CỮ UỐNG -->
            <div class="pt-2 border-t border-slate-100">
                <div class="flex items-center justify-between mb-2">
                    <label class="font-label-sm text-slate-800 font-bold text-xs uppercase tracking-wider">
                        Danh sách thuốc &amp; Cữ uống trong ngày:
                    </label>
                    <button type="button" onclick="addDrugItemRow()" class="px-2.5 py-1 rounded-lg bg-sky-50 text-primary hover:bg-sky-100 border border-sky-200 text-xs font-semibold flex items-center gap-1 cursor-pointer">
                        <span class="material-symbols-outlined text-[15px]">add</span>
                        <span>+ Thêm thuốc</span>
                    </button>
                </div>

                <div id="drugItemsList" class="space-y-3">
                    <!-- Thuốc #1 -->
                    <div class="drug-item-card p-3.5 rounded-xl bg-slate-50 border border-slate-200 relative">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div>
                                <label class="block text-slate-600 font-semibold text-[11px] mb-1">Tên thuốc &amp; Hàm lượng *</label>
                                <input type="text" name="Drugs[0].DrugName" required placeholder="Ví dụ: Amlodipine 5mg, Augmentin 1g" class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-slate-600 font-semibold text-[11px] mb-1">Liều lượng mỗi lần *</label>
                                    <input type="text" name="Drugs[0].Dosage" value="1 viên" required placeholder="1 viên, 5ml" class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                                </div>
                                <div>
                                    <label class="block text-slate-600 font-semibold text-[11px] mb-1">Cách dùng *</label>
                                    <input type="text" name="Drugs[0].MealTiming" value="Sau ăn 30 phút" placeholder="Sau ăn no, Trước ăn" class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-2.5">
                            <label class="block text-slate-600 font-semibold text-[11px] mb-1">Các cữ uống trong ngày (Chọn ít nhất 1 cữ):</label>
                            <div class="flex items-center gap-3 flex-wrap">
                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-amber-400">
                                    <input type="checkbox" name="Drugs[0].Morning" value="true" checked class="rounded text-primary focus:ring-primary" />
                                    <span>Sáng (08:00)</span>
                                </label>
                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-sky-400">
                                    <input type="checkbox" name="Drugs[0].Noon" value="true" class="rounded text-primary focus:ring-primary" />
                                    <span>Trưa (12:00)</span>
                                </label>
                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-orange-400">
                                    <input type="checkbox" name="Drugs[0].Afternoon" value="true" class="rounded text-primary focus:ring-primary" />
                                    <span>Chiều (17:30)</span>
                                </label>
                                <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-indigo-400">
                                    <input type="checkbox" name="Drugs[0].Evening" value="true" checked class="rounded text-primary focus:ring-primary" />
                                    <span>Tối (20:30)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeModal('addPrescriptionModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-label-md hover:bg-slate-200 transition-colors border-0 cursor-pointer text-xs font-semibold">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-white font-label-md hover:bg-primary-container transition-colors border-0 cursor-pointer text-xs font-semibold shadow-sm flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[17px]">save</span>
                    <span>Lưu đơn thuốc &amp; Tạo lịch nhắc</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Floating Toast Container -->
<div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

@section Scripts {
    <script>
        // Tab switching logic
        function switchViewTab(tab) {
            const tabs = ['medications', 'prescriptions', 'appointments'];
            tabs.forEach(t => {
                const btn = document.getElementById(`tabBtn${t.charAt(0).toUpperCase() + t.slice(1)}`);
                const content = document.getElementById(`tabContent${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (t === tab) {
                    if (btn) btn.classList.add('active');
                    if (content) {
                        content.classList.remove('hidden');
                        content.classList.add('block');
                    }
                } else {
                    if (btn) btn.classList.remove('active');
                    if (content) {
                        content.classList.add('hidden');
                        content.classList.remove('block');
                    }
                }
            });
        }

        // Member filtering logic
        function filterByMember(member) {
            const chips = document.querySelectorAll('.member-filter-chip');
            chips.forEach(chip => {
                chip.classList.remove('active', 'border-primary', 'text-primary', 'shadow-xs');
                chip.classList.add('border-slate-200', 'text-slate-600');
            });
            if (event && event.currentTarget) {
                event.currentTarget.classList.add('active', 'border-primary', 'text-primary', 'shadow-xs');
                event.currentTarget.classList.remove('border-slate-200', 'text-slate-600');
            }

            // Filter doses
            const doseItems = document.querySelectorAll('.dose-item');
            doseItems.forEach(item => {
                const itemMember = item.getAttribute('data-member');
                if (member === 'all' || itemMember === member) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });

            // Filter appointment rows
            const appRows = document.querySelectorAll('.appointment-row');
            appRows.forEach(row => {
                const rowMember = row.getAttribute('data-member');
                if (member === 'all' || rowMember === member) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            showToast(`Đã lọc danh sách cho: ${member === 'all' ? 'Tất cả thành viên' : member}`);
        }

        // AJAX POST to MarkAsTaken
        async function toggleMarkAsTaken(scheduleId, medName, memberName, isUndo = false) {
            const btn = document.getElementById(`btn-taken-${scheduleId}`);
            const item = document.getElementById(`schedule-item-${scheduleId}`);
            const title = document.getElementById(`schedule-title-${scheduleId}`);
            const statusContainer = document.getElementById(`status-container-${scheduleId}`);

            if (btn) btn.disabled = true;

            try {
                const toggleQuery = isUndo ? '?toggle=true' : '';
                const response = await fetch(`/Prescriptions/MarkAsTaken/${scheduleId}${toggleQuery}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    throw new Error('Không thể kết nối máy chủ để cập nhật lịch.');
                }

                const data = await response.json();
                if (data.success) {
                    if (data.isTaken) {
                        if (item) {
                            item.classList.add('completed', 'bg-slate-50', 'border-emerald-200', 'opacity-90');
                            item.classList.remove('bg-white', 'border-slate-200', 'shadow-2xs');
                        }
                        if (title) {
                            title.classList.add('line-through', 'text-slate-400');
                        }
                        if (btn) {
                            btn.classList.add('bg-emerald-600', 'text-white');
                            btn.classList.remove('bg-slate-100', 'text-slate-500');
                            btn.title = "Bấm để chuyển về chưa uống";
                            btn.innerHTML = '<span class="material-symbols-outlined text-[17px]">check_circle</span>';
                        }
                        if (statusContainer) {
                            statusContainer.innerHTML = `
                                <div class="w-full py-1 px-2 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-between text-[11px] font-semibold border border-emerald-100">
                                    <span class="flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[14px]">done_all</span>
                                        <span>Đã uống ${data.takenAt || 'vừa xong'}</span>
                                    </span>
                                    <span class="text-[10px] text-emerald-600 underline cursor-pointer hover:text-emerald-800" onclick="toggleMarkAsTaken(${scheduleId}, '', '', true)">Hoàn tác</span>
                                </div>
                            `;
                        }
                        showToast(`Đã ghi nhận uống "${medName || 'thuốc'}" cho ${memberName || 'thành viên'}!`, 'success');
                    } else {
                        if (item) {
                            item.classList.remove('completed', 'bg-slate-50', 'border-emerald-200', 'opacity-90');
                            item.classList.add('bg-white', 'border-slate-200', 'shadow-2xs');
                        }
                        if (title) {
                            title.classList.remove('line-through', 'text-slate-400');
                        }
                        if (btn) {
                            btn.classList.remove('bg-emerald-600', 'text-white');
                            btn.classList.add('bg-slate-100', 'text-slate-500');
                            btn.title = "Bấm để đánh dấu ĐÃ UỐNG";
                            btn.innerHTML = '<span class="material-symbols-outlined text-[17px]">radio_button_unchecked</span>';
                        }
                        if (statusContainer) {
                            statusContainer.innerHTML = `
                                <button type="button" 
                                        onclick="toggleMarkAsTaken(${scheduleId}, '${medName}', '${memberName}')"
                                        class="w-full py-1.5 px-2 rounded-lg bg-sky-50 hover:bg-sky-100 text-primary font-label-md flex items-center justify-center gap-1 text-xs font-bold border border-sky-200 transition-colors cursor-pointer">
                                    <span class="material-symbols-outlined text-[15px]">check</span>
                                    <span>Xác nhận đã uống</span>
                                </button>
                            `;
                        }
                        showToast('Đã chuyển trạng thái cữ thuốc về chưa uống.', 'info');
                    }

                    recalculateProgress();
                } else {
                    showToast(data.message || 'Không thể cập nhật cữ thuốc.', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Lỗi đường truyền hoặc máy chủ khi cập nhật.', 'error');
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        // Dynamic progress calculation
        function recalculateProgress() {
            const allDoses = document.querySelectorAll('.dose-item');
            const completedDoses = document.querySelectorAll('.dose-item.completed');
            const total = allDoses.length;
            const taken = completedDoses.length;
            const pct = total > 0 ? Math.round((taken / total) * 100) : 0;

            const progressBar = document.getElementById('doseProgressBar');
            const progressText = document.getElementById('doseProgressText');
            const progressPercentEl = document.getElementById('doseProgressPercent');
            const badge = document.getElementById('pendingDoseBadge');

            if (progressBar) progressBar.style.width = `${pct}%`;
            if (progressText) progressText.innerText = `Đã uống ${taken}/${total} liều`;
            if (progressPercentEl) progressPercentEl.innerText = `${pct}%`;
            if (badge) badge.innerText = `${total - taken} cữ còn`;
        }

        // Dynamic drug item addition in create modal
        let drugIndex = 1;
        function addDrugItemRow() {
            const container = document.getElementById('drugItemsList');
            if (!container) return;

            const row = document.createElement('div');
            row.className = 'drug-item-card p-3.5 rounded-xl bg-slate-50 border border-slate-200 relative';
            row.innerHTML = `
                <button type="button" onclick="this.closest('.drug-item-card').remove()" class="absolute top-2 right-2 text-rose-400 hover:text-rose-600 border-0 bg-transparent cursor-pointer" title="Xóa thuốc này">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    <div>
                        <label class="block text-slate-600 font-semibold text-[11px] mb-1">Tên thuốc &amp; Hàm lượng *</label>
                        <input type="text" name="Drugs[${drugIndex}].DrugName" required placeholder="Ví dụ: Metformin 500mg, Panadol..." class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-600 font-semibold text-[11px] mb-1">Liều lượng mỗi lần *</label>
                            <input type="text" name="Drugs[${drugIndex}].Dosage" value="1 viên" required placeholder="1 viên, 5ml" class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                        </div>
                        <div>
                            <label class="block text-slate-600 font-semibold text-[11px] mb-1">Cách dùng *</label>
                            <input type="text" name="Drugs[${drugIndex}].MealTiming" value="Sau ăn 30 phút" placeholder="Sau ăn, Trước ăn" class="w-full h-9 px-3 rounded-lg border border-slate-300 focus:border-primary text-xs outline-none bg-white" />
                        </div>
                    </div>
                </div>

                <div class="mt-2.5">
                    <label class="block text-slate-600 font-semibold text-[11px] mb-1">Các cữ uống trong ngày:</label>
                    <div class="flex items-center gap-3 flex-wrap">
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-amber-400">
                            <input type="checkbox" name="Drugs[${drugIndex}].Morning" value="true" checked class="rounded text-primary focus:ring-primary" />
                            <span>Sáng (08:00)</span>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-sky-400">
                            <input type="checkbox" name="Drugs[${drugIndex}].Noon" value="true" class="rounded text-primary focus:ring-primary" />
                            <span>Trưa (12:00)</span>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-orange-400">
                            <input type="checkbox" name="Drugs[${drugIndex}].Afternoon" value="true" class="rounded text-primary focus:ring-primary" />
                            <span>Chiều (17:30)</span>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer bg-white px-2.5 py-1 rounded-lg border border-slate-200 hover:border-indigo-400">
                            <input type="checkbox" name="Drugs[${drugIndex}].Evening" value="true" checked class="rounded text-primary focus:ring-primary" />
                            <span>Tối (20:30)</span>
                        </label>
                    </div>
                </div>
            `;
            container.appendChild(row);
            drugIndex++;
        }

        // Modal helpers
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Toast notification system
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto p-3.5 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2.5 transition-all transform translate-y-4 opacity-0 ${
                type === 'success' 
                    ? 'bg-emerald-900 text-white border-emerald-700' 
                    : type === 'error'
                    ? 'bg-rose-900 text-white border-rose-700'
                    : 'bg-slate-900 text-white border-slate-700'
            }`;

            const iconName = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
            toast.innerHTML = `
                <span class="material-symbols-outlined text-[18px] text-teal-400">${iconName}</span>
                <span class="flex-1">${message}</span>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Initialize active tab from query param if provided
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                switchViewTab(tabParam);
            }
        });
    </script>
}
