@model HealthCareManagement.Web.Models.ViewModels.PrescriptionsIndexViewModel
@{
    ViewData["Title"] = "Nhắc Uống Thuốc & Kế Hoạch Điều Trị";
    var activeTab = (ViewBag.ActiveTab as string) ?? Model?.ActiveTab ?? "medications";
    var today = DateTime.Today;
    var viCulture = new System.Globalization.CultureInfo("vi-VN");
    var todayFormatted = today.ToString("dddd, dd/MM/yyyy", viCulture);

    var morningDoses = Model?.MorningSchedules ?? new();
    var noonDoses = Model?.NoonSchedules ?? new();
    var afternoonDoses = Model?.AfternoonSchedules ?? new();
    var eveningDoses = Model?.EveningSchedules ?? new();

    var totalToday = Model?.TodaySchedules?.Count ?? 0;
    var takenToday = Model?.TodaySchedules?.Count(s => s.IsTaken) ?? 0;
    var progressPercent = totalToday > 0 ? (int)Math.Round((double)takenToday / totalToday * 100) : 0;
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed": "#001f26",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed": "#002113",
                        "on-tertiary-container": "#f5fff6",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/medications-appointments.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-5 pb-8">
    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600">check_circle</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-rose-600">error</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
    }

    <!-- 1. TOP BREADCRUMB & REALTIME SYNC BADGE -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-600 font-medium">Kế hoạch điều trị</span>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Đơn thuốc &amp; Nhắc uống thuốc</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-tertiary font-label-sm shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-tertiary"></span>
            </span>
            <span class="font-semibold text-slate-800">Đồng bộ chuông thông báo nhắc nhở 24/7</span>
            <span class="text-[11px] px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 font-bold uppercase tracking-wider">ĐANG BẬT</span>
        </div>
    </div>

    <!-- 2. PAGE HEADER BANNER & PRIMARY ACTION BUTTONS -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-5 md:p-6 rounded-2xl bg-white shadow-sm border border-slate-200/90">
        <div class="flex items-start gap-4">
            <div class="w-13 h-13 rounded-2xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-sky-600/20 shrink-0 p-2.5">
                <span class="material-symbols-outlined text-[32px]">medication</span>
            </div>
            <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="font-headline-md text-slate-900 tracking-tight m-0 text-xl md:text-2xl font-bold">
                        LỊCH NHẮC UỐNG THUỐC &amp; ĐƠN THUỐC
                    </h1>
                    <span class="px-2.5 py-0.5 rounded-full bg-cyan-50 text-cyan-700 font-label-sm font-semibold border border-cyan-200 capitalize">
                        Hôm nay: @todayFormatted
                    </span>
                </div>
                <p class="font-body-md text-slate-500 mt-1 mb-0">
                    Theo dõi 4 cữ thuốc hàng ngày và quản lý đơn thuốc điều trị cho toàn bộ các thành viên trong gia đình.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap shrink-0">
            <button onclick="openModal('addPrescriptionModal')" class="btn-action-primary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white font-label-md shadow-sm hover:bg-primary-container transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                <span>+ Kê đơn thuốc mới</span>
            </button>
            <button onclick="switchViewTab('appointments')" class="btn-action-secondary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary text-white font-label-md shadow-sm hover:bg-cyan-800 transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                <span>Lịch hẹn tái khám</span>
            </button>
        </div>
    </div>

    <!-- 3. TAB CONTROLS & FILTER BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface-container-low p-2 md:p-2.5 rounded-2xl border border-slate-200">
        <!-- Switch Tabs -->
        <div class="inline-flex items-center bg-slate-200/80 p-1 rounded-xl gap-1">
            <button id="tabBtnMedications" onclick="switchViewTab('medications')" class="view-tab-btn @(activeTab == "medications" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">pill</span>
                <span class="font-semibold">Lịch uống thuốc hôm nay</span>
                <span id="pendingDoseBadge" class="px-2 py-0.2 rounded-full bg-amber-100 text-amber-800 font-bold text-xs">@(Model?.TodaySchedules?.Count(s => !s.IsTaken) ?? 0) cữ còn</span>
            </button>
            <button id="tabBtnPrescriptions" onclick="switchViewTab('prescriptions')" class="view-tab-btn @(activeTab == "prescriptions" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                <span class="font-semibold">Đơn thuốc điều trị</span>
                <span class="px-2 py-0.2 rounded-full bg-sky-100 text-[#0284C7] font-bold text-xs">@(Model?.ActivePrescriptions?.Count ?? 0) đơn</span>
            </button>
            <button id="tabBtnAppointments" onclick="switchViewTab('appointments')" class="view-tab-btn @(activeTab == "appointments" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">event_upcoming</span>
                <span class="font-semibold">Lịch hẹn tái khám</span>
                <span class="px-2 py-0.2 rounded-full bg-cyan-100 text-cyan-800 font-bold text-xs">@(Model?.UpcomingAppointments?.Count ?? 0) lịch</span>
            </button>
        </div>

        <!-- Member Quick Filter -->
        <div class="flex items-center gap-2 px-2 overflow-x-auto">
            <span class="font-label-sm text-slate-500 uppercase tracking-wider shrink-0 text-xs">Lọc theo:</span>
            <div class="flex items-center gap-1.5 flex-wrap">
                <button onclick="filterByMember('all')" class="member-filter-chip active px-3 py-1 rounded-full text-xs font-semibold bg-white text-primary border border-primary shadow-xs cursor-pointer">
                    Tất cả (@(Model?.Members?.Count ?? 0))
                </button>
                @if (Model?.Members != null)
                {
                    foreach (var member in Model.Members)
                    {
                        <button onclick="filterByMember('@member.FullName')" class="member-filter-chip px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-slate-300 cursor-pointer">
                            @member.FullName (@member.Relationship)
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <!-- 4. TAB CONTENT 1: LỊCH UỐNG THUỐC HÔM NAY (4 CỮ: SÁNG, TRƯA, CHIỀU, TỐI) -->
    <div id="tabContentMedications" class="@(activeTab == "medications" ? "block" : "hidden") space-y-6">
        <!-- Dose Progress Bar & Overview -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-100 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">alarm_on</span>
                </div>
                <div>
                    <div class="font-headline-sm text-slate-900 text-base md:text-lg font-bold">CÁC CỮ THUỐC TRONG NGÀY HÔM NAY</div>
                    <div class="font-label-md text-slate-500 text-xs sm:text-sm">Phân chia rõ 4 khung giờ: Sáng (08:00), Trưa (12:00), Chiều (17:30), Tối (20:30)</div>
                </div>
            </div>

            <!-- Progress Metric -->
            <div class="flex items-center gap-4 bg-surface-container-low px-4 py-2.5 rounded-xl border border-slate-200/60 self-start lg:self-auto">
                <div class="flex flex-col text-right">
                    <span class="font-label-sm text-slate-500 text-xs">Tiến độ cữ thuốc hôm nay</span>
                    <span id="doseProgressText" class="font-title-md text-tertiary font-bold text-sm">Đã uống @takenToday/@totalToday liều</span>
                </div>
                <div class="w-28 sm:w-36 h-3 bg-slate-200 rounded-full overflow-hidden">
                    <div id="doseProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full transition-all duration-500" style="width: @(progressPercent)%;"></div>
                </div>
                <span id="doseProgressPercent" class="font-metric-num text-sm text-primary font-bold">@(progressPercent)%</span>
            </div>
        </div>

        @if (totalToday == 0)
        {
            <!-- EMPTY STATE: HÔM NAY KHÔNG CÓ LỊCH UỐNG THUỐC -->
            <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-xs">
                <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto mb-4 border border-amber-100 shadow-inner">
                    <span class="material-symbols-outlined text-[36px]">medication</span>
                </div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Hôm nay không có lịch uống thuốc</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">Tất cả thành viên trong tổ ấm hiện không có cữ thuốc nào cần uống trong ngày hôm nay.</p>
                <button onclick="openModal('addPrescriptionModal')" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs sm:text-sm font-semibold hover:bg-sky-600 shadow-md shadow-sky-600/20 transition-all border-0 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>+ Kê đơn thuốc mới</span>
                </button>
            </div>
        }
        else
        {
            <!-- 4 DOSE BLOCKS GRID: SÁNG, TRƯA, CHIỀU, TỐI -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
                
                <!-- 1. CỮ SÁNG -->
                <div class="dose-card rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80 flex flex-col justify-between" data-dose-slot="morning">
                    <div>
                        <div class="flex items-center justify-between pb-3 mb-3 bg-amber-50/90 -mx-4 -mt-4 p-3.5 rounded-t-2xl border-b border-amber-100">
                            <div class="flex items-center gap-2 text-amber-700">
                                <span class="material-symbols-outlined text-[24px]">wb_sunny</span>
                                <div>
                                    <span class="font-title-md text-slate-900 block leading-tight font-bold text-sm">CỮ SÁNG</span>
                                    <span class="font-label-sm text-amber-800 font-medium text-xs">07:00 - 09:00 Sáng</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full @(morningDoses.All(d => d.IsTaken) && morningDoses.Any() ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-amber-100 text-amber-800 border-amber-200") font-label-sm font-semibold text-[11px] border">
                                @(morningDoses.All(d => d.IsTaken) && morningDoses.Any() ? "Hoàn thành" : $"{morningDoses.Count(d => !d.IsTaken)} chưa uống")
                            </span>
                        </div>

                        <div class="flex flex-col gap-2.5">
                            @if (morningDoses.Any())
                            {
                                foreach (var s in morningDoses)
                                {
                                    var med = s.PrescriptionDose?.PrescriptionItem;
                                    var mem = med?.Prescription?.Member;
                                    var medName = med?.MedicineName ?? "Thuốc";
                                    var memName = mem?.FullName ?? "Thành viên";

                                    <div id="schedule-item-@s.Id" class="dose-item @(s.IsTaken ? "completed bg-slate-50 border-emerald-200 opacity-90" : "bg-white border-slate-200 shadow-2xs hover:border-sky-300") p-3 rounded-xl border flex flex-col gap-2 transition-all" data-member="@memName">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h4 id="schedule-title-@s.Id" class="font-title-md text-slate-900 text-sm font-bold m-0 truncate @(s.IsTaken ? "line-through text-slate-400" : "")">
                                                    @medName
                                                </h4>
                                                <div class="font-label-sm text-slate-600 text-xs mt-0.5">
                                                    <span class="font-medium text-slate-700">@(med?.DosagePerTime ?? "1 liều")</span>
                                                    <span class="text-slate-300 mx-1">•</span>
                                                    <span class="text-slate-500">Thành viên:</span>
                                                    <strong class="text-slate-800">@memName</strong>
                                                </div>
                                            </div>

                                            <button type="button" 
                                                    id="btn-taken-@s.Id"
                                                    onclick="toggleMarkAsTaken(@s.Id, '@medName', '@memName')"
                                                    class="w-7 h-7 rounded-lg flex items-center justify-center transition-all cursor-pointer border-0 shrink-0 @(s.IsTaken ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-100 text-slate-500 hover:bg-emerald-50 hover:text-emerald-700 border border-slate-200")"
                                                    title="@(s.IsTaken ? "Bấm để chuyển về chưa uống" : "Bấm để đánh dấu ĐÃ UỐNG")">
                                                <span class="material-symbols-outlined text-[17px]">@(s.IsTaken ? "check_circle" : "radio_button_unchecked")</span>
                                            </button>
                                        </div>

                                        @if (!string.IsNullOrEmpty(med?.MealTiming) || !string.IsNullOrEmpty(med?.SpecialInstruction))
                                        {
                                            <div class="font-body-sm text-slate-500 text-[11px] italic bg-slate-50/90 px-2 py-0.5 rounded-md border border-slate-100 flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[13px] text-amber-600">restaurant</span>
                                                <span class="truncate">@(med?.MealTiming ?? med?.SpecialInstruction)</span>
                                            </div>
                                        }

                                        <div id="status-container-@s.Id" class="mt-0.5">
                                            @if (s.IsTaken)
                                            {
                                                <div class="w-full py-1 px-2 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-between text-[11px] font-semibold border border-emerald-100">
                                                    <span class="flex items-center gap-1">
                                                        <span class="material-symbols-outlined text-[14px]">done_all</span>
                                                        <span>Đã uống @(s.TakenAt?.ToString("HH:mm") ?? "")</span>
                                                    </span>
                                                    <span class="text-[10px] text-emerald-600 underline cursor-pointer hover:text-emerald-800" onclick="toggleMarkAsTaken(@s.Id, '', '', true)">Hoàn tác</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button" 
                                                        onclick="toggleMarkAsTaken(@s.Id, '@medName', '@memName')"
                                                        class="w-full py-1.5 px-2 rounded-lg bg-sky-50 hover:bg-sky-100 text-primary font-label-md flex items-center justify-center gap-1 text-xs font-bold border border-sky-200 transition-colors cursor-pointer">
                                                    <span class="material-symbols-outlined text-[15px]">check</span>
                                                    <span>Xác nhận đã uống</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic py-6 text-center m-0">Không có cữ thuốc sáng</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- 2. CỮ TRƯA -->
                <div class="dose-card rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80 flex flex-col justify-between" data-dose-slot="noon">
                    <div>
                        <div class="flex items-center justify-between pb-3 mb-3 bg-sky-50/90 -mx-4 -mt-4 p-3.5 rounded-t-2xl border-b border-sky-100">
                            <div class="flex items-center gap-2 text-sky-700">
                                <span class="material-symbols-outlined text-[24px]">light_mode</span>
                                <div>
                                    <span class="font-title-md text-slate-900 block leading-tight font-bold text-sm">CỮ TRƯA</span>
                                    <span class="font-label-sm text-sky-800 font-medium text-xs">11:30 - 13:00 Trưa</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full @(noonDoses.All(d => d.IsTaken) && noonDoses.Any() ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-sky-100 text-sky-800 border-sky-200") font-label-sm font-semibold text-[11px] border">
                                @(noonDoses.All(d => d.IsTaken) && noonDoses.Any() ? "Hoàn thành" : $"{noonDoses.Count(d => !d.IsTaken)} chưa uống")
                            </span>
                        </div>

                        <div class="flex flex-col gap-2.5">
                            @if (noonDoses.Any())
                            {
                                foreach (var s in noonDoses)
                                {
                                    var med = s.PrescriptionDose?.PrescriptionItem;
                                    var mem = med?.Prescription?.Member;
                                    var medName = med?.MedicineName ?? "Thuốc";
                                    var memName = mem?.FullName ?? "Thành viên";

                                    <div id="schedule-item-@s.Id" class="dose-item @(s.IsTaken ? "completed bg-slate-50 border-emerald-200 opacity-90" : "bg-white border-slate-200 shadow-2xs hover:border-sky-300") p-3 rounded-xl border flex flex-col gap-2 transition-all" data-member="@memName">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h4 id="schedule-title-@s.Id" class="font-title-md text-slate-900 text-sm font-bold m-0 truncate @(s.IsTaken ? "line-through text-slate-400" : "")">
                                                    @medName
                                                </h4>
                                                <div class="font-label-sm text-slate-600 text-xs mt-0.5">
                                                    <span class="font-medium text-slate-700">@(med?.DosagePerTime ?? "1 liều")</span>
                                                    <span class="text-slate-300 mx-1">•</span>
                                                    <span class="text-slate-500">Thành viên:</span>
                                                    <strong class="text-slate-800">@memName</strong>
                                                </div>
                                            </div>

                                            <button type="button" 
                                                    id="btn-taken-@s.Id"
