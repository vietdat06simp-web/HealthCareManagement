    <!-- 5. TAB CONTENT 2: DANH SÁCH ĐƠN THUỐC ĐIỀU TRỊ -->
    <div id="tabContentPrescriptions" class="@(activeTab == "prescriptions" ? "block" : "hidden") space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 md:p-5 rounded-2xl bg-white shadow-sm border border-slate-200">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-sky-100 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[26px]">prescriptions</span>
                </div>
                <div>
                    <h2 class="font-headline-sm text-slate-900 tracking-tight m-0 text-base md:text-lg font-bold">
                        DANH SÁCH ĐƠN THUỐC ĐIỀU TRỊ
                    </h2>
                    <p class="font-body-sm text-slate-500 m-0 text-xs sm:text-sm">
                        Quản lý toàn bộ đơn thuốc bác sĩ kê và phác đồ điều trị cho các thành viên trong gia đình
                    </p>
                </div>
            </div>
            <button onclick="openModal('addPrescriptionModal')" class="btn-action-primary px-4 py-2 rounded-xl bg-primary text-white font-label-md hover:bg-primary-container transition-colors cursor-pointer flex items-center gap-1.5 border-0 text-xs font-semibold self-start sm:self-auto">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>+ Kê đơn thuốc mới</span>
            </button>
        </div>

        @if (Model?.ActivePrescriptions != null && Model.ActivePrescriptions.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var p in Model.ActivePrescriptions)
                {
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-all">
                        <div>
                            <div class="flex items-start justify-between gap-3 pb-3 border-b border-slate-100">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <h3 class="font-title-md text-slate-900 font-bold text-base m-0">@p.PrescriptionName</h3>
                                        <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase">Đang điều trị</span>
                                    </div>
                                    <div class="font-label-sm text-slate-500 text-xs mt-1">
                                        Thành viên: <strong class="text-slate-800">@(p.Member?.FullName ?? "Chưa rõ")</strong> (@(p.Member?.Relationship ?? "Gia đình"))
                                    </div>
                                </div>

                                <!-- Action delete prescription -->
                                <form asp-action="Delete" asp-controller="Prescriptions" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn thuốc \'@p.PrescriptionName\' cùng toàn bộ các lịch nhắc uống thuốc liên quan?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-8 h-8 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 flex items-center justify-center border border-rose-200 transition-colors cursor-pointer" title="Xóa đơn thuốc này">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </form>
                            </div>

                            <div class="grid grid-cols-2 gap-2 py-3 text-xs text-slate-600">
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Bác sĩ điều trị:</span>
                                    <span class="font-semibold text-slate-800">@(p.DoctorName ?? p.MedicalRecord?.DoctorName ?? "Bác sĩ chỉ định")</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Thời gian điều trị:</span>
                                    <span class="font-semibold text-slate-800">@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <div class="mt-2 space-y-2">
                                <span class="font-label-sm text-slate-700 text-xs font-bold uppercase tracking-wider block">Các loại thuốc trong đơn:</span>
                                @if (p.PrescriptionItems != null && p.PrescriptionItems.Any())
                                {
                                    foreach (var item in p.PrescriptionItems)
                                    {
                                        <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 flex items-start justify-between gap-2 text-xs">
                                            <div>
                                                <div class="font-bold text-slate-900">@item.MedicineName</div>
                                                <div class="text-slate-500 mt-0.5">@item.DosagePerTime • @item.MealTiming</div>
                                            </div>
                                            <div class="flex items-center gap-1 flex-wrap justify-end">
                                                @foreach (var dose in item.PrescriptionDoses)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded bg-sky-100 text-primary font-bold text-[10px]">
                                                        @(dose.TimeOfDay ?? dose.DoseTime.ToString(@"hh\:mm"))
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-xs text-slate-400 italic m-0">Chưa có thông tin thuốc chi tiết</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-xs">
                <div class="w-16 h-16 rounded-2xl bg-sky-50 text-primary flex items-center justify-center mx-auto mb-4 border border-sky-100 shadow-inner">
                    <span class="material-symbols-outlined text-[36px]">receipt_long</span>
                </div>
                <h3 class="text-base font-bold text-slate-900 mb-1">Chưa có đơn thuốc nào trong hệ thống</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">Hãy thêm đơn thuốc mới từ bác sĩ để hệ thống tự động sinh lịch nhắc nhở uống thuốc hàng ngày.</p>
                <button onclick="openModal('addPrescriptionModal')" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs sm:text-sm font-semibold hover:bg-sky-600 shadow-md shadow-sky-600/20 transition-all border-0 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>+ Kê đơn thuốc mới</span>
                </button>
            </div>
        }
    </div>

