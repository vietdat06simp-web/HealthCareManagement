                </div>
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1">Chuyên khoa</label>
                    <input type="text" placeholder="Ví dụ: Tim Mạch, Nhi Khoa, Tiêu Hóa" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none" />
                </div>
            </div>

            <div>
                <label class="block font-label-sm text-slate-700 font-semibold mb-1">Lưu ý trước khám / Yêu cầu lâm sàng</label>
                <input type="text" placeholder="Ví dụ: Nhịn ăn sáng, mang theo sổ khám cũ, siêu âm tim..." class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none" />
