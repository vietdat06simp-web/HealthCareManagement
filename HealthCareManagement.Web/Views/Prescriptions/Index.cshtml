    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl modal-fade-in border border-slate-100">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-sky-100 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">medication</span>
                </div>
                <h3 class="font-headline-sm text-slate-900 text-lg font-bold m-0">+ Thêm Đơn Thuốc Mới</h3>
            </div>
            <button onclick="closeModal('addPrescriptionModal')" class="text-slate-400 hover:text-slate-600 border-0 bg-transparent cursor-pointer">
                <span class="material-symbols-outlined text-[22px]">close</span>
            </button>
        </div>

        <form id="newPrescriptionForm" onsubmit="handlePrescriptionSubmit(event)" class="mt-4 space-y-4">
            <div>
                <label class="block font-label-sm text-slate-700 font-semibold mb-1">Tên thuốc &amp; Hàm lượng *</label>
                <input type="text" required placeholder="Ví dụ: Augmentin 1g, Glucophage 500mg..." class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary focus:ring-1 focus:ring-primary text-sm outline-none" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1">Thành viên dùng *</label>
                    <select required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none bg-white">
                        <option value="Khang">Trần Quốc Khang (Ông nội)</option>
                        <option value="Hà">Lê Thu Hà (Mẹ)</option>
                        <option value="An">Trần Bảo An (Con trai)</option>
                        <option value="Đạt">Trần Viết Đạt (Chủ hộ)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1">Liều lượng mỗi lần *</label>
                    <input type="text" required placeholder="Ví dụ: 1 viên, 5ml, 1 giọt" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none" />
                </div>
            </div>

            <div>
                <label class="block font-label-sm text-slate-700 font-semibold mb-1">Các cữ uống trong ngày *</label>
                <div class="flex items-center gap-3">
                    <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
                        <input type="checkbox" checked class="rounded text-primary focus:ring-primary" />
                        <span>Sáng (07:00)</span>
                    </label>
                    <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
                        <input type="checkbox" checked class="rounded text-primary focus:ring-primary" />
                        <span>Trưa (11:30)</span>
                    </label>
                    <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
                        <input type="checkbox" checked class="rounded text-primary focus:ring-primary" />
                        <span>Tối (20:00)</span>
                    </label>
                </div>
            </div>

            <div>
                <label class="block font-label-sm text-slate-700 font-semibold mb-1">Hướng dẫn dùng thuốc (Trước / Sau ăn)</label>
                <input type="text" placeholder="Ví dụ: Uống sau ăn no 30 phút với nhiều nước lọc" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none" />
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeModal('addPrescriptionModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-label-md hover:bg-slate-200 transition-colors border-0 cursor-pointer text-xs font-semibold">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-4 py-2 rounded-xl bg-primary text-white font-label-md hover:bg-primary-container transition-colors border-0 cursor-pointer text-xs font-semibold shadow-sm">
                    Lưu đơn thuốc &amp; Đặt lịch nhắc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Đặt Lịch Tái Khám Mới -->
