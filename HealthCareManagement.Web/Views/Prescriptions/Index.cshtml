                <div>
                    <label class="block font-label-sm text-slate-700 font-semibold mb-1">Thành viên khám *</label>
                    <select required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:border-primary text-sm outline-none bg-white">
                        <option value="Khang">Trần Quốc Khang (Ông nội)</option>
                        <option value="Hà">Lê Thu Hà (Mẹ)</option>
                        <option value="An">Trần Bảo An (Con trai)</option>
