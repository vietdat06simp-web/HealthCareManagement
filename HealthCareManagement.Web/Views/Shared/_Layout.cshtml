<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Family Health Hub</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Global CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthCareManagement.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
        var isPrescriptions = string.Equals(currentController, "Prescriptions", StringComparison.OrdinalIgnoreCase);
        var isAppointments = string.Equals(currentController, "Appointments", StringComparison.OrdinalIgnoreCase);
        var isMedicalRecords = string.Equals(currentController, "MedicalRecords", StringComparison.OrdinalIgnoreCase);
        var isMembers = string.Equals(currentController, "Members", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(currentController, "FamilyGroups", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(currentController, "Family", StringComparison.OrdinalIgnoreCase);
    }

    <!-- Header: Top Navigation Bar ngang -->
    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="header-container max-w-[1140px] mx-auto px-4">
                <!-- Logo bên trái: "Family Health Hub" (Icon #06B6D4, Chữ #0284C7) -->
                <a class="navbar-brand brand-logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-wrapper me-2">
                        <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                            <path d="M3.22 12H9.5l1.5-3 2 6.5 1.5-3.5h6.28" />
                        </svg>
                    </span>
                    <span class="brand-text">Family Health Hub</span>
                </a>

                <!-- Nút toggle cho thiết bị di động -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbarContent"
                        aria-controls="topNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nội dung Navbar -->
                <div class="collapse navbar-collapse" id="topNavbarContent" style="visibility: visible !important;">
                    <!-- Menu ngang ở giữa gồm 5 mục -->
                    <ul class="navbar-nav mx-auto app-nav-menu mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")" asp-controller="Home" asp-action="Index">
                                Trang Chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPrescriptions ? "active" : "")" asp-controller="Prescriptions" asp-action="Index">
                                Nhắc Uống Thuốc
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAppointments ? "active" : "")" asp-controller="Appointments" asp-action="Index">
                                Lịch Tái Khám
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isMedicalRecords ? "active" : "")" asp-controller="MedicalRecords" asp-action="Index">
                                Hồ Sơ Y Tế
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isMembers ? "active" : "")" asp-controller="Members" asp-action="Index">
                                Quản Lý Thành Viên
                            </a>
                        </li>
                    </ul>

                    <!-- Cụm bên phải: Ô tìm kiếm, Icon chuông, Profile chip -->
                    <div class="nav-right-cluster d-flex align-items-center gap-3">
                        <!-- Ô tìm kiếm bo tròn -->
                        <div class="nav-search-box position-relative">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="form-control nav-search-input" placeholder="Tìm kiếm hồ sơ, thuốc..." aria-label="Tìm kiếm" />
                        </div>

                        <!-- Icon chuông thông báo -->
                        <button type="button" class="btn btn-icon notification-bell position-relative" aria-label="Thông báo" title="Thông báo">
                            <i class="bi bi-bell"></i>
                            <span class="notification-indicator position-absolute"></span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Dropdown Menu tài khoản: Avatar + Tên + Tag vai trò -->
                            <div class="dropdown user-dropdown">
                                <button class="user-profile-chip dropdown-toggle d-flex align-items-center text-decoration-none border-0"
                                        type="button"
                                        id="userAccountDropdown"
                                        data-bs-toggle="dropdown"
                                        data-bs-display="static"
                                        aria-expanded="false"
                                        title="Tài khoản @User.Identity.Name">
                                    <div class="user-avatar-circle">
                                        <span>@(!string.IsNullOrWhiteSpace(User.Identity.Name) ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")</span>
                                    </div>
                                    <span class="user-display-name text-truncate">@(User.Identity?.Name ?? "Tài khoản")</span>
                                    @{
                                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                                    }
                                    @if (!string.IsNullOrEmpty(userRole))
                                    {
                                        <span class="user-role-badge">@userRole</span>
                                    }
                                    <i class="bi bi-chevron-down user-dropdown-caret ms-1"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-lg border-0" aria-labelledby="userAccountDropdown">
                                    <li class="dropdown-header px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                        <div class="fw-bold text-dark text-truncate">@(User.Identity?.Name ?? "Tài khoản")</div>
                                        @if (!string.IsNullOrEmpty(userRole))
                                        {
                                            <div class="text-muted small">Vai trò: @userRole</div>
                                        }
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 text-secondary" asp-controller="FamilyGroups" asp-action="Index">
                                            <i class="bi bi-house-gear text-primary fs-5"></i>
                                            <span class="fw-medium">Cài đặt tổ ấm</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 text-danger user-logout-btn w-100 border-0 bg-transparent text-start">
                                                <i class="bi bi-box-arrow-right fs-5"></i>
                                                <span class="fw-medium">Đăng xuất</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Nút Đăng nhập cho người dùng chưa xác thực -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm d-flex align-items-center gap-1.5 rounded-pill px-3 py-1.5 text-white fw-semibold text-decoration-none shadow-sm" style="background: linear-gradient(135deg, #0284C7, #06B6D4); font-size: 0.8125rem;">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>Đăng nhập</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Vùng nội dung chính -->
    <main class="max-w-[1140px] mx-auto py-6 px-4 flex-grow-1 w-100">
        @if (TempData["SuccessMessage"] != null && !(ViewContext.RouteData.Values["Controller"]?.ToString() == "FamilyGroups"))
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Footer chuẩn hóa -->
    <footer class="app-footer">
        <div class="footer-container max-w-[1140px] mx-auto px-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="footer-copyright">
                &copy; 2026 Family Health Hub
            </div>
            <div class="footer-hotlines d-flex align-items-center flex-wrap gap-2 gap-sm-3">
                <span class="hotline-label text-muted">Hotline:</span>
                <a href="tel:115" class="hotline-badge emergency" title="Cấp cứu 115">
                    <i class="bi bi-telephone-plus-fill me-1"></i>
                    <span>115</span>
                </a>
                <a href="tel:19008888" class="hotline-badge consultation" title="Tư vấn sức khỏe 1900 8888">
                    <i class="bi bi-headset me-1"></i>
                    <span>1900 8888</span>
                </a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
