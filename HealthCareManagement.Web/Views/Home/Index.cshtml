@model HealthCareManagement.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Trang Chủ - Bảng Điều Khiển Sức Khỏe Gia Đình";
    var viCulture = new System.Globalization.CultureInfo("vi-VN");
    var todayFormatted = DateTime.Now.ToString("dddd, dd/MM/yyyy", viCulture);
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed": "#001f26",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed": "#002113",
                        "on-tertiary-container": "#f5fff6",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/home-dashboard.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-6 pb-8">
    <!-- 1. BREADCRUMB & REALTIME SYNC STATUS -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Bảng điều khiển trung tâm</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 font-label-sm border border-emerald-200 shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600"></span>
            </span>
            <span class="font-medium text-xs">
                Đồng bộ thời gian thực: 
                <strong class="font-bold text-slate-900">
                    @(Model?.MembersSummary?.Count(m => m.VitalStatus == "Bình thường") ?? 0)/@(Model?.TotalMembers ?? 0) thành viên ổn định
                </strong>
            </span>
        </div>
    </div>

    <!-- 2. BANNER CHÀO MỪNG CÁ NHÂN HÓA & TRẠNG THÁI SỨC KHỎE TỔNG QUAN -->
    <div class="p-6 md:p-8 rounded-3xl bg-gradient-to-r from-sky-900 via-sky-800 to-cyan-900 text-white shadow-lg relative overflow-hidden">
        <div class="absolute -top-16 -right-16 w-64 h-64 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-3 max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md text-cyan-200 text-xs font-semibold border border-white/15">
                    <span class="material-symbols-outlined text-[16px]">home_health</span>
                    <span>Tổ ấm: @(Model?.FamilyGroupName ?? "Gia đình") • Mã số HGĐ: #@(Model?.InviteCode ?? "CHƯA TẠO")</span>
                </div>
                <h1 class="font-headline-lg text-white text-2xl md:text-3xl font-bold tracking-tight m-0">
                    Xin chào, @(Model?.FamilyGroupName ?? "Tổ ấm gia đình")! 👋
                </h1>
                <p class="font-body-md text-sky-100 text-sm md:text-base m-0 leading-relaxed capitalize">
                    Hôm nay @todayFormatted. Có <strong class="text-white font-bold">@(Model?.TotalMembers ?? 0) thành viên</strong> trong tổ ấm.
                    Hiện có <strong id="bannerPendingCount" class="text-white underline decoration-cyan-400 font-bold">@(Model?.PendingMedicationsCount ?? 0) cữ thuốc cần uống</strong> 
                    và <strong class="text-white underline decoration-amber-400 font-bold">@(Model?.UpcomingAppointments?.Count ?? 0) lịch tái khám sắp tới</strong>.
                </p>
            </div>

            <div class="flex items-center gap-3 flex-wrap shrink-0">
                <a asp-controller="Members" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-label-md font-bold shadow-md hover:shadow-cyan-500/30 transition-all text-decoration-none cursor-pointer border-0 text-sm">
                    <span class="material-symbols-outlined text-[20px]">monitor_heart</span>
                    <span>Ghi nhận sinh hiệu</span>
                </a>
                <button onclick="openModal('sosEmergencyModal')" class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-label-md font-bold shadow-md hover:shadow-rose-600/40 transition-all cursor-pointer border-0 text-sm animate-pulse">
                    <span class="material-symbols-outlined text-[20px]">emergency</span>
                    <span>SOS Y Tế Khẩn Cấp</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. 4 KHỐI THỐNG KÊ / QUICK STATS WIDGETS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Widget 1: Nhắc Uống Thuốc Hôm Nay -->
        <a asp-controller="Prescriptions" asp-action="Index" class="dashboard-stat-card bg-white p-5 rounded-2xl flex flex-col justify-between text-decoration-none group cursor-pointer border border-slate-200 shadow-sm hover:border-primary/50 transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="w-12 h-12 rounded-xl bg-sky-100 text-primary flex items-center justify-center group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-[26px]">medication</span>
                </div>
                <span id="statPendingBadge" class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 font-label-sm font-bold text-xs">
                    Còn @(Model?.PendingMedicationsCount ?? 0) cữ
                </span>
            </div>
            <div>
                <span class="font-label-sm text-slate-500 uppercase tracking-wider block font-semibold text-xs">Uống thuốc hôm nay</span>
                <div id="statDosesRatio" class="font-metric-num text-slate-900 text-2xl font-bold mt-1">
                    Đã uống @(Model?.TakenMedicationsCount ?? 0)/@(Model?.TotalTodayMedications ?? 0)
                </div>
                <div class="w-full bg-slate-100 h-2 rounded-full mt-2.5 overflow-hidden">
                    <div id="statDoseProgressBar" class="bg-gradient-to-r from-sky-500 to-cyan-500 h-full rounded-full transition-all duration-500" style="width: @(Model?.ProgressPercent ?? 0)%;"></div>
                </div>
                <p class="font-body-sm text-slate-500 text-xs mt-2 m-0 flex items-center justify-between">
                    <span id="statDosePercentText">Tiến độ ngày: @(Model?.ProgressPercent ?? 0)%</span>
                    <span class="text-primary font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center">
                        Chi tiết <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </span>
                </p>
            </div>
        </a>

        <!-- Widget 2: Lịch Tái Khám Sắp Tới -->
        <a asp-controller="Prescriptions" asp-action="Index" asp-route-tab="appointments" class="dashboard-stat-card bg-white p-5 rounded-2xl flex flex-col justify-between text-decoration-none group cursor-pointer border border-slate-200 shadow-sm hover:border-secondary/50 transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="w-12 h-12 rounded-xl bg-cyan-100 text-secondary flex items-center justify-center group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-[26px]">calendar_month</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-cyan-100 text-cyan-800 font-label-sm font-bold text-xs">
                    @((Model?.UpcomingAppointments != null && Model.UpcomingAppointments.Any()) ? $"{Model.UpcomingAppointments.Count} lịch hẹn" : "Chưa có hẹn")
                </span>
            </div>
            <div>
                <span class="font-label-sm text-slate-500 uppercase tracking-wider block font-semibold text-xs">Lịch tái khám gần nhất</span>
                @{
                    var nearestApt = Model?.UpcomingAppointments?.FirstOrDefault();
                }
                <div class="font-metric-num text-slate-900 text-2xl font-bold mt-1">
                    @(nearestApt != null ? (nearestApt.DaysLeft == 0 ? "Hôm nay" : $"Còn {nearestApt.DaysLeft} ngày") : "Không có hẹn")
                </div>
                <p class="font-body-sm text-slate-700 text-xs mt-1.5 m-0 font-medium truncate">
                    @(nearestApt != null ? $"{nearestApt.FacilityName} • {nearestApt.DoctorName}" : "Chưa có lịch hẹn tái khám")
                </p>
                <p class="font-body-sm text-slate-500 text-xs mt-2.5 m-0 flex items-center justify-between">
                    <span>Bệnh nhân: @(nearestApt?.MemberName ?? "Chưa có")</span>
                    <span class="text-secondary font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center">
                        Xem lịch <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </span>
                </p>
            </div>
        </a>

        <!-- Widget 3: Cảnh Báo Chỉ Số Sinh Hiệu -->
        <a asp-controller="Members" asp-action="Index" class="dashboard-stat-card bg-white p-5 rounded-2xl flex flex-col justify-between text-decoration-none group cursor-pointer border border-slate-200 shadow-sm hover:border-emerald-500/50 transition-all">
            @{
                var abnormalCount = Model?.MembersSummary?.Count(m => m.VitalStatus == "Cần theo dõi") ?? 0;
                var latestVital = Model?.MembersSummary?.Where(m => m.LatestSystolic.HasValue).OrderByDescending(m => m.LastMeasuredAt).FirstOrDefault();
            }
            <div class="flex items-center justify-between mb-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-[26px]">vital_signs</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full @(abnormalCount > 0 ? "bg-rose-100 text-rose-800" : "bg-emerald-100 text-emerald-800") font-label-sm font-bold text-xs flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full @(abnormalCount > 0 ? "bg-rose-600" : "bg-emerald-600")"></span>
                    @(abnormalCount > 0 ? $"{abnormalCount} cần lưu ý" : "Ổn định")
                </span>
            </div>
            <div>
                <span class="font-label-sm text-slate-500 uppercase tracking-wider block font-semibold text-xs">Sinh hiệu gia đình</span>
                <div class="font-metric-num text-slate-900 text-2xl font-bold mt-1">
                    @(latestVital != null ? $"{latestVital.LatestSystolic}/{latestVital.LatestDiastolic}" : "--/--") <span class="text-sm font-normal text-slate-500">mmHg</span>
                </div>
                <p class="font-body-sm text-slate-700 text-xs mt-1.5 m-0 font-medium truncate">
                    @(latestVital != null ? $"{latestVital.FullName} • Nhịp tim {latestVital.LatestHeartRate ?? 0} bpm" : "Chưa có dữ liệu sinh hiệu")
                </p>
                <p class="font-body-sm text-slate-500 text-xs mt-2.5 m-0 flex items-center justify-between">
                    <span>Đo gần nhất: @(latestVital?.LastMeasuredAt?.ToString("dd/MM") ?? "Chưa đo")</span>
                    <span class="text-emerald-700 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center">
                        Chi tiết <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </span>
                </p>
            </div>
        </a>

        <!-- Widget 4: Bệnh Án Điện Tử Cập Nhật Mới Nhất -->
        <a asp-controller="MedicalRecords" asp-action="Index" class="dashboard-stat-card bg-white p-5 rounded-2xl flex flex-col justify-between text-decoration-none group cursor-pointer border border-slate-200 shadow-sm hover:border-indigo-500/50 transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-[26px]">folder_shared</span>
                </div>
                <span class="px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800 font-label-sm font-bold text-xs">
                    EMR / HL7
                </span>
            </div>
            <div>
                <span class="font-label-sm text-slate-500 uppercase tracking-wider block font-semibold text-xs">Hồ sơ y tế điện tử</span>
                <div class="font-metric-num text-slate-900 text-2xl font-bold mt-1">@(Model?.TotalRecordsCount ?? 0) Bệnh án</div>
                <p class="font-body-sm text-slate-700 text-xs mt-1.5 m-0 font-medium">
                    100% bảo mật &amp; số hóa theo tổ ấm
                </p>
                <p class="font-body-sm text-slate-500 text-xs mt-2.5 m-0 flex items-center justify-between">
                    <span>Thành viên: @(Model?.TotalMembers ?? 0) người</span>
                    <span class="text-indigo-700 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center">
                        Mở kho <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </span>
                </p>
            </div>
        </a>
    </div>

    <!-- 4. HAI KHỐI TẬP TRUNG CHÍNH: CÁC CỮ THUỐC HÔM NAY VÀ LỊCH TÁI KHÁM SẮP TỚI -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- KHỐI 1: CÁC CỮ THUỐC HÔM NAY KÈM NÚT CHECK NHANH -->
        <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-sky-100 text-primary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[24px]">pill</span>
                        </div>
                        <div>
                            <h3 class="font-headline-sm text-slate-900 text-base font-bold m-0">LỊCH UỐNG THUỐC TRONG NGÀY</h3>
                            <p class="font-body-sm text-slate-500 text-xs m-0">Xác nhận cữ thuốc trực tiếp không cần chuyển trang</p>
                        </div>
                    </div>
                    <a asp-controller="Prescriptions" asp-action="Index" class="font-label-sm text-primary hover:underline font-semibold text-xs flex items-center gap-1 text-decoration-none">
                        <span>Xem tất cả</span>
                        <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                    </a>
                </div>

                @if (Model?.TodayMedicationSchedules != null && Model.TodayMedicationSchedules.Any())
                {
                    <div class="space-y-3">
                        @foreach (var s in Model.TodayMedicationSchedules)
                        {
                            var slotColor = s.TimeSlot switch
                            {
                                "Sáng" => "bg-amber-100 text-amber-800 border-amber-200",
                                "Trưa" => "bg-sky-100 text-sky-800 border-sky-200",
                                "Chiều" => "bg-orange-100 text-orange-800 border-orange-200",
                                _ => "bg-indigo-100 text-indigo-800 border-indigo-200"
                            };

                            <div id="home-sched-@s.Id" class="p-3.5 rounded-2xl border transition-all flex items-start justify-between gap-3 @(s.IsTaken ? "bg-slate-50 border-emerald-200 opacity-90" : "bg-white border-slate-200 hover:border-sky-300 shadow-2xs")">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="px-2 py-0.5 rounded-full font-bold text-[10px] border @slotColor">
                                            @s.TimeSlot
                                        </span>
                                        <h4 id="home-sched-title-@s.Id" class="font-title-md text-slate-900 text-sm font-bold m-0 truncate @(s.IsTaken ? "line-through text-slate-400" : "")">
                                            @s.DrugName
                                        </h4>
                                    </div>
                                    <div class="text-xs text-slate-600 mt-1 flex items-center gap-1.5 flex-wrap">
                                        <span class="font-semibold text-slate-800">@s.MemberName</span>
                                        <span class="text-slate-300">•</span>
                                        <span class="text-slate-500">Liều: @s.Dosage</span>
                                        <span class="text-slate-300">•</span>
                                        <span class="text-slate-500 italic">@s.MealTime</span>
                                    </div>
                                </div>

                                <!-- AJAX MarkAsTaken Check Button -->
                                <div id="home-sched-btn-container-@s.Id" class="shrink-0">
                                    @if (s.IsTaken)
                                    {
                                        <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 font-label-md font-semibold text-xs border border-emerald-200">
                                            <span class="material-symbols-outlined text-[16px]">done_all</span>
                                            <span>Đã uống @(s.TakenAt?.ToString("HH:mm") ?? "")</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" 
                                                onclick="quickMarkTaken(@s.Id, '@s.DrugName', '@s.MemberName')"
                                                id="home-btn-@s.Id"
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-sky-50 hover:bg-emerald-600 hover:text-white text-primary font-label-md font-bold text-xs border border-sky-200 hover:border-emerald-600 transition-all cursor-pointer">
                                            <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                            <span>Đã uống</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-10 px-4 text-center rounded-2xl bg-slate-50 border border-dashed border-slate-200">
                        <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto mb-2 border border-amber-100">
                            <span class="material-symbols-outlined text-[26px]">medication</span>
                        </div>
                        <h4 class="font-title-md text-slate-800 text-sm font-bold mb-1">Hôm nay không có lịch uống thuốc</h4>
                        <p class="font-body-sm text-slate-500 text-xs mb-4">Tổ ấm hiện không có cữ thuốc nào cần uống trong ngày hôm nay.</p>
                        <a asp-controller="Prescriptions" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-primary text-white text-xs font-semibold hover:bg-sky-600 transition-colors text-decoration-none">
                            <span class="material-symbols-outlined text-[16px]">add</span>
                            <span>Kê đơn thuốc mới</span>
                        </a>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span>Dữ liệu nhắc nhở theo thời gian thực của tổ ấm</span>
                <a asp-controller="Prescriptions" asp-action="Index" class="text-primary font-semibold hover:underline">
                    Quản lý phác đồ điều trị →
                </a>
            </div>
        </div>

        <!-- KHỐI 2: LỊCH TÁI KHÁM SẮP TỚI (TOP 3 - 5 LỊCH HẸN) -->
        <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-cyan-100 text-secondary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-[24px]">event_upcoming</span>
                        </div>
                        <div>
                            <h3 class="font-headline-sm text-slate-900 text-base font-bold m-0">LỊCH TÁI KHÁM SẮP TỚI</h3>
                            <p class="font-body-sm text-slate-500 text-xs m-0">Các mốc khám chuyên khoa và kiểm tra sức khỏe gia đình</p>
                        </div>
                    </div>
                    <a asp-controller="Prescriptions" asp-action="Index" asp-route-tab="appointments" class="font-label-sm text-secondary hover:underline font-semibold text-xs flex items-center gap-1 text-decoration-none">
                        <span>Xem tất cả</span>
                        <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                    </a>
                </div>

                @if (Model?.UpcomingAppointments != null && Model.UpcomingAppointments.Any())
                {
                    <div class="space-y-3">
                        @foreach (var apt in Model.UpcomingAppointments)
                        {
                            var daysBadge = apt.DaysLeft == 0 
                                ? "bg-rose-100 text-rose-800 border-rose-200" 
                                : apt.DaysLeft <= 2 
                                ? "bg-amber-100 text-amber-800 border-amber-200" 
                                : "bg-cyan-100 text-cyan-800 border-cyan-200";

                            <div class="p-3.5 rounded-2xl bg-white border border-slate-200 hover:border-slate-300 shadow-2xs flex items-center justify-between gap-3 transition-all">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-12 h-12 rounded-xl bg-sky-50 border border-sky-100 flex flex-col items-center justify-center text-primary shrink-0">
                                        <span class="font-bold text-[15px] leading-tight">@apt.AppointmentDate.ToString("dd")</span>
                                        <span class="text-[10px] uppercase font-bold text-slate-500">Th@apt.AppointmentDate.ToString("MM")</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="font-title-md text-slate-900 text-sm font-bold m-0 truncate">@apt.FacilityName</h4>
                                        <p class="font-body-sm text-slate-600 text-xs m-0 mt-0.5 truncate">
                                            Bác sĩ: <strong class="text-slate-800">@apt.DoctorName</strong> • Khám: <strong class="text-slate-800">@apt.MemberName</strong>
                                        </p>
                                        <span class="text-[11px] text-slate-400 font-medium">Giờ hẹn: @apt.AppointmentDate.ToString("HH:mm")</span>
                                    </div>
                                </div>

                                <div class="shrink-0 text-right">
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-label-sm font-bold text-xs border @daysBadge">
                                        @(apt.DaysLeft == 0 ? "Hôm nay!" : $"Còn {apt.DaysLeft} ngày")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-10 px-4 text-center rounded-2xl bg-slate-50 border border-dashed border-slate-200">
                        <div class="w-12 h-12 rounded-xl bg-cyan-50 text-secondary flex items-center justify-center mx-auto mb-2 border border-cyan-100">
                            <span class="material-symbols-outlined text-[26px]">calendar_month</span>
                        </div>
                        <h4 class="font-title-md text-slate-800 text-sm font-bold mb-1">Chưa có lịch hẹn tái khám</h4>
                        <p class="font-body-sm text-slate-500 text-xs mb-4">Gia đình hiện chưa có mốc tái khám hay tiêm chủng nào sắp tới.</p>
                        <a asp-controller="Appointments" asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-secondary text-white text-xs font-semibold hover:bg-cyan-800 transition-colors text-decoration-none">
                            <span class="material-symbols-outlined text-[16px]">add</span>
                            <span>Đặt lịch tái khám</span>
                        </a>
                    </div>
                }
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span>Tự động gửi thông báo nhắc nhở trước 1 ngày hẹn</span>
                <a asp-controller="Appointments" asp-action="Index" class="text-secondary font-semibold hover:underline">
                    Xem lịch tiêm chủng &amp; tái khám →
                </a>
            </div>
        </div>

    </div>

    <!-- 5. TÓM TẮT SỨC KHỎE NHANH CỦA CÁC THÀNH VIÊN TRONG GIA ĐÌNH -->
    <div class="bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">vital_signs</span>
                </div>
                <div>
                    <h3 class="font-headline-sm text-slate-900 text-base font-bold m-0">TÓM TẮT SINH HIỆU THÀNH VIÊN GIA ĐÌNH</h3>
                    <p class="font-body-sm text-slate-500 text-xs m-0">Theo dõi nhanh tình trạng huyết áp, nhịp tim và lần đo gần nhất của từng người</p>
                </div>
            </div>
            <a asp-controller="Members" asp-action="Index" class="btn-action-primary px-3.5 py-2 rounded-xl bg-primary text-white font-label-md hover:bg-primary-container transition-colors cursor-pointer flex items-center gap-1.5 border-0 text-xs font-semibold text-decoration-none self-start sm:self-auto">
                <span class="material-symbols-outlined text-[17px]">add_chart</span>
                <span>Ghi nhận chỉ số mới</span>
            </a>
        </div>

        @if (Model?.MembersSummary != null && Model.MembersSummary.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                @foreach (var m in Model.MembersSummary)
                {
                    var statusColor = m.VitalStatus switch
                    {
                        "Bình thường" => "bg-emerald-100 text-emerald-800 border-emerald-200",
                        "Cần theo dõi" => "bg-amber-100 text-amber-800 border-amber-200",
                        _ => "bg-slate-100 text-slate-600 border-slate-200"
                    };

                    var initialLetter = !string.IsNullOrWhiteSpace(m.FullName) ? m.FullName.Trim().Substring(0, 1).ToUpper() : "T";

                    <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200 hover:border-slate-300 transition-all flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between gap-2 pb-3 border-b border-slate-200/60">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm shrink-0">
                                        @initialLetter
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="font-title-md text-slate-900 text-sm font-bold m-0 truncate">@m.FullName</h4>
                                        <span class="text-xs text-slate-500 font-medium">@m.Relationship</span>
                                    </div>
                                </div>
                                <span class="px-2 py-0.5 rounded-full font-bold text-[10px] border shrink-0 @statusColor">
                                    @m.VitalStatus
                                </span>
                            </div>

                            <div class="grid grid-cols-2 gap-2.5 py-3">
                                <div class="p-2.5 rounded-xl bg-white border border-slate-100">
                                    <span class="text-[11px] text-slate-400 block font-medium">Huyết áp</span>
                                    <span class="font-bold text-slate-900 text-sm">
                                        @(m.LatestSystolic.HasValue ? $"{m.LatestSystolic}/{m.LatestDiastolic}" : "--/--")
                                    </span>
                                    <span class="text-[10px] text-slate-400 block">mmHg</span>
                                </div>
                                <div class="p-2.5 rounded-xl bg-white border border-slate-100">
                                    <span class="text-[11px] text-slate-400 block font-medium">Nhịp tim</span>
                                    <span class="font-bold text-slate-900 text-sm">
                                        @(m.LatestHeartRate.HasValue ? $"{m.LatestHeartRate}" : "--")
                                    </span>
                                    <span class="text-[10px] text-slate-400 block">BPM</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-500">
                            <span>Lần đo: @(m.LastMeasuredAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa đo")</span>
                            <a asp-controller="Members" asp-action="Index" class="text-primary font-semibold hover:underline">
                                Đo ngay →
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="py-8 text-center text-slate-400 text-xs">
                Chưa có thành viên nào trong gia đình. Vui lòng thêm thành viên tại mục Quản lý thành viên.
            </div>
        }
    </div>

    <!-- 6. CỤM LỐI TẮT NHANH TỚI CÁC CHỨC NĂNG CHÍNH (QUICK SHORTCUT BAR) -->
    <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">bolt</span>
            <span class="font-title-md text-slate-800 text-xs font-bold uppercase tracking-wider">Lối tắt thao tác nhanh:</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-controller="Prescriptions" asp-action="Index" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold shadow-xs border border-slate-200 flex items-center gap-1.5 transition-all text-decoration-none">
                <span class="material-symbols-outlined text-[16px] text-primary">add_circle</span>
                <span>+ Kê đơn thuốc</span>
            </a>
            <a asp-controller="Appointments" asp-action="Index" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold shadow-xs border border-slate-200 flex items-center gap-1.5 transition-all text-decoration-none">
                <span class="material-symbols-outlined text-[16px] text-secondary">calendar_add_on</span>
                <span>+ Đặt lịch khám</span>
            </a>
            <a asp-controller="MedicalRecords" asp-action="Index" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold shadow-xs border border-slate-200 flex items-center gap-1.5 transition-all text-decoration-none">
                <span class="material-symbols-outlined text-[16px] text-emerald-700">upload_file</span>
                <span>+ Tải hồ sơ EMR</span>
            </a>
            <a asp-controller="Members" asp-action="Index" class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold shadow-xs border border-slate-200 flex items-center gap-1.5 transition-all text-decoration-none">
                <span class="material-symbols-outlined text-[16px] text-purple-700">person_add</span>
                <span>+ Thêm thành viên</span>
            </a>
        </div>
    </div>
</div>

