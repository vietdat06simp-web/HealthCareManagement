<!-- Floating Toast Container -->
<div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

@section Scripts {
    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Quick Mark As Taken via AJAX on Dashboard
        async function quickMarkTaken(scheduleId, drugName, memberName) {
            const btn = document.getElementById(`home-btn-${scheduleId}`);
            const item = document.getElementById(`home-sched-${scheduleId}`);
            const title = document.getElementById(`home-sched-title-${scheduleId}`);
            const container = document.getElementById(`home-sched-btn-container-${scheduleId}`);

            if (btn) btn.disabled = true;

            try {
                const response = await fetch(`/Prescriptions/MarkAsTaken/${scheduleId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) throw new Error('Không thể kết nối đến máy chủ.');
                const data = await response.json();

                if (data.success) {
                    if (item) {
                        item.classList.add('bg-slate-50', 'border-emerald-200', 'opacity-90');
                        item.classList.remove('bg-white', 'border-slate-200');
                    }
                    if (title) {
                        title.classList.add('line-through', 'text-slate-400');
                    }
                    if (container) {
                        container.innerHTML = `
                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 font-label-md font-semibold text-xs border border-emerald-200">
                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                <span>Đã uống ${data.takenAt || 'vừa xong'}</span>
                            </span>
                        `;
                    }

                    // Dynamically decrease pending count in widgets
                    updateDashboardDoseCounts();
                    showToast(`Đã ghi nhận uống thuốc "${drugName}" cho ${memberName}!`, 'success');
                } else {
                    showToast(data.message || 'Lỗi khi cập nhật cữ thuốc.', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Không thể cập nhật cữ thuốc.', 'error');
            } finally {
                if (btn) btn.disabled = false;
            }
        }

        function updateDashboardDoseCounts() {
            const allDoses = document.querySelectorAll('[id^="home-sched-"]');
            const takenDoses = document.querySelectorAll('[id^="home-sched-"][class*="border-emerald-200"]');
            const total = allDoses.length;
            const taken = takenDoses.length;
            const pending = Math.max(0, total - taken);
            const pct = total > 0 ? Math.round((taken / total) * 100) : 0;

            const badge = document.getElementById('statPendingBadge');
            const ratio = document.getElementById('statDosesRatio');
            const pbar = document.getElementById('statDoseProgressBar');
            const ptext = document.getElementById('statDosePercentText');
            const banner = document.getElementById('bannerPendingCount');

            if (badge) badge.innerText = `Còn ${pending} cữ`;
            if (ratio) ratio.innerText = `Đã uống ${taken}/${total}`;
            if (pbar) pbar.style.width = `${pct}%`;
            if (ptext) ptext.innerText = `Tiến độ ngày: ${pct}%`;
            if (banner) banner.innerText = `${pending} cữ thuốc cần uống`;
        }

        // Toast notification system
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto p-3.5 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2.5 transition-all transform translate-y-4 opacity-0 ${
                type === 'success' 
                    ? 'bg-emerald-900 text-white border-emerald-700' 
                    : type === 'error'
                    ? 'bg-rose-900 text-white border-rose-700'
                    : 'bg-slate-900 text-white border-slate-700'
            }`;

            const iconName = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
            toast.innerHTML = `
                <span class="material-symbols-outlined text-[18px] text-cyan-400">${iconName}</span>
                <span class="flex-1">${message}</span>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
}
