<div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

@section Scripts {
    <script>
        // Tab switching logic
        function switchViewTab(tab) {
            const tabBtnMed = document.getElementById('tabBtnMedications');
            const tabBtnApp = document.getElementById('tabBtnAppointments');
            const contentMed = document.getElementById('tabContentMedications');
            const contentApp = document.getElementById('tabContentAppointments');

            if (tab === 'medications') {
                tabBtnMed.classList.add('active');
                tabBtnApp.classList.remove('active');
                contentMed.classList.remove('hidden');
                contentMed.classList.add('block');
                contentApp.classList.add('hidden');
                contentApp.classList.remove('block');
            } else {
                tabBtnApp.classList.add('active');
                tabBtnMed.classList.remove('active');
                contentApp.classList.remove('hidden');
                contentApp.classList.add('block');
                contentMed.classList.add('hidden');
                contentMed.classList.remove('block');
            }
        }

        // Member filtering logic
        function filterByMember(member) {
            // Update filter chip buttons
            const chips = document.querySelectorAll('.member-filter-chip');
            chips.forEach(chip => {
                chip.classList.remove('active', 'border-primary', 'text-primary', 'shadow-xs');
                chip.classList.add('border-slate-200', 'text-slate-600');
            });
            event.currentTarget.classList.add('active', 'border-primary', 'text-primary', 'shadow-xs');
            event.currentTarget.classList.remove('border-slate-200', 'text-slate-600');

            // Filter doses
            const doseItems = document.querySelectorAll('.dose-item');
            doseItems.forEach(item => {
                const itemMember = item.getAttribute('data-member');
                if (member === 'all' || itemMember === member) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });

            // Filter appointment rows
            const appRows = document.querySelectorAll('.appointment-row');
            appRows.forEach(row => {
                const rowMember = row.getAttribute('data-member');
                if (member === 'all' || rowMember === member) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            showToast(`Đã lọc hiển thị cho thành viên: ${member === 'all' ? 'Tất cả' : member}`);
        }

        // Dose confirmation logic
        let takenDoses = 3;
        const totalDoses = 6;

        function markDoseTaken(itemId, actionContainerId, medName, memberName) {
            const item = document.getElementById(itemId);
            const container = document.getElementById(actionContainerId);
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            if (item) {
                item.classList.add('completed');
                item.classList.remove('bg-sky-50/60', 'border-sky-200');
                item.classList.add('bg-slate-50', 'border-emerald-200');
            }

            if (container) {
                container.innerHTML = `
                    <div class="mt-1 w-full py-2 px-3 rounded-xl bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-200">
                        <span class="material-symbols-outlined text-[16px]">done_all</span>
                        <span>Đã xác nhận uống lúc ${timeStr}</span>
                    </div>
                `;
            }

            takenDoses = Math.min(totalDoses, takenDoses + 1);
            updateProgress();
            showToast(`Đã ghi nhận uống thuốc "${medName}" cho ${memberName}!`, 'success');
        }

        function skipDose(itemId, actionContainerId) {
            const container = document.getElementById(actionContainerId);
            if (container) {
                container.innerHTML = `
                    <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-slate-100 text-slate-500 font-label-md flex items-center justify-center gap-1 text-xs italic">
                        <span>Đã bỏ qua cữ này</span>
                    </div>
                `;
            }
            showToast('Đã bỏ qua cữ uống này theo chỉ định khi cần.');
        }

        function updateProgress() {
            const progressPercent = Math.round((takenDoses / totalDoses) * 100);
            const progressBar = document.getElementById('doseProgressBar');
            const progressText = document.getElementById('doseProgressText');
            const progressPercentEl = document.getElementById('doseProgressPercent');
            const badge = document.getElementById('pendingDoseBadge');

            if (progressBar) progressBar.style.width = `${progressPercent}%`;
            if (progressText) progressText.innerText = `Đã uống ${takenDoses}/${totalDoses} liều`;
            if (progressPercentEl) progressPercentEl.innerText = `${progressPercent}%`;
            if (badge) badge.innerText = `${totalDoses - takenDoses} cữ còn`;
        }

        function sendReminderPush(medName, memberName) {
            showToast(`Đã gửi thông báo đẩy và SMS nhắc "${medName}" đến điện thoại của ${memberName}!`, 'info');
        }

        function remindOneDayBefore(dateStr, doctorHospital) {
            showToast(`Đã thiết lập chuông nhắc nhở trước 1 ngày cho lịch hẹn ${dateStr} (${doctorHospital})!`, 'success');
        }

        function viewDirections(hospital, address, room) {
            document.getElementById('directionsHospitalName').innerText = hospital;
            document.getElementById('directionsHospitalAddress').innerText = address;
            document.getElementById('directionsHospitalRoom').innerText = room;
            document.getElementById('googleMapsLink').href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(hospital + ' ' + address)}`;
            openModal('directionsModal');
        }

        function downloadAppointmentTicket() {
            showToast('Đã tạo mã QR tiếp đón bệnh viện điện tử thành công!', 'success');
            closeModal('directionsModal');
        }

        // Modal helpers
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        function toggleFilterDrawer() {
            showToast('Bộ lọc nhanh theo cữ uống và thành viên đã sẵn sàng ở thanh công cụ.');
        }

        function handlePrescriptionSubmit(e) {
            e.preventDefault();
            closeModal('addPrescriptionModal');
            showToast('Đã thêm đơn thuốc mới và đồng bộ vào lịch nhắc tự động!', 'success');
        }

        function handleAppointmentSubmit(e) {
            e.preventDefault();
            closeModal('addAppointmentModal');
            showToast('Đã đặt lịch tái khám mới và bật thông báo nhắc nhở 24/7!', 'success');
        }

        // Toast notification system
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto p-3.5 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2.5 transition-all transform translate-y-4 opacity-0 ${
                type === 'success' 
                    ? 'bg-emerald-900 text-white border-emerald-700' 
                    : type === 'error'
                    ? 'bg-rose-900 text-white border-rose-700'
                    : 'bg-slate-900 text-white border-slate-700'
            }`;

            const iconName = type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'info';
            toast.innerHTML = `
                <span class="material-symbols-outlined text-[18px] text-teal-400">${iconName}</span>
                <span class="flex-1">${message}</span>
            `;

            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Initialize active tab from query param if provided
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam === 'appointments') {
                switchViewTab('appointments');
            }
        });
    </script>
}
