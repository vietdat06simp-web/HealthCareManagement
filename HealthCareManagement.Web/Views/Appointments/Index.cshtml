@model HealthCareManagement.Web.Models.ViewModels.PrescriptionsIndexViewModel
@{
    ViewData["Title"] = "Lịch Tái Khám & Nhắc Uống Thuốc";
    var activeTab = (ViewBag.ActiveTab as string) ?? "appointments";
}

@section Styles {
    <!-- Google Fonts: Inter, Plus Jakarta Sans & Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN with non-conflicting config for Material Design Tokens -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                visibility: false,
            },
            theme: {
                extend: {
                    colors: {
                        "primary": "#006194",
                        "primary-container": "#007bb9",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#fdfcff",
                        "primary-fixed": "#cce5ff",
                        "primary-fixed-dim": "#93ccff",
                        "secondary": "#00687a",
                        "secondary-container": "#57dffe",
                        "secondary-fixed": "#acedff",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed": "#001f26",
                        "on-secondary-fixed-variant": "#004e5c",
                        "tertiary": "#006947",
                        "tertiary-container": "#00855b",
                        "tertiary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#4edea3",
                        "on-tertiary": "#ffffff",
                        "on-tertiary-fixed": "#002113",
                        "on-tertiary-container": "#f5fff6",
                        "surface": "#f8f9ff",
                        "surface-dim": "#cbdbf5",
                        "surface-bright": "#f8f9ff",
                        "surface-container": "#e5eeff",
                        "surface-container-low": "#eff4ff",
                        "surface-container-high": "#dce9ff",
                        "surface-container-highest": "#d3e4fe",
                        "surface-container-lowest": "#ffffff",
                        "on-surface": "#0b1c30",
                        "on-surface-variant": "#3f4850",
                        "outline": "#707881",
                        "outline-variant": "#bfc7d2",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/modules/medications-appointments.css" asp-append-version="true" />
}

<div class="flex flex-col w-full gap-5 pb-8">
    <!-- 1. TOP BREADCRUMB & REALTIME SYNC BADGE -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/80">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 font-label-md text-slate-500 overflow-x-auto whitespace-nowrap py-1">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors cursor-pointer flex items-center gap-1 text-slate-500 text-decoration-none">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-600 font-medium">Kế hoạch điều trị</span>
            <span class="text-slate-300">/</span>
            <span class="text-primary font-semibold">Lịch uống thuốc &amp; Hẹn tái khám</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-high text-tertiary font-label-sm shadow-xs self-start sm:self-auto flex-shrink-0">
            <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-tertiary"></span>
            </span>
            <span class="font-semibold text-slate-800">Đồng bộ chuông thông báo đẩy 24/7</span>
            <span class="text-[11px] px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 font-bold uppercase tracking-wider">BẬT (Zalo &amp; SMS)</span>
        </div>
    </div>

    <!-- 2. PAGE HEADER BANNER & PRIMARY ACTION BUTTONS -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-5 md:p-6 rounded-2xl bg-white shadow-sm border border-slate-200/90">
        <div class="flex items-start gap-4">
            <div class="w-13 h-13 rounded-2xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-sky-600/20 shrink-0 p-2.5">
                <span class="material-symbols-outlined text-[32px]">medication</span>
            </div>
            <div>
                <div class="flex items-center gap-2.5 flex-wrap">
                    <h1 class="font-headline-md text-slate-900 tracking-tight m-0 text-xl md:text-2xl font-bold">
                        LỊCH NHẮC UỐNG THUỐC &amp; TÁI KHÁM
                    </h1>
                    <span class="px-2.5 py-0.5 rounded-full bg-cyan-50 text-cyan-700 font-label-sm font-semibold border border-cyan-200">
                        Hôm nay: Thứ Năm, 15/10/2026
                    </span>
                </div>
                <p class="font-body-md text-slate-500 mt-1 mb-0">
                    Quản lý cữ thuốc hàng ngày và theo dõi chính xác các mốc tái khám, tiêm chủng định kỳ cho cả gia đình.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap shrink-0">
            <button onclick="openModal('addPrescriptionModal')" class="btn-action-primary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-primary text-white font-label-md shadow-sm hover:bg-primary-container transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                <span>+ Thêm đơn thuốc mới</span>
            </button>
            <button onclick="openModal('addAppointmentModal')" class="btn-action-secondary inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary text-white font-label-md shadow-sm hover:bg-cyan-800 transition-all cursor-pointer border-0">
                <span class="material-symbols-outlined text-[20px]">calendar_add_on</span>
                <span>+ Đặt lịch tái khám</span>
            </button>
            <button onclick="toggleFilterDrawer()" aria-label="Bộ lọc thành viên" class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 hover:text-primary hover:bg-slate-200 transition-colors border-0 cursor-pointer" title="Lọc thành viên">
                <span class="material-symbols-outlined text-[20px]">tune</span>
            </button>
        </div>
    </div>

    <!-- 3. TAB CONTROLS & FILTER BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-surface-container-low p-2 md:p-2.5 rounded-2xl border border-slate-200">
        <!-- Switch Tabs -->
        <div class="inline-flex items-center bg-slate-200/80 p-1 rounded-xl gap-1">
            <button id="tabBtnMedications" onclick="switchViewTab('medications')" class="view-tab-btn @(activeTab == "medications" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">pill</span>
                <span class="font-semibold">Lịch uống thuốc hôm nay</span>
                <span id="pendingDoseBadge" class="px-2 py-0.2 rounded-full bg-amber-100 text-amber-800 font-bold text-xs">@(Model?.TodaySchedules?.Count(s => !s.IsTaken) ?? 0) cữ còn</span>
            </button>
            <button id="tabBtnAppointments" onclick="switchViewTab('appointments')" class="view-tab-btn @(activeTab == "appointments" ? "active" : "") px-4 py-2 rounded-lg font-label-md text-slate-700 flex items-center gap-2 cursor-pointer border-0 bg-transparent">
                <span class="material-symbols-outlined text-[18px]">event_upcoming</span>
                <span class="font-semibold">Lịch hẹn tái khám sắp tới</span>
                <span class="px-2 py-0.2 rounded-full bg-cyan-100 text-cyan-800 font-bold text-xs">@(Model?.UpcomingAppointments?.Count ?? 0) lịch</span>
            </button>
        </div>

        <!-- Member Quick Filter -->
        <div class="flex items-center gap-2 px-2 overflow-x-auto">
            <span class="font-label-sm text-slate-500 uppercase tracking-wider shrink-0">Thành viên:</span>
            <div class="flex items-center gap-1.5 flex-wrap">
                <button onclick="filterByMember('all')" class="member-filter-chip active px-3 py-1 rounded-full text-xs font-semibold bg-white text-primary border border-primary shadow-xs cursor-pointer">
                    Tất cả (@(Model?.Members?.Count ?? 0))
                </button>
                @if (Model?.Members != null)
                {
                    foreach (var member in Model.Members)
                    {
                        <button onclick="filterByMember('@member.FullName')" class="member-filter-chip px-3 py-1 rounded-full text-xs font-medium bg-white text-slate-600 border border-slate-200 hover:border-slate-300 cursor-pointer">
                            @member.FullName (@member.Relationship)
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <!-- 4. TAB CONTENT 1: LỊCH UỐNG THUỐC HÔM NAY -->
    <div id="tabContentMedications" class="@(activeTab == "medications" ? "block" : "hidden") space-y-6">
        <!-- Dose Progress Bar & Overview -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-sky-100 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[24px]">alarm_on</span>
                </div>
                <div>
                    <div class="font-headline-sm text-slate-900 text-base md:text-lg font-bold">CÁC CỮ THUỐC TRONG NGÀY HÔM NAY</div>
                    <div class="font-label-md text-slate-500">Chia rõ 3 khung giờ: Sáng (07:00 - 08:00), Trưa (11:30 - 12:30), Tối (20:00)</div>
                </div>
            </div>

            <!-- Progress Metric -->
            <div class="flex items-center gap-4 bg-surface-container-low px-4 py-2.5 rounded-xl border border-slate-200/60 self-start lg:self-auto">
                <div class="flex flex-col text-right">
                    <span class="font-label-sm text-slate-500">Tiến độ cữ thuốc hôm nay</span>
                    <span id="doseProgressText" class="font-title-md text-tertiary font-bold">Đã uống @(Model?.TodaySchedules?.Count(s => s.IsTaken) ?? 0)/@(Model?.TodaySchedules?.Count ?? 0) liều</span>
                </div>
                <div class="w-32 sm:w-40 h-3 bg-slate-200 rounded-full overflow-hidden">
                    @{
                        var totalD = Model?.TodaySchedules?.Count ?? 0;
                        var takenD = Model?.TodaySchedules?.Count(s => s.IsTaken) ?? 0;
                        var pct = totalD > 0 ? (int)Math.Round((double)takenD / totalD * 100) : 0;
                    }
                    <div id="doseProgressBar" class="h-full bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full transition-all duration-500" style="width: @(pct)%;"></div>
                </div>
                <span id="doseProgressPercent" class="font-metric-num text-sm text-primary font-bold">@(pct)%</span>
            </div>
        </div>

        <!-- 3 Dose Blocks Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            @if (Model?.TodaySchedules != null && Model.TodaySchedules.Any())
            {
                var morningDoses = Model.TodaySchedules.Where(s => s.PrescriptionDose.TimeOfDay == "Sáng" || s.PrescriptionDose.DoseTime < TimeSpan.FromHours(11)).ToList();
                var noonDoses = Model.TodaySchedules.Where(s => s.PrescriptionDose.TimeOfDay == "Trưa" || (s.PrescriptionDose.DoseTime >= TimeSpan.FromHours(11) && s.PrescriptionDose.DoseTime < TimeSpan.FromHours(17))).ToList();
                var eveningDoses = Model.TodaySchedules.Where(s => s.PrescriptionDose.TimeOfDay == "Tối" || s.PrescriptionDose.TimeOfDay == "Đêm" || s.PrescriptionDose.DoseTime >= TimeSpan.FromHours(17)).ToList();

                <!-- CỮ SÁNG -->
                <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between" data-dose-slot="morning">
                    <div>
                        <div class="flex items-center justify-between pb-3 mb-4 bg-amber-50/80 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-amber-100">
                            <div class="flex items-center gap-2 text-amber-700">
                                <span class="material-symbols-outlined text-[26px]">wb_sunny</span>
                                <div>
                                    <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ SÁNG</span>
                                    <span class="font-label-sm text-amber-800 font-medium">07:00 - 09:00 Sáng</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full @(morningDoses.All(d => d.IsTaken) && morningDoses.Any() ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-amber-100 text-amber-800 border-amber-200") font-label-sm font-semibold text-xs border">
                                @(morningDoses.All(d => d.IsTaken) && morningDoses.Any() ? "Hoàn thành" : $"{morningDoses.Count(d => !d.IsTaken)} chưa uống")
                            </span>
                        </div>
                        <div class="flex flex-col gap-3">
                            @if (morningDoses.Any())
                            {
                                foreach (var s in morningDoses)
                                {
                                    <div class="dose-item @(s.IsTaken ? "completed" : "") p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "")">
                                        <div class="flex items-start justify-between gap-2">
                                            <div>
                                                <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">@(s.PrescriptionDose?.PrescriptionItem?.MedicineName ?? "Thuốc")</h4>
                                                <span class="font-label-sm text-slate-600 font-medium">@(s.PrescriptionDose?.PrescriptionItem?.DosagePerTime ?? "1 liều") • Thành viên: <strong class="text-slate-800">@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "Thành viên")</strong></span>
                                            </div>
                                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full @(s.IsTaken ? "bg-tertiary text-white" : "bg-slate-200 text-slate-600") text-[14px] shrink-0">
                                                <span class="material-symbols-outlined text-[16px]">@(s.IsTaken ? "check" : "schedule")</span>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(s.PrescriptionDose?.PrescriptionItem?.MealTiming))
                                        {
                                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                                “@s.PrescriptionDose.PrescriptionItem.MealTiming”
                                            </p>
                                        }
                                        @if (s.IsTaken)
                                        {
                                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                                <span>Đã uống lúc @(s.TakenAt?.ToString("HH:mm") ?? "sớm nay")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic py-4 text-center m-0">Không có cữ thuốc sáng</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- CỮ TRƯA -->
                <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between" data-dose-slot="noon">
                    <div>
                        <div class="flex items-center justify-between pb-3 mb-4 bg-sky-50 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-sky-100">
                            <div class="flex items-center gap-2 text-sky-700">
                                <span class="material-symbols-outlined text-[26px]">light_mode</span>
                                <div>
                                    <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ TRƯA</span>
                                    <span class="font-label-sm text-sky-800 font-medium">11:30 - 13:00 Trưa</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full @(noonDoses.All(d => d.IsTaken) && noonDoses.Any() ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-sky-100 text-sky-800 border-sky-200") font-label-sm font-semibold text-xs border">
                                @(noonDoses.All(d => d.IsTaken) && noonDoses.Any() ? "Hoàn thành" : $"{noonDoses.Count(d => !d.IsTaken)} chưa uống")
                            </span>
                        </div>
                        <div class="flex flex-col gap-3">
                            @if (noonDoses.Any())
                            {
                                foreach (var s in noonDoses)
                                {
                                    <div class="dose-item @(s.IsTaken ? "completed" : "") p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "")">
                                        <div class="flex items-start justify-between gap-2">
                                            <div>
                                                <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">@(s.PrescriptionDose?.PrescriptionItem?.MedicineName ?? "Thuốc")</h4>
                                                <span class="font-label-sm text-slate-600 font-medium">@(s.PrescriptionDose?.PrescriptionItem?.DosagePerTime ?? "1 liều") • Thành viên: <strong class="text-slate-800">@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "Thành viên")</strong></span>
                                            </div>
                                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full @(s.IsTaken ? "bg-tertiary text-white" : "bg-slate-200 text-slate-600") text-[14px] shrink-0">
                                                <span class="material-symbols-outlined text-[16px]">@(s.IsTaken ? "check" : "schedule")</span>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(s.PrescriptionDose?.PrescriptionItem?.MealTiming))
                                        {
                                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                                “@s.PrescriptionDose.PrescriptionItem.MealTiming”
                                            </p>
                                        }
                                        @if (s.IsTaken)
                                        {
                                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                                <span>Đã uống lúc @(s.TakenAt?.ToString("HH:mm") ?? "trưa nay")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic py-4 text-center m-0">Không có cữ thuốc trưa</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- CỮ TỐI -->
                <div class="dose-card rounded-2xl bg-white p-5 shadow-sm flex flex-col justify-between" data-dose-slot="evening">
                    <div>
                        <div class="flex items-center justify-between pb-3 mb-4 bg-indigo-50/80 -mx-5 -mt-5 p-4 rounded-t-2xl border-b border-indigo-100">
                            <div class="flex items-center gap-2 text-indigo-700">
                                <span class="material-symbols-outlined text-[26px]">bedtime</span>
                                <div>
                                    <span class="font-title-md text-slate-900 block leading-tight font-bold">CỮ TỐI</span>
                                    <span class="font-label-sm text-indigo-800 font-medium">19:30 - 21:00 Tối</span>
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full @(eveningDoses.All(d => d.IsTaken) && eveningDoses.Any() ? "bg-emerald-100 text-emerald-800 border-emerald-200" : "bg-indigo-100 text-indigo-800 border-indigo-200") font-label-sm font-semibold text-xs border">
                                @(eveningDoses.All(d => d.IsTaken) && eveningDoses.Any() ? "Hoàn thành" : $"{eveningDoses.Count(d => !d.IsTaken)} chưa uống")
                            </span>
                        </div>
                        <div class="flex flex-col gap-3">
                            @if (eveningDoses.Any())
                            {
                                foreach (var s in eveningDoses)
                                {
                                    <div class="dose-item @(s.IsTaken ? "completed" : "") p-3 rounded-xl bg-slate-50 flex flex-col gap-1.5" data-member="@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "")">
                                        <div class="flex items-start justify-between gap-2">
                                            <div>
                                                <h4 class="font-title-md text-slate-900 text-sm font-bold m-0">@(s.PrescriptionDose?.PrescriptionItem?.MedicineName ?? "Thuốc")</h4>
                                                <span class="font-label-sm text-slate-600 font-medium">@(s.PrescriptionDose?.PrescriptionItem?.DosagePerTime ?? "1 liều") • Thành viên: <strong class="text-slate-800">@(s.PrescriptionDose?.PrescriptionItem?.Prescription?.Member?.FullName ?? "Thành viên")</strong></span>
                                            </div>
                                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full @(s.IsTaken ? "bg-tertiary text-white" : "bg-slate-200 text-slate-600") text-[14px] shrink-0">
                                                <span class="material-symbols-outlined text-[16px]">@(s.IsTaken ? "check" : "schedule")</span>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(s.PrescriptionDose?.PrescriptionItem?.MealTiming))
                                        {
                                            <p class="font-body-sm text-slate-500 italic m-0 bg-white/80 p-1.5 rounded-lg border border-slate-100">
                                                “@s.PrescriptionDose.PrescriptionItem.MealTiming”
                                            </p>
                                        }
                                        @if (s.IsTaken)
                                        {
                                            <div class="mt-1 w-full py-1.5 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-label-md flex items-center justify-center gap-1.5 text-xs font-semibold border border-emerald-100">
                                                <span class="material-symbols-outlined text-[16px]">done_all</span>
                                                <span>Đã uống lúc @(s.TakenAt?.ToString("HH:mm") ?? "tối nay")</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-400 italic py-4 text-center m-0">Không có cữ thuốc tối</p>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-span-full bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center shadow-xs">
                    <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mx-auto mb-4 border border-amber-100 shadow-inner">
                        <span class="material-symbols-outlined text-[36px]">medication</span>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 mb-1">Hôm nay không có lịch uống thuốc</h3>
                    <p class="text-xs text-slate-500 max-w-md mx-auto mb-6">Tất cả thành viên trong tổ ấm hiện không có cữ thuốc nào cần uống trong ngày hôm nay.</p>
                    <button onclick="openModal('addPrescriptionModal')" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs sm:text-sm font-semibold hover:bg-sky-600 shadow-md shadow-sky-600/20 transition-all border-0 cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">add_circle</span>
                        <span>+ Thêm đơn thuốc mới</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- 5. TAB CONTENT 2: LỊCH HẸN TÁI KHÁM SẮP TỚI -->
    <div id="tabContentAppointments" class="@(activeTab == "appointments" ? "block" : "hidden") space-y-6">
        <!-- Header Block -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 md:p-5 rounded-2xl bg-white shadow-sm border border-slate-200">
            <div class="flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-cyan-100 text-secondary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[26px]">calendar_month</span>
                </div>
                <div>
                    <h2 class="font-headline-sm text-slate-900 tracking-tight m-0 text-base md:text-lg font-bold">
                        LỊCH TÁI KHÁM &amp; TIÊM CHỦNG SẮP TỚI
                    </h2>
                    <p class="font-body-sm text-slate-500 m-0">
                        Các lịch hẹn khám chuyên khoa và mốc tiêm chủng phòng bệnh sắp diễn ra cho cả gia đình
                    </p>
                </div>
            </div>
            <button onclick="openModal('addAppointmentModal')" class="btn-action-primary px-4 py-2 rounded-xl bg-primary text-white font-label-md hover:bg-primary-container transition-colors cursor-pointer flex items-center gap-1.5 border-0 text-xs font-semibold self-start sm:self-auto">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>+ Đặt lịch tái khám mới</span>
            </button>
        </div>

        <!-- Appointment Schedule Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 font-label-sm text-slate-500 uppercase tracking-wider text-xs">
                            <th class="py-3.5 px-4 font-semibold">Thời gian hẹn</th>
                            <th class="py-3.5 px-4 font-semibold">Thành viên</th>
                            <th class="py-3.5 px-4 font-semibold">Bệnh viện / Cơ sở</th>
                            <th class="py-3.5 px-4 font-semibold">Bác sĩ / Chuyên khoa</th>
                            <th class="py-3.5 px-4 font-semibold">Yêu cầu lâm sàng</th>
                            <th class="py-3.5 px-4 font-semibold text-right">Trạng thái &amp; Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-body-sm text-slate-700">
                        @if (Model?.UpcomingAppointments != null && Model.UpcomingAppointments.Any())
                        {
                            foreach (var apt in Model.UpcomingAppointments)
                            {
                                var initials = !string.IsNullOrWhiteSpace(apt.Member?.FullName)
                                    ? string.Join("", apt.Member.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper()
                                    : "TV";
                                if (initials.Length > 2) initials = initials.Substring(initials.Length - 2);

                                <tr class="appointment-row hover:bg-slate-50/70 transition-colors" data-member="@(apt.Member?.FullName ?? "")">
                                    <td class="py-4 px-4 align-top whitespace-nowrap">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-11 h-11 rounded-xl bg-sky-50 border border-sky-100 flex flex-col items-center justify-center text-primary font-metric-num shrink-0">
                                                <span class="font-bold text-[15px] leading-tight">@apt.AppointmentDateTime.ToString("dd")</span>
                                                <span class="text-[10px] uppercase font-bold text-slate-500">Th@apt.AppointmentDateTime.ToString("MM")</span>
                                            </div>
                                            <div class="flex flex-col">
                                                <span class="font-title-md text-slate-900 font-bold text-sm">@apt.AppointmentDateTime.ToString("dd/MM/yyyy")</span>
                                                <span class="font-label-sm text-cyan-800 font-semibold text-xs">@apt.AppointmentDateTime.ToString("HH:mm")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-full bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold text-xs shrink-0">
                                                @initials
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-title-md text-slate-900 font-semibold text-sm truncate">@(apt.Member?.FullName ?? "Thành viên")</span>
                                                <span class="font-label-sm text-slate-500 text-xs">@(apt.Member?.Relationship ?? "")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex flex-col">
                                            <span class="font-label-lg text-slate-900 font-bold text-sm">@apt.Location</span>
                                            @if (!string.IsNullOrEmpty(apt.AppointmentType))
                                            {
                                                <span class="font-body-sm text-slate-500 flex items-center gap-1 text-xs mt-0.5">
                                                    <span class="material-symbols-outlined text-[15px] text-rose-500">pin_drop</span>
                                                    @apt.AppointmentType
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex flex-col">
                                            <span class="font-label-lg text-slate-900 font-bold text-sm">@(string.IsNullOrEmpty(apt.DoctorName) ? "Bác sĩ phụ trách" : apt.DoctorName)</span>
                                            @if (!string.IsNullOrEmpty(apt.Title))
                                            {
                                                <span class="inline-flex items-center gap-1 font-label-sm text-primary text-xs mt-0.5 font-semibold">
                                                    <span class="material-symbols-outlined text-[15px]">medical_services</span>
                                                    @apt.Title
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        @if (!string.IsNullOrEmpty(apt.PreparationNotes))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 font-label-sm font-semibold text-xs">
                                                <span class="material-symbols-outlined text-[14px]">info</span>
                                                @apt.PreparationNotes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">Không có ghi chú dặn dò</span>
                                        }
                                    </td>
                                    <td class="py-4 px-4 align-top text-right whitespace-nowrap">
                                        <div class="flex flex-col items-end gap-2">
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-sky-100 text-[#0284C7] font-label-sm font-bold text-xs border border-sky-200">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                                @(apt.Status ?? "Đã đặt lịch")
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-12 text-center text-slate-400 font-medium">
                                    <div class="flex flex-col items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-[32px] text-cyan-500">event_busy</span>
                                        <p class="font-bold text-slate-700 text-sm m-0">Chưa có lịch hẹn tái khám nào</p>
                                        <p class="text-xs text-slate-400 m-0">Tổ ấm hiện chưa có lịch khám bệnh hay tiêm chủng sắp tới.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Note & Quick Tips Inside Schedule Card -->
            <div class="p-4 bg-slate-50 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 border-t border-slate-200">
                <div class="flex items-center gap-2 text-slate-600 font-body-sm text-xs">
                    <span class="material-symbols-outlined text-primary text-[18px]">info</span>
                    <span>Bấm nút “Xem chỉ dẫn đường đi” để nhận lộ trình di chuyển và phiếu đăng ký khám điện tử QR Code.</span>
                </div>
                <div class="flex items-center gap-2">
                    <a href="javascript:void(0)" onclick="showToast('Đang tải danh sách lịch sử tái khám các năm trước...')" class="font-label-sm text-primary hover:underline font-semibold flex items-center gap-1 text-xs text-decoration-none">
                        <span>Xem lịch sử tái khám các năm trước</span>
                        <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

